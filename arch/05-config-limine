#!/usr/bin/env bash

# arch/05-config-limine
# Configure Limine bootloader (replaces GRUB)

set -euo pipefail

# =====================================
# LIMINE CONFIGURATION CONSTANTS
# =====================================

# Security-focused kernel parameters (safe for development)
readonly SECURITY_PARAMS=(
    "lsm=landlock,lockdown,yama,integrity,apparmor,bpf"
    "apparmor=1"
    "security=apparmor" 
    "audit=1"
    "intel_iommu=on"
    "amd_iommu=on"
    "iommu=pt"
    "kernel.yama.ptrace_scope=1"
    "kernel.kptr_restrict=1"
    "kernel.dmesg_restrict=1"
)

# Performance and stability parameters
readonly PERFORMANCE_PARAMS=(
    "nowatchdog"
    "zswap.enabled=0"
    "rootfstype=btrfs"
    "rw"
    "loglevel=3"
    "quiet"
)

# LUKS-specific parameters (added if encryption is enabled)
readonly LUKS_PARAMS=(
    "rd.luks.options=discard"
)

# =====================================
# VALIDATION FUNCTIONS
# =====================================

validate_esp_mount() {
    local esp_path="/mnt/boot/efi"
    
    if ! mountpoint -q "$esp_path"; then
        output "ERROR: ESP not mounted at $esp_path"
        return 1
    fi
    
    local esp_fstype
    esp_fstype=$(findmnt -n -o FSTYPE "$esp_path")
    if [[ "$esp_fstype" != "vfat" ]]; then
        output "ERROR: ESP is not FAT32 filesystem (found: $esp_fstype)"
        return 1
    fi
    
    output "ESP validation passed: $esp_path (vfat)"
    return 0
}

validate_kernel_files() {
    local boot_dir="/mnt/boot"
    local required_files=(
        "$boot_dir/vmlinuz-linux"
        "$boot_dir/vmlinuz-linux-lts" 
        "$boot_dir/initramfs-linux.img"
        "$boot_dir/initramfs-linux-lts.img"
    )
    
    output "Validating kernel files..."
    
    for file in "${required_files[@]}"; do
        if [[ ! -f "$file" ]]; then
            output "ERROR: Required kernel file missing: $file"
            return 1
        fi
        output "  ✓ Found: $(basename "$file")"
    done
    
    return 0
}

check_limine_package() {
    if ! arch-chroot /mnt pacman -Q limine &>/dev/null; then
        output "ERROR: Limine package not installed"
        output "This should have been installed in pacstrap phase"
        return 1
    fi
    
    output "Limine package confirmed installed"
    return 0
}

# =====================================
# MKINITCPIO CONFIGURATION
# =====================================

configure_mkinitcpio() {
    output "Step 1/4: Configuring mkinitcpio for Limine..."
    
    local mkinitcpio_conf="/mnt/etc/mkinitcpio.conf"
    local template_file="$HERE/arch/etc/mkinitcpio.conf"
    
    # Backup existing configuration
    if [[ -f "$mkinitcpio_conf" ]]; then
        cp "$mkinitcpio_conf" "${mkinitcpio_conf}.backup"
    fi
    
    # Verify template file exists
    if [[ ! -f "$template_file" ]]; then
        output "ERROR: mkinitcpio template not found: $template_file"
        return 1
    fi
    
    # Copy template to target location
    if ! cp "$template_file" "$mkinitcpio_conf"; then
        output "ERROR: Failed to copy mkinitcpio template"
        return 1
    fi

    # Add LUKS hook if encryption is enabled
    if [[ ${use_luks:?} -eq 1 ]]; then
        output "  Adding LUKS support to mkinitcpio..."
        # Insert encrypt hook after block hook in the HOOKS array
        sed -i 's/\(block\)/\1 encrypt/' "$mkinitcpio_conf"
    fi
    
    # Verify configuration was written correctly
    if [[ ! -s "$mkinitcpio_conf" ]]; then
        output "ERROR: mkinitcpio configuration is empty"
        return 1
    fi
    
    if ! grep -q "COMPRESSION=\"zstd\"" "$mkinitcpio_conf"; then
        output "ERROR: mkinitcpio configuration not written correctly"
        return 1
    fi
    
    # Verify essential modules are present
    if ! grep -q "usbhid xhci_hcd" "$mkinitcpio_conf"; then
        output "ERROR: Essential USB modules missing from mkinitcpio"
        return 1
    fi
    
    output "  ✓ mkinitcpio configured for Limine with BTRFS support"
    return 0
}

# =====================================
# LIMINE BOOTLOADER CONFIGURATION
# =====================================

generate_kernel_parameters() {
    local kernel_params=()
    
    # Add base performance parameters
    kernel_params+=("${PERFORMANCE_PARAMS[@]}")
    
    # Add security parameters
    kernel_params+=("${SECURITY_PARAMS[@]}")
    
    # Handle root filesystem specification
    if [[ ${use_luks:?} -eq 1 ]]; then
        # For LUKS: point to encrypted device
        kernel_params+=("root=/dev/mapper/cryptroot")
        kernel_params+=("${LUKS_PARAMS[@]}")
        
        # Add LUKS device specification
        local rootfs_uuid
        rootfs_uuid=$(blkid -s UUID -o value /dev/disk/by-partlabel/rootfs)
        kernel_params+=("rd.luks.uuid=${rootfs_uuid}")
    else
        # For non-encrypted: use partition label
        kernel_params+=("root=/dev/disk/by-partlabel/rootfs")
    fi
    
    # Return parameters as single string
    printf '%s ' "${kernel_params[@]}"
}

create_limine_config() {
    output "Step 2/4: Creating Limine configuration..."
    
    local limine_cfg="/mnt/boot/limine.cfg"
    local template_file="$HERE/arch/boot/limine.cfg.template"
    local kernel_params
    local recovery_root
    
    # Verify template exists
    if [[ ! -f "$template_file" ]]; then
        output "ERROR: Limine template file not found: $template_file"
        return 1
    fi
    
    # Generate kernel parameters
    kernel_params=$(generate_kernel_parameters)
    # Remove trailing space
    kernel_params="${kernel_params% }"
    
    # Set recovery root based on encryption
    if [[ ${use_luks:?} -eq 1 ]]; then
        recovery_root="root=/dev/mapper/cryptroot"
    else
        recovery_root="root=/dev/disk/by-partlabel/rootfs"
    fi
    
    # Process template
    if [[ ${use_luks:?} -eq 1 ]]; then
        # Keep LUKS section
        sed -e "s|{{KERNEL_PARAMS}}|${kernel_params}|g" \
            -e "s|{{RECOVERY_ROOT}}|${recovery_root}|g" \
            "$template_file" > "$limine_cfg"
    else
        # Remove LUKS section
        sed -e "s|{{KERNEL_PARAMS}}|${kernel_params}|g" \
            -e "s|{{RECOVERY_ROOT}}|${recovery_root}|g" \
            -e '/#BEGIN_LUKS_SECTION/,/#END_LUKS_SECTION/d' \
            "$template_file" > "$limine_cfg"
    fi
    
    if [[ ! -s "$limine_cfg" ]]; then
        output "ERROR: Failed to create Limine configuration from template"
        return 1
    fi
    
    # Verify configuration was created
    if [[ ! -s "$limine_cfg" ]]; then
        output "ERROR: Limine configuration is empty"
        return 1
    fi
    
    # Validate configuration syntax
    if ! grep -q "DEFAULT_ENTRY=1" "$limine_cfg"; then
        output "ERROR: Limine configuration malformed"
        return 1
    fi
    
    local entry_count
    entry_count=$(grep -c "^:" "$limine_cfg")
    local expected_entries
    expected_entries=$([[ ${use_luks:?} -eq 1 ]] && echo "5" || echo "4")
    
    if [[ $entry_count -ne $expected_entries ]]; then
        output "WARNING: Unexpected number of boot entries ($entry_count, expected $expected_entries)"
    fi
    
    output "  ✓ Limine configuration created with $entry_count boot entries"
    return 0
}

# =====================================
# BOOTLOADER INSTALLATION
# =====================================

install_limine_uefi() {
    output "Step 3/4: Installing Limine for UEFI..."
    
    local esp_dir="/mnt/boot/efi"
    local limine_efi_dir="$esp_dir/EFI/BOOT"
    
    # Create EFI directory structure
    mkdir -p "$limine_efi_dir"
    
    # Copy Limine EFI binary
    if ! cp /mnt/usr/share/limine/BOOTX64.EFI "$limine_efi_dir/"; then
        output "ERROR: Failed to copy Limine EFI binary"
        return 1
    fi
    
    # Verify EFI binary was copied
    if [[ ! -f "$limine_efi_dir/BOOTX64.EFI" ]]; then
        output "ERROR: Limine EFI binary not found after copy"
        return 1
    fi
    
    output "  ✓ Limine UEFI binary installed to ESP"
    return 0
}

install_limine_bios() {
    output "Step 4/4: Installing Limine for BIOS compatibility..."
    
    # Install Limine to disk MBR for BIOS boot compatibility
    if ! arch-chroot /mnt limine bios-install "${disk:?}"; then
        output "ERROR: Failed to install Limine to disk MBR"
        return 1
    fi
    
    output "  ✓ Limine BIOS compatibility installed to ${disk}"
    return 0
}

regenerate_initramfs() {
    output "Regenerating initramfs with new configuration..."
    
    # Generate initramfs for both kernels
    if ! arch-chroot /mnt mkinitcpio -P; then
        output "ERROR: Failed to regenerate initramfs"
        return 1
    fi
    
    # Verify initramfs files exist and are not empty
    local initramfs_files=(
        "/mnt/boot/initramfs-linux.img"
        "/mnt/boot/initramfs-linux-lts.img"
    )
    
    for file in "${initramfs_files[@]}"; do
        if [[ ! -s "$file" ]]; then
            output "ERROR: Initramfs file missing or empty: $file"
            return 1
        fi
    done
    
    output "  ✓ Initramfs regenerated successfully"
    return 0
}

# =====================================
# VERIFICATION AND SUMMARY
# =====================================

verify_limine_installation() {
    output "Verifying Limine installation..."
    
    local checks_passed=0
    local total_checks=6
    
    # Check 1: Limine configuration exists
    if [[ -s "/mnt/boot/limine.cfg" ]]; then
        output "  ✓ Limine configuration exists"
        ((checks_passed++))
    else
        output "  ✗ Limine configuration missing or empty"
    fi
    
    # Check 2: UEFI binary exists
    if [[ -f "/mnt/boot/efi/EFI/BOOT/BOOTX64.EFI" ]]; then
        output "  ✓ UEFI binary installed"
        ((checks_passed++))
    else
        output "  ✗ UEFI binary missing"
    fi
    
    # Check 3: Kernel files exist
    if validate_kernel_files &>/dev/null; then
        output "  ✓ Kernel files present"
        ((checks_passed++))
    else
        output "  ✗ Kernel files missing"
    fi
    
    # Check 4: mkinitcpio configuration
    if grep -q "COMPRESSION=\"zstd\"" "/mnt/etc/mkinitcpio.conf"; then
        output "  ✓ mkinitcpio configured"
        ((checks_passed++))
    else
        output "  ✗ mkinitcpio not configured correctly"
    fi
    
    # Check 5: Boot entries count
    local entry_count
    entry_count=$(grep -c "^:" "/mnt/boot/limine.cfg" 2>/dev/null || echo "0")
    if [[ $entry_count -ge 4 ]]; then
        output "  ✓ Boot entries created ($entry_count entries)"
        ((checks_passed++))
    else
        output "  ✗ Insufficient boot entries ($entry_count)"
    fi
    
    # Check 6: Initramfs files
    if [[ -s "/mnt/boot/initramfs-linux.img" && -s "/mnt/boot/initramfs-linux-lts.img" ]]; then
        output "  ✓ Initramfs files generated"
        ((checks_passed++))
    else
        output "  ✗ Initramfs files missing or empty"
    fi
    
    if [[ $checks_passed -eq $total_checks ]]; then
        output "All verification checks passed ($checks_passed/$total_checks)"
        return 0
    else
        output "Verification failed: $checks_passed/$total_checks checks passed"
        return 1
    fi
}

display_limine_summary() {
    output ""
    output "=== Limine Bootloader Configuration Summary ==="
    output "Bootloader: Limine (replaced GRUB)"
    output "UEFI Support: Yes (/boot/efi/EFI/BOOT/BOOTX64.EFI)"
    output "BIOS Support: Yes (installed to ${disk})"
    output "Encryption: $(( use_luks ? "enabled (LUKS)" : "disabled" ))"
    output "Timeout: 5 seconds"
    output "Default: Arch Linux (main kernel)"
    output ""
    
    output "=== Boot Menu Entries ==="
    local entry_num=1
    while IFS= read -r line; do
        if [[ $line =~ ^: ]]; then
            local entry_name="${line#:}"
            output "  $entry_num. $entry_name"
            ((entry_num++))
        fi
    done < /mnt/boot/limine.cfg
    output ""
    
    output "=== Security Features Enabled ==="
    output "  • AppArmor LSM with audit logging"
    output "  • IOMMU protection for virtualization"
    output "  • Kernel hardening parameters"
    output "  • Memory protection features"
    output "  • System call auditing"
    output ""
    
    output "=== Kernel Parameters ==="
    local params
    params=$(generate_kernel_parameters)
    # Format parameters nicely (break long lines)
    echo "$params" | fold -w 60 -s | sed 's/^/  /'
    output ""
    
    output "=== Recovery Options ==="
    output "  • Recovery mode (single user)"
    output "  • LTS kernel fallback"
    if [[ ${use_luks:?} -eq 1 ]]; then
        output "  • Emergency mode (LUKS bypass)"
    fi
    output "=================================="
    output ""
}

# =====================================
# MAIN LIMINE CONFIGURATION PROCESS
# =====================================

output "=== Limine Bootloader Configuration ==="
output "Replacing GRUB with modern Limine bootloader"
output ""

# Pre-installation validation
check_limine_package || exit 1
validate_esp_mount || exit 1

# Main configuration steps
configure_mkinitcpio || exit 1
regenerate_initramfs || exit 1
validate_kernel_files || exit 1
create_limine_config || exit 1
install_limine_uefi || exit 1
install_limine_bios || exit 1

# Post-installation verification
verify_limine_installation || exit 1

# Display summary
display_limine_summary

output "=== Limine Configuration Complete ==="
output "✓ Modern bootloader replacing GRUB"
output "✓ UEFI and BIOS compatibility"
output "✓ Dual-kernel support (main + LTS)"
output "✓ Security hardening enabled"
output "✓ Recovery options available"
output "✓ BTRFS native support"
if [[ ${use_luks:?} -eq 1 ]]; then
    output "✓ LUKS encryption support"
fi
output ""
output "System ready for first boot with Limine bootloader"
