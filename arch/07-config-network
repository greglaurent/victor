#!/usr/bin/env bash

# arch/07-config-network
# Configure secure network stack with unbound DNS resolver

set -euo pipefail

# Source echo function

# =====================================
# NETWORK CONFIGURATION CONSTANTS
# ======================================

readonly UNBOUND_PORT="5353"
readonly NETWORKMANAGER_CONFIG_DIR="/mnt/etc/NetworkManager/conf.d"
readonly UNBOUND_CONFIG_DIR="/mnt/etc/unbound"
readonly SYSTEMD_RESOLVED_CONFIG_DIR="/mnt/etc/systemd/resolved.conf.d"

# Secure DNS servers with DoT support
readonly SECURE_DNS_SERVERS=(
    "1.1.1.2@853#security.cloudflare-dns.com"      # Cloudflare for Families
    "1.0.0.2@853#security.cloudflare-dns.com"
    "9.9.9.9@853#dns.quad9.net"                    # Quad9 security
    "149.112.112.112@853#dns.quad9.net"
)

# =====================================
# VALIDATION FUNCTIONS
# =====================================

validate_network_packages() {
    echo "Validating network packages..."
    
    local required_packages=("networkmanager" "unbound" "bind")
    local missing_packages=()
    
    for package in "${required_packages[@]}"; do
        if ! arch-chroot /mnt pacman -Q "$package" &>/dev/null; then
            missing_packages+=("$package")
        fi
    done
    
    if [[ ${#missing_packages[@]} -gt 0 ]]; then
        echo "ERROR: Missing network packages: ${missing_packages[*]}"
        exit 1
    fi
    
    echo "All network packages confirmed installed"
    return 0
}

validate_target_directories() {
    echo "Validating network configuration directories..."
    
    local required_dirs=(
        "/mnt/etc/NetworkManager"
        "/mnt/etc/systemd"
    )
    
    for dir in "${required_dirs[@]}"; do
        if [[ ! -d "$dir" ]]; then
            echo "ERROR: Required directory missing: $dir"
            exit 1
        fi
    done
    
    # Create configuration directories
    mkdir -p "$NETWORKMANAGER_CONFIG_DIR"
    mkdir -p "$UNBOUND_CONFIG_DIR/unbound.conf.d"
    mkdir -p "$SYSTEMD_RESOLVED_CONFIG_DIR"
    
    echo "Network configuration directories ready"
    return 0
}

# =====================================
# UNBOUND DNS RESOLVER CONFIGURATION
# =====================================

configure_unbound_resolver() {
    echo "Step 1/4: Configuring Unbound DNS resolver..."
    
    local unbound_conf="$UNBOUND_CONFIG_DIR/unbound.conf"
    local unbound_template="$HERE/arch/etc/unbound/unbound.conf.template"
    local local_conf_src="$HERE/arch/etc/unbound/unbound.conf.d/local.conf"
    
    # Verify template files exist
    if [[ ! -f "$unbound_template" ]]; then
        echo "ERROR: Unbound template not found: $unbound_template"
        exit 1
    fi
    
    if [[ ! -f "$local_conf_src" ]]; then
        echo "ERROR: Unbound local configuration not found: $local_conf_src"
        exit 1
    fi
    
    # Create unbound configuration from template
    if ! sed "s/{{UNBOUND_PORT}}/${UNBOUND_PORT}/g" "$unbound_template" > "$unbound_conf"; then
        echo "ERROR: Failed to create unbound configuration from template"
        exit 1
    fi
    
    # Add forward addresses for secure DNS servers
    for server in "${SECURE_DNS_SERVERS[@]}"; do
        echo "    forward-addr: $server" >> "$unbound_conf"
    done
    
    # Create unbound control keys directory
    mkdir -p "$UNBOUND_CONFIG_DIR/unbound_control.d"
    
    # Copy local configuration file
    if ! cp "$local_conf_src" "$UNBOUND_CONFIG_DIR/unbound.conf.d/local.conf"; then
        echo "ERROR: Failed to copy unbound local configuration"
        exit 1
    fi

    # Set proper permissions
    chmod 644 "$unbound_conf"
    chmod 644 "$UNBOUND_CONFIG_DIR/unbound.conf.d/local.conf"
    chmod 755 "$UNBOUND_CONFIG_DIR/unbound_control.d"
    
    # Verify configuration was created
    if [[ ! -s "$unbound_conf" ]]; then
        echo "ERROR: Unbound configuration is empty"
        exit 1
    fi
    
    if ! grep -q "forward-tls-upstream: yes" "$unbound_conf"; then
        echo "ERROR: Unbound configuration missing DoT setup"
        exit 1
    fi
    
    echo "  ✓ Unbound configured on port $UNBOUND_PORT"
    echo "  ✓ DNS-over-TLS forwarding to secure resolvers"
    echo "  ✓ DNSSEC validation enabled"
    echo "  ✓ Privacy and security optimizations applied"
    return 0
}

# =====================================
# SYSTEMD-RESOLVED INTEGRATION
# =====================================

configure_systemd_resolved() {
    echo "Step 2/4: Configuring systemd-resolved integration..."
    
    local resolved_conf="$SYSTEMD_RESOLVED_CONFIG_DIR/unbound-integration.conf"
    local resolved_template="$HERE/arch/etc/systemd/resolved.conf.d/unbound-integration.conf.template"
    local backup_conf_src="$HERE/arch/etc/systemd/resolved.conf.d/backup-dns.conf"
    
    # Verify template files exist
    if [[ ! -f "$resolved_template" ]]; then
        echo "ERROR: systemd-resolved template not found: $resolved_template"
        exit 1
    fi
    
    if [[ ! -f "$backup_conf_src" ]]; then
        echo "ERROR: backup DNS configuration not found: $backup_conf_src"
        exit 1
    fi
    
    # Create systemd-resolved configuration from template
    if ! sed "s/{{UNBOUND_PORT}}/${UNBOUND_PORT}/g" "$resolved_template" > "$resolved_conf"; then
        echo "ERROR: Failed to create systemd-resolved configuration from template"
        exit 1
    fi
    
    # Copy backup DNS configuration
    if ! cp "$backup_conf_src" "/mnt/etc/systemd/resolved.conf.d/backup-dns.conf"; then
        echo "ERROR: Failed to copy backup DNS configuration"
        exit 1
    fi

    # Verify configuration was created
    if [[ ! -s "$resolved_conf" ]]; then
        echo "ERROR: systemd-resolved configuration is empty"
        exit 1
    fi
    
    if ! grep -q "DNS=127.0.0.1:${UNBOUND_PORT}" "$resolved_conf"; then
        echo "ERROR: systemd-resolved not configured to use unbound"
        exit 1
    fi
    
    echo "  ✓ systemd-resolved configured to use unbound upstream"
    echo "  ✓ Fallback DNS servers configured"
    echo "  ✓ Integration settings optimized"
    return 0
}

# =====================================
# NETWORKMANAGER CONFIGURATION
# =====================================

configure_networkmanager() {
    echo "Step 3/4: Configuring NetworkManager security and privacy..."
    
    local nm_security_src="$HERE/arch/etc/NetworkManager/conf.d/security.conf"
    local nm_conn_sec_src="$HERE/arch/etc/NetworkManager/conf.d/connection-security.conf"
    local nm_wifi_sec_src="$HERE/arch/etc/NetworkManager/conf.d/wifi-security.conf"
    
    # Verify source files exist
    local missing_files=()
    [[ ! -f "$nm_security_src" ]] && missing_files+=("$nm_security_src")
    [[ ! -f "$nm_conn_sec_src" ]] && missing_files+=("$nm_conn_sec_src")
    [[ ! -f "$nm_wifi_sec_src" ]] && missing_files+=("$nm_wifi_sec_src")
    
    if [[ ${#missing_files[@]} -gt 0 ]]; then
        echo "ERROR: Missing NetworkManager configuration files:"
        printf '  %s\n' "${missing_files[@]}"
        exit 1
    fi
    
    # Copy NetworkManager configuration files
    if ! cp "$nm_security_src" "$NETWORKMANAGER_CONFIG_DIR/security.conf"; then
        echo "ERROR: Failed to copy NetworkManager security configuration"
        exit 1
    fi
    
    if ! cp "$nm_conn_sec_src" "$NETWORKMANAGER_CONFIG_DIR/connection-security.conf"; then
        echo "ERROR: Failed to copy NetworkManager connection security configuration"
        exit 1
    fi
    
    if ! cp "$nm_wifi_sec_src" "$NETWORKMANAGER_CONFIG_DIR/wifi-security.conf"; then
        echo "ERROR: Failed to copy NetworkManager WiFi security configuration"
        exit 1
    fi

    # Set proper permissions
    chmod 644 "$NETWORKMANAGER_CONFIG_DIR"/*.conf
    
    # Verify NetworkManager configuration
    if [[ ! -f "$NETWORKMANAGER_CONFIG_DIR/security.conf" ]]; then
        echo "ERROR: NetworkManager security configuration not created"
        exit 1
    fi
    
    if ! grep -q "dns=systemd-resolved" "$NETWORKMANAGER_CONFIG_DIR/security.conf"; then
        echo "ERROR: NetworkManager not configured for systemd-resolved"
        exit 1
    fi
    
    echo "  ✓ NetworkManager configured for systemd-resolved integration"
    echo "  ✓ MAC address randomization enabled"
    echo "  ✓ Privacy and security settings applied"
    echo "  ✓ WiFi security hardening configured"
    return 0
}

# =====================================
# NETWORK SECURITY INTEGRATION
# =====================================

integrate_network_security() {
    echo "Step 4/4: Integrating with system security configuration..."
    
    local monitor_script_src="$HERE/arch/usr/local/bin/network-security-check"
    local monitor_service_src="$HERE/arch/etc/systemd/system/network-security-monitor.service"
    local monitor_timer_src="$HERE/arch/etc/systemd/system/network-security-monitor.timer"
    
    # Verify source files exist
    local missing_files=()
    [[ ! -f "$monitor_script_src" ]] && missing_files+=("$monitor_script_src")
    [[ ! -f "$monitor_service_src" ]] && missing_files+=("$monitor_service_src")
    [[ ! -f "$monitor_timer_src" ]] && missing_files+=("$monitor_timer_src")
    
    if [[ ${#missing_files[@]} -gt 0 ]]; then
        echo "ERROR: Missing network monitoring files:"
        printf '  %s\n' "${missing_files[@]}"
        exit 1
    fi
    
    # Copy network security monitoring script
    if ! cp "$monitor_script_src" "/mnt/usr/local/bin/network-security-check"; then
        echo "ERROR: Failed to copy network security monitoring script"
        exit 1
    fi
    
    # Make the script executable
    chmod 755 "/mnt/usr/local/bin/network-security-check"
    
    # Copy systemd service files
    if ! cp "$monitor_service_src" "/mnt/etc/systemd/system/network-security-monitor.service"; then
        echo "ERROR: Failed to copy network security monitor service"
        exit 1
    fi
    
    if ! cp "$monitor_timer_src" "/mnt/etc/systemd/system/network-security-monitor.timer"; then
        echo "ERROR: Failed to copy network security monitor timer"
        exit 1
    fi

    # Verify integration files were created
    if [[ ! -x "/mnt/usr/local/bin/network-security-check" ]]; then
        echo "ERROR: Network security check script not created"
        exit 1
    fi
    
    echo "  ✓ Network security monitoring script created"
    echo "  ✓ Systemd monitoring service configured"
    echo "  ✓ Security integration complete"
    return 0
}

# =====================================
# CONFIGURATION VALIDATION
# =====================================

validate_network_configuration() {
    echo "Validating complete network configuration..."
    
    local validation_errors=0
    
    # Check unbound configuration
    if [[ ! -f "$UNBOUND_CONFIG_DIR/unbound.conf" ]]; then
        echo "ERROR: Unbound configuration missing"
        ((validation_errors++))
    elif ! grep -q "forward-tls-upstream: yes" "$UNBOUND_CONFIG_DIR/unbound.conf"; then
        echo "ERROR: Unbound DoT configuration invalid"
        ((validation_errors++))
    else
        echo "  ✓ Unbound configuration validated"
    fi
    
    # Check systemd-resolved configuration
    if [[ ! -f "$SYSTEMD_RESOLVED_CONFIG_DIR/unbound-integration.conf" ]]; then
        echo "ERROR: systemd-resolved integration missing"
        ((validation_errors++))
    elif ! grep -q "DNS=127.0.0.1:$UNBOUND_PORT" "$SYSTEMD_RESOLVED_CONFIG_DIR/unbound-integration.conf"; then
        echo "ERROR: systemd-resolved unbound integration invalid"
        ((validation_errors++))
    else
        echo "  ✓ systemd-resolved integration validated"
    fi
    
    # Check NetworkManager configuration
    if [[ ! -f "$NETWORKMANAGER_CONFIG_DIR/security.conf" ]]; then
        echo "ERROR: NetworkManager security configuration missing"
        ((validation_errors++))
    elif ! grep -q "dns=systemd-resolved" "$NETWORKMANAGER_CONFIG_DIR/security.conf"; then
        echo "ERROR: NetworkManager systemd-resolved integration invalid"
        ((validation_errors++))
    else
        echo "  ✓ NetworkManager configuration validated"
    fi
    
    # Check monitoring integration
    if [[ ! -x "/mnt/usr/local/bin/network-security-check" ]]; then
        echo "ERROR: Network security monitoring missing"
        ((validation_errors++))
    else
        echo "  ✓ Network security monitoring validated"
    fi
    
    if [[ $validation_errors -gt 0 ]]; then
        echo "ERROR: $validation_errors network configuration failures"
        exit 1
    fi
    
    echo "All network configurations validated successfully"
    return 0
}

display_network_summary() {
    echo ""
    echo "=== Network Configuration Summary ==="
    echo ""
    
    echo "=== DNS Resolution Chain ==="
    echo "  Applications → systemd-resolved (127.0.0.53:53)"
    echo "               ↓"
    echo "               → Unbound (127.0.0.1:$UNBOUND_PORT)"
    echo "                 ↓"
    echo "                 → Secure DNS Servers (DoT)"
    echo ""
    
    echo "=== Security Features ==="
    echo "  • DNS-over-TLS encryption"
    echo "  • DNSSEC validation"
    echo "  • Query minimization for privacy"
    echo "  • MAC address randomization"
    echo "  • Hostname privacy protection"
    echo "  • WiFi security hardening"
    echo ""
    
    echo "=== Performance Features ==="
    echo "  • Optimized caching (unbound)"
    echo "  • Prefetching for faster resolution"
    echo "  • Serve expired for availability"
    echo "  • Local development zone support"
    echo ""
    
    echo "=== Integration ==="
    echo "  • No conflicts between components"
    echo "  • Seamless fallback if unbound fails"
    echo "  • NetworkManager privacy integration"
    echo "  • Security monitoring included"
    echo ""
    
    echo "=== Configuration Files ==="
    echo "  • Unbound: /etc/unbound/unbound.conf"
    echo "  • systemd-resolved: /etc/systemd/resolved.conf.d/"
    echo "  • NetworkManager: /etc/NetworkManager/conf.d/"
    echo "  • Monitoring: /usr/local/bin/network-security-check"
    echo ""
    
    echo "=== Post-Installation Commands ==="
    echo "  • Check status: network-security-check"
    echo "  • Unbound control: unbound-control status"
    echo "  • DNS test: resolvectl query cloudflare.com"
    echo "  • Monitor: journalctl -u unbound -f"
    echo "=================================="
    echo ""
}

# =====================================
# MAIN NETWORK CONFIGURATION PROCESS
# =====================================

echo "=== Secure Network Configuration ==="
echo "Implementing unbound + systemd-resolved + NetworkManager integration"
echo ""

# Pre-configuration validation
validate_network_packages || exit 1
validate_target_directories || exit 1

# Main network configuration steps
configure_unbound_resolver || exit 1
configure_systemd_resolved || exit 1
configure_networkmanager || exit 1
integrate_network_security || exit 1

# Post-configuration validation
validate_network_configuration || exit 1

# Display summary
display_network_summary

echo "=== Network Configuration Complete ==="
echo "✓ Unbound DNS resolver with DoT and DNSSEC"
echo "✓ systemd-resolved integration (no conflicts)"
echo "✓ NetworkManager privacy and security"
echo "✓ Performance optimizations for development"
echo "✓ Security monitoring and fallback configured"
echo "✓ All components working together seamlessly"
echo ""
echo "Network stack ready with enterprise-grade security and performance"
