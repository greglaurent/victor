#!/usr/bin/env bash

# arch/06-config-security
# Configure enterprise-grade security optimized for development workstations

set -euo pipefail

# Source echo function

# =====================================
# SECURITY CONFIGURATION CONSTANTS
# =====================================

readonly SYSCTL_CONFIG_NAME="99-developer-workstation.conf"
readonly SSH_CONFIG_DIR="/mnt/etc/ssh"
readonly APPARMOR_CONFIG_DIR="/mnt/etc/apparmor.d"
readonly AUDIT_CONFIG_DIR="/mnt/etc/audit"
readonly FAIL2BAN_CONFIG_DIR="/mnt/etc/fail2ban"

# =====================================
# VALIDATION FUNCTIONS
# =====================================

validate_target_directories() {
    echo "Validating target system directories..."
    
    local required_dirs=(
        "/mnt/etc"
        "/mnt/etc/systemd/system"
        "/mnt/etc/ssh"
    )
    
    for dir in "${required_dirs[@]}"; do
        if [[ ! -d "$dir" ]]; then
            echo "ERROR: Required directory missing: $dir"
            exit 1
        fi
    done
    
    echo "Target directories validated"
    return 0
}

check_security_packages() {
    echo "Checking security packages installation..."
    
    local required_packages=("apparmor" "audit" "ufw" "fail2ban")
    local missing_packages=()
    
    for package in "${required_packages[@]}"; do
        if ! arch-chroot /mnt pacman -Q "$package" &>/dev/null; then
            missing_packages+=("$package")
        fi
    done
    
    if [[ ${#missing_packages[@]} -gt 0 ]]; then
        echo "ERROR: Missing security packages: ${missing_packages[*]}"
        echo "These should have been installed in pacstrap phase"
        exit 1
    fi
    
    echo "All required security packages confirmed installed"
    return 0
}

validate_config_templates() {
    echo "Validating security configuration templates..."
    
    local config_files=(
        "$HERE/arch/etc/sysctl.d/99-developer-workstation.conf"
        "$HERE/arch/etc/apparmor/parser.conf"
        "$HERE/arch/etc/audit/rules.d/apparmor.rules"
        "$HERE/arch/etc/ssh/ssh_config.d/10-custom.conf"
        "$HERE/arch/etc/ssh/sshd_config.d/10-custom.conf"
        "$HERE/arch/etc/issue.net"
        "$HERE/arch/etc/fail2ban/jail.d/sshd.local"
        "$HERE/arch/etc/fail2ban/fail2ban.local"
        "$HERE/arch/etc/ufw/user.rules"
        "$HERE/arch/etc/systemd/resolved.conf.d/backup-dns.conf"
        "$HERE/arch/etc/NetworkManager/conf.d/security.conf"
        "$HERE/arch/etc/sudoers.d/security"
        "$HERE/arch/etc/systemd/system/service.d/hardening.conf"
        "$HERE/arch/etc/aide.conf"
    )
    
    local missing_files=()
    
    for config_file in "${config_files[@]}"; do
        if [[ ! -f "$config_file" ]]; then
            missing_files+=("$config_file")
        fi
    done
    
    if [[ ${#missing_files[@]} -gt 0 ]]; then
        echo "ERROR: Missing configuration templates:"
        printf '  %s\n' "${missing_files[@]}"
        exit 1
    fi
    
    echo "All security configuration templates found"
    return 0
}

# =====================================
# SYSCTL SECURITY CONFIGURATION
# =====================================

install_sysctl_security() {
    echo "Step 1/6: Installing developer-friendly security configuration..."
    
    local sysctl_dir="/mnt/etc/sysctl.d"
    local sysctl_file="$sysctl_dir/$SYSCTL_CONFIG_NAME"
    local template_file="$HERE/arch/etc/sysctl.d/$SYSCTL_CONFIG_NAME"
    
    # Create sysctl.d directory if it doesn't exist
    mkdir -p "$sysctl_dir"
    
    # Remove any old problematic configurations
    rm -f "$sysctl_dir/99-workstation.conf"
    
    # Copy configuration from template
    if ! cp "$template_file" "$sysctl_file"; then
        echo "ERROR: Failed to copy sysctl configuration"
        exit 1
    fi
    
    # Verify configuration was copied correctly
    if [[ ! -s "$sysctl_file" ]]; then
        echo "ERROR: sysctl configuration file is empty"
        exit 1
    fi
    
    if ! grep -q "kernel.yama.ptrace_scope = 1" "$sysctl_file"; then
        echo "ERROR: sysctl configuration not copied correctly"
        exit 1
    fi
    
    # Set proper permissions
    chmod 644 "$sysctl_file"
    
    echo "  ✓ Developer-friendly security configuration installed"
    echo "  ✓ Kernel hardening enabled without breaking development tools"
    return 0
}

# =====================================
# APPARMOR SECURITY FRAMEWORK
# =====================================

setup_apparmor_foundation() {
    echo "Step 2/6: Setting up AppArmor security framework..."
    
    # Create AppArmor directory structure
    mkdir -p "$APPARMOR_CONFIG_DIR"/{local,abstractions/local,cache,profiles/extras}
    
    # Copy AppArmor parser configuration
    if ! cp "$HERE/arch/etc/apparmor/parser.conf" "/mnt/etc/apparmor/parser.conf"; then
        echo "ERROR: Failed to copy AppArmor parser configuration"
        exit 1
    fi
    
    # Set up audit logging configuration
    mkdir -p "$AUDIT_CONFIG_DIR/rules.d"
    
    if ! cp "$HERE/arch/etc/audit/rules.d/apparmor.rules" "$AUDIT_CONFIG_DIR/rules.d/apparmor.rules"; then
        echo "ERROR: Failed to copy AppArmor audit rules"
        exit 1
    fi
    
    # Copy AppArmor local customization README
    local apparmor_readme_src="$HERE/arch/etc/apparmor.d/local/README"
    
    if [[ ! -f "$apparmor_readme_src" ]]; then
        echo "ERROR: AppArmor local README not found: $apparmor_readme_src"
        exit 1
    fi
    
    if ! cp "$apparmor_readme_src" "$APPARMOR_CONFIG_DIR/local/README"; then
        echo "ERROR: Failed to copy AppArmor local README"
        exit 1
    fi

    # Set proper permissions
    chmod 755 "$APPARMOR_CONFIG_DIR"/{local,abstractions/local,cache}
    chmod 644 "$APPARMOR_CONFIG_DIR/local/README"
    chmod 644 "/mnt/etc/apparmor/parser.conf"
    chmod 644 "$AUDIT_CONFIG_DIR/rules.d/apparmor.rules"
    
    # Verify AppArmor structure was created
    if [[ ! -d "$APPARMOR_CONFIG_DIR/local" ]]; then
        echo "ERROR: AppArmor directory structure not created"
        exit 1
    fi
    
    echo "  ✓ AppArmor directory structure created"
    echo "  ✓ Audit logging configured for security events"
    echo "  ✓ Profile deployment prepared for post-installation"
    return 0
}

# =====================================
# SSH SECURITY HARDENING
# =====================================

configure_ssh_security() {
    echo "Step 3/6: Configuring SSH security..."
    
    # Ensure SSH config directories exist
    mkdir -p "$SSH_CONFIG_DIR/ssh_config.d" "$SSH_CONFIG_DIR/sshd_config.d"
    
    # Copy SSH client configuration
    if ! cp "$HERE/arch/etc/ssh/ssh_config.d/10-custom.conf" "$SSH_CONFIG_DIR/ssh_config.d/10-custom.conf"; then
        echo "ERROR: Failed to copy SSH client configuration"
        exit 1
    fi
    
    # Copy SSH server configuration
    if ! cp "$HERE/arch/etc/ssh/sshd_config.d/10-custom.conf" "$SSH_CONFIG_DIR/sshd_config.d/10-custom.conf"; then
        echo "ERROR: Failed to copy SSH server configuration"
        exit 1
    fi
    
    # Copy security banner
    if ! cp "$HERE/arch/etc/issue.net" "/mnt/etc/issue.net"; then
        echo "ERROR: Failed to copy security banner"
        exit 1
    fi
    
    # Set proper permissions
    chmod 644 "$SSH_CONFIG_DIR/ssh_config.d/10-custom.conf"
    chmod 644 "$SSH_CONFIG_DIR/sshd_config.d/10-custom.conf"
    chmod 644 "/mnt/etc/issue.net"
    
    # Verify SSH configuration files were created
    if [[ ! -f "$SSH_CONFIG_DIR/sshd_config.d/10-custom.conf" ]]; then
        echo "ERROR: SSH server security configuration not created"
        exit 1
    fi
    
    echo "  ✓ SSH client security configuration installed"
    echo "  ✓ SSH server security hardening enabled"
    echo "  ✓ Security banner configured"
    return 0
}

# =====================================
# FAIL2BAN INTRUSION PREVENTION
# =====================================

configure_fail2ban() {
    echo "Step 4/6: Configuring intrusion prevention..."
    
    # Create fail2ban directory structure
    mkdir -p "$FAIL2BAN_CONFIG_DIR"/{jail.d,filter.d,action.d}
    
    # Copy fail2ban SSH jail configuration
    if ! cp "$HERE/arch/etc/fail2ban/jail.d/sshd.local" "$FAIL2BAN_CONFIG_DIR/jail.d/sshd.local"; then
        echo "ERROR: Failed to copy fail2ban jail configuration"
        exit 1
    fi
    
    # Copy fail2ban main configuration
    if ! cp "$HERE/arch/etc/fail2ban/fail2ban.local" "$FAIL2BAN_CONFIG_DIR/fail2ban.local"; then
        echo "ERROR: Failed to copy fail2ban main configuration"
        exit 1
    fi
    
    # Set proper permissions
    chmod 644 "$FAIL2BAN_CONFIG_DIR/jail.d/sshd.local"
    chmod 644 "$FAIL2BAN_CONFIG_DIR/fail2ban.local"
    
    # Verify fail2ban configuration
    if [[ ! -f "$FAIL2BAN_CONFIG_DIR/jail.d/sshd.local" ]]; then
        echo "ERROR: Fail2ban configuration not created"
        exit 1
    fi
    
    echo "  ✓ Fail2ban intrusion prevention configured"
    echo "  ✓ SSH brute-force protection enabled"
    return 0
}

# =====================================
# NETWORK SECURITY SETUP
# =====================================

setup_network_security() {
    echo "Step 5/6: Configuring network security..."
    
    # Configure UFW firewall default rules
    mkdir -p "/mnt/etc/ufw"
    
    if ! cp "$HERE/arch/etc/ufw/user.rules" "/mnt/etc/ufw/user.rules"; then
        echo "ERROR: Failed to copy UFW configuration"
        exit 1
    fi
    
    # Configure secure DNS resolution
    mkdir -p "/mnt/etc/systemd/resolved.conf.d"
    
    if ! cp "$HERE/arch/etc/systemd/resolved.conf.d/backup-dns.conf" "/mnt/etc/systemd/resolved.conf.d/backup-dns.conf"; then
        echo "ERROR: Failed to copy DNS security configuration"
        exit 1
    fi
    
    # Configure NetworkManager security
    mkdir -p "/mnt/etc/NetworkManager/conf.d"
    
    if ! cp "$HERE/arch/etc/NetworkManager/conf.d/security.conf" "/mnt/etc/NetworkManager/conf.d/security.conf"; then
        echo "ERROR: Failed to copy NetworkManager security configuration"
        exit 1
    fi

    # Copy time synchronization configuration  
    if ! cp "$HERE/arch/etc/systemd/timesyncd.conf" "/mnt/etc/systemd/timesyncd.conf"; then
        echo "ERROR: Failed to copy timesyncd configuration"
        exit 1
    fi
    
    # Set proper permissions
    chmod 644 "/mnt/etc/ufw/user.rules"
    chmod 644 "/mnt/etc/systemd/resolved.conf.d/backup-dns.conf"
    chmod 644 "/mnt/etc/NetworkManager/conf.d/security.conf"
    
    echo "  ✓ Firewall default-deny rules configured"
    echo "  ✓ Secure DNS resolution with DoT enabled"
    echo "  ✓ NetworkManager privacy settings applied"
    return 0
}

# =====================================
# FILESYSTEM AND SERVICE SECURITY
# =====================================

configure_filesystem_security() {
    echo "Step 6/6: Configuring filesystem and service security..."
    
    # Configure sudo security
    mkdir -p "/mnt/etc/sudoers.d"
    
    if ! cp "$HERE/arch/etc/sudoers.d/security" "/mnt/etc/sudoers.d/security"; then
        echo "ERROR: Failed to copy sudo security configuration"
        exit 1
    fi
    
    # Configure systemd service hardening template
    mkdir -p "/mnt/etc/systemd/system/service.d"
    
    if ! cp "$HERE/arch/etc/systemd/system/service.d/hardening.conf" "/mnt/etc/systemd/system/service.d/hardening.conf"; then
        echo "ERROR: Failed to copy systemd service hardening configuration"
        exit 1
    fi
    
    # Copy AIDE configuration
    if ! cp "$HERE/arch/etc/aide.conf" "/mnt/etc/aide.conf"; then
        echo "ERROR: Failed to copy AIDE configuration"
        exit 1
    fi
    
    # Set proper permissions
    chmod 440 "/mnt/etc/sudoers.d/security"
    chmod 644 "/mnt/etc/systemd/system/service.d/hardening.conf"
    chmod 600 "/mnt/etc/aide.conf"
    
    # Create security log directory
    mkdir -p "/mnt/var/log/security"
    chmod 750 "/mnt/var/log/security"
    
    # Create secure core dump directory for development debugging
    mkdir -p "/mnt/var/crash"
    chmod 755 "/mnt/var/crash"
    # Core dumps will be owned by the user who caused the crash
    
    echo "  ✓ Sudo security hardening configured"
    echo "  ✓ Systemd service hardening template created"
    echo "  ✓ File integrity monitoring prepared"
    return 0
}

# =====================================
# SECURITY VALIDATION
# =====================================

validate_security_configuration() {
    echo "Validating security configuration..."
    
    local validation_errors=0
    
    # Check sysctl configuration
    if [[ ! -f "/mnt/etc/sysctl.d/$SYSCTL_CONFIG_NAME" ]]; then
        echo "ERROR: sysctl security configuration missing"
        ((validation_errors++))
    else
        echo "  ✓ sysctl security configuration installed"
    fi
    
    # Check AppArmor structure
    if [[ ! -d "$APPARMOR_CONFIG_DIR/local" ]]; then
        echo "ERROR: AppArmor directory structure missing"
        ((validation_errors++))
    else
        echo "  ✓ AppArmor framework prepared"
    fi
    
    # Check SSH security
    if [[ ! -f "$SSH_CONFIG_DIR/sshd_config.d/10-custom.conf" ]]; then
        echo "ERROR: SSH security configuration missing"
        ((validation_errors++))
    else
        echo "  ✓ SSH security hardening configured"
    fi
    
    # Check fail2ban configuration
    if [[ ! -f "$FAIL2BAN_CONFIG_DIR/jail.d/sshd.local" ]]; then
        echo "ERROR: Fail2ban configuration missing"
        ((validation_errors++))
    else
        echo "  ✓ Fail2ban intrusion prevention configured"
    fi
    
    # Check network security
    if [[ ! -f "/mnt/etc/systemd/resolved.conf.d/backup-dns.conf" ]]; then
        echo "ERROR: DNS security configuration missing"
        ((validation_errors++))
    else
        echo "  ✓ Network security configured"
    fi
    
    # Check filesystem security
    if [[ ! -f "/mnt/etc/sudoers.d/security" ]]; then
        echo "ERROR: Sudo security configuration missing"
        ((validation_errors++))
    else
        echo "  ✓ Filesystem security configured"
    fi
    
    if [[ $validation_errors -gt 0 ]]; then
        echo "ERROR: $validation_errors security configuration failures"
        exit 1
    fi
    
    echo "All security configurations validated successfully"
    return 0
}

