# Limine bootloader configuration
# Generated by Victor Arch installation
#
# Template variables:
# {{KERNEL_PARAMS}} - Full kernel command line parameters
# {{RECOVERY_ROOT}} - Root device for recovery mode
# {{LUKS_SECTION}} - Additional entries for LUKS systems (removed if not using LUKS)

# =====================================
# BOOTLOADER SETTINGS
# =====================================

# Boot menu timeout (seconds)
TIMEOUT=5

# Default boot entry (1-indexed)
DEFAULT_ENTRY=1

# =====================================
# GRAPHICS CONFIGURATION
# =====================================

# Enable graphical boot menu
GRAPHICS=yes

# Theme settings
THEME_BACKGROUND=000000
THEME_FOREGROUND=ffffff
THEME_MARGIN=64
THEME_MARGIN_GRADIENT=4

# =====================================
# BOOT ENTRIES
# =====================================

:Arch Linux
PROTOCOL=linux
KERNEL_PATH=boot:///vmlinuz-linux
CMDLINE={{KERNEL_PARAMS}}
MODULE_PATH=boot:///initramfs-linux.img

:Arch Linux LTS
PROTOCOL=linux
KERNEL_PATH=boot:///vmlinuz-linux-lts
CMDLINE={{KERNEL_PARAMS}}
MODULE_PATH=boot:///initramfs-linux-lts.img

:Arch Linux (Recovery)
PROTOCOL=linux
KERNEL_PATH=boot:///vmlinuz-linux
CMDLINE={{RECOVERY_ROOT}} rootfstype=btrfs rw single
MODULE_PATH=boot:///initramfs-linux.img

:Arch Linux LTS (Recovery)
PROTOCOL=linux
KERNEL_PATH=boot:///vmlinuz-linux-lts
CMDLINE={{RECOVERY_ROOT}} rootfstype=btrfs rw single
MODULE_PATH=boot:///initramfs-linux-lts.img

#BEGIN_LUKS_SECTION
:Arch Linux (Emergency - No LUKS)
PROTOCOL=linux
KERNEL_PATH=boot:///vmlinuz-linux
CMDLINE=root=/dev/disk/by-partlabel/rootfs rootfstype=btrfs rw single rd.luks.options=discard
MODULE_PATH=boot:///initramfs-linux.img
#END_LUKS_SECTION