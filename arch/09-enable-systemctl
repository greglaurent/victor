#!/usr/bin/env bash

# arch/09-enable-systemctl
# Enable and configure systemd services for secure, modern Arch Linux

set -euo pipefail

# Source echo function

# =====================================
# SERVICE CATEGORIES
# =====================================

# Critical system services (must start for basic functionality)
readonly CRITICAL_SERVICES=(
    "systemd-resolved"
    "NetworkManager"
    "systemd-timesyncd"
    "systemd-oomd"
    "fstrim.timer"
)

# Security services (security framework and monitoring)
readonly SECURITY_SERVICES=(
    "apparmor"
    "auditd"
    "ufw"
    "fail2ban"
)

# Network services (DNS, SSH, and network security)
readonly NETWORK_SERVICES=(
    "unbound"
    "named"
    "sshd"
    "network-security-monitor.timer"
)

# Hardware and peripheral services
readonly HARDWARE_SERVICES=(
    "bluetooth"
    "cups"
    "reflector.timer"
)

# Snapshot and backup services
readonly SNAPSHOT_SERVICES=(
    "snapper-timeline.timer"
    "snapper-cleanup.timer"
    "grub-btrfsd"
)

# Services to disable (conflicting or unnecessary)
readonly DISABLED_SERVICES=(
    "chronyd"
)

# =====================================
# VALIDATION FUNCTIONS
# =====================================

validate_systemctl_environment() {
    echo "Validating systemctl environment..."
    
    # Ensure systemctl is available
    if ! systemctl --version &>/dev/null; then
        echo "ERROR: systemctl not available"
        return 1
    fi
    
    # Ensure we can operate on the target system
    if [[ ! -d /mnt/etc/systemd/system ]]; then
        echo "ERROR: Target systemd directory not found"
        return 1
    fi
    
    echo "systemctl environment validated"
    return 0
}

validate_service_units() {
    echo "Validating service units availability..."
    
    local all_services=()
    all_services+=("${CRITICAL_SERVICES[@]}")
    all_services+=("${SECURITY_SERVICES[@]}")
    all_services+=("${NETWORK_SERVICES[@]}")
    all_services+=("${HARDWARE_SERVICES[@]}")
    all_services+=("${SNAPSHOT_SERVICES[@]}")
    
    local missing_services=()
    local available_services=()
    
    for service in "${all_services[@]}"; do
        if systemctl cat "$service" --root=/mnt &>/dev/null; then
            available_services+=("$service")
        else
            missing_services+=("$service")
        fi
    done
    
    if [[ ${#missing_services[@]} -gt 0 ]]; then
        echo "WARNING: Some service units not found:"
        for service in "${missing_services[@]}"; do
            echo "  - $service"
        done
        echo "These services will be skipped"
    fi
    
    echo "Available services: ${#available_services[@]}"
    echo "Missing services: ${#missing_services[@]}"
    return 0
}

# =====================================
# SERVICE MANAGEMENT FUNCTIONS
# =====================================

enable_service_with_validation() {
    local service="$1"
    local category="$2"
    
    echo "  Enabling $service ($category)..."
    
    # Check if service unit exists
    if ! systemctl cat "$service" --root=/mnt &>/dev/null; then
        echo "    ⚠ Service unit not found: $service (skipping)"
        return 0
    fi
    
    # Enable the service
    if ! systemctl enable "$service" --root=/mnt 2>/dev/null; then
        echo "    ✗ Failed to enable $service"
        return 1
    fi
    
    # Verify service was enabled
    if ! systemctl is-enabled "$service" --root=/mnt &>/dev/null; then
        echo "    ✗ Service $service not enabled after command"
        return 1
    fi
    
    echo "    ✓ $service enabled successfully"
    return 0
}

disable_service_with_validation() {
    local service="$1"
    
    echo "  Disabling $service..."
    
    # Check if service exists before trying to disable
    if ! systemctl cat "$service" --root=/mnt &>/dev/null; then
        echo "    ⚠ Service unit not found: $service (skipping)"
        return 0
    fi
    
    # Disable the service
    if ! systemctl disable "$service" --root=/mnt 2>/dev/null; then
        echo "    ⚠ Failed to disable $service (may not be enabled)"
        return 0
    fi
    
    echo "    ✓ $service disabled successfully"
    return 0
}

enable_service_category() {
    local category="$1"
    shift
    local services=("$@")
    
    echo ""
    echo "Enabling $category services..."
    
    local enabled_count=0
    local failed_count=0
    
    for service in "${services[@]}"; do
        if enable_service_with_validation "$service" "$category"; then
            ((enabled_count++))
        else
            ((failed_count++))
        fi
    done
    
    echo "  ✓ $category: $enabled_count enabled, $failed_count failed"
    
    if [[ $failed_count -gt 0 && "$category" == "Critical" ]]; then
        echo "ERROR: Critical service failures detected"
        return 1
    fi
    
    return 0
}

# =====================================
# DNS RESOLUTION CONFIGURATION
# =====================================

configure_dns_resolution() {
    echo ""
    echo "Configuring DNS resolution chain..."
    
    # Remove existing resolv.conf
    if [[ -e /mnt/etc/resolv.conf ]]; then
        rm -f /mnt/etc/resolv.conf
    fi
    
    # Create systemd-resolved symlink
    if ! ln -sf /run/systemd/resolve/stub-resolv.conf /mnt/etc/resolv.conf; then
        echo "ERROR: Failed to create DNS resolution symlink"
        return 1
    fi
    
    # Verify symlink was created correctly
    local link_target
    link_target=$(readlink /mnt/etc/resolv.conf)
    if [[ "$link_target" != "/run/systemd/resolve/stub-resolv.conf" ]]; then
        echo "ERROR: DNS resolution symlink incorrect"
        echo "Expected: /run/systemd/resolve/stub-resolv.conf"
        echo "Found: $link_target"
        return 1
    fi
    
    echo "  ✓ DNS resolution chain configured:"
    echo "    Applications → systemd-resolved → unbound → secure DNS"
    return 0
}

# =====================================
# ZRAM CONFIGURATION
# =====================================

configure_zram() {
    echo ""
    echo "Configuring zram memory compression..."
    
    local zram_config="/mnt/etc/systemd/zram-generator.conf"
    
    # Verify zram configuration exists
    if [[ ! -f "$zram_config" ]]; then
        echo "ERROR: zram configuration file missing: $zram_config"
        return 1
    fi
    
    # Verify zram configuration content
    if ! grep -q "zram-size" "$zram_config"; then
        echo "ERROR: zram configuration appears invalid"
        return 1
    fi
    
    # zram-generator automatically enables itself when config file exists
    # No explicit service enablement needed
    
    echo "  ✓ zram configured for automatic memory compression"
    echo "    Config: $zram_config"
    return 0
}

# =====================================
# SERVICE DEPENDENCY VALIDATION
# =====================================

validate_service_dependencies() {
    echo ""
    echo "Validating critical service dependencies..."
    
    # Check systemd-resolved → unbound chain
    if systemctl is-enabled systemd-resolved --root=/mnt &>/dev/null; then
        if systemctl is-enabled unbound --root=/mnt &>/dev/null; then
            echo "  ✓ DNS resolution chain: systemd-resolved → unbound"
        else
            echo "  ⚠ systemd-resolved enabled but unbound missing"
        fi
    fi
    
    # Check NetworkManager → systemd-resolved integration
    if systemctl is-enabled NetworkManager --root=/mnt &>/dev/null; then
        if [[ -f /mnt/etc/NetworkManager/conf.d/security.conf ]]; then
            if grep -q "dns=systemd-resolved" /mnt/etc/NetworkManager/conf.d/security.conf; then
                echo "  ✓ NetworkManager → systemd-resolved integration"
            else
                echo "  ⚠ NetworkManager not configured for systemd-resolved"
            fi
        fi
    fi
    
    # Check AppArmor → audit integration
    if systemctl is-enabled apparmor --root=/mnt &>/dev/null; then
        if systemctl is-enabled auditd --root=/mnt &>/dev/null; then
            echo "  ✓ AppArmor → audit logging integration"
        else
            echo "  ⚠ AppArmor enabled but audit logging missing"
        fi
    fi
    
    # Check snapshot services integration
    if systemctl is-enabled snapper-timeline.timer --root=/mnt &>/dev/null; then
        if systemctl is-enabled snapper-cleanup.timer --root=/mnt &>/dev/null; then
            echo "  ✓ Snapper snapshot services configured"
        else
            echo "  ⚠ Snapshot timeline enabled but cleanup missing"
        fi
    fi
    
    echo "Service dependency validation complete"
    return 0
}

# =====================================
# SERVICE STATUS VERIFICATION
# =====================================

verify_enabled_services() {
    echo ""
    echo "Verifying enabled services..."
    
    local all_services=()
    all_services+=("${CRITICAL_SERVICES[@]}")
    all_services+=("${SECURITY_SERVICES[@]}")
    all_services+=("${NETWORK_SERVICES[@]}")
    all_services+=("${HARDWARE_SERVICES[@]}")
    all_services+=("${SNAPSHOT_SERVICES[@]}")
    
    local enabled_services=()
    local disabled_services=()
    
    for service in "${all_services[@]}"; do
        if systemctl is-enabled "$service" --root=/mnt &>/dev/null; then
            enabled_services+=("$service")
        else
            disabled_services+=("$service")
        fi
    done
    
    echo "  Enabled services: ${#enabled_services[@]}"
    echo "  Not enabled: ${#disabled_services[@]}"
    
    if [[ ${#disabled_services[@]} -gt 0 ]]; then
        echo ""
        echo "Services not enabled:"
        for service in "${disabled_services[@]}"; do
            local reason="unknown"
            if ! systemctl cat "$service" --root=/mnt &>/dev/null; then
                reason="unit not found"
            fi
            echo "    - $service ($reason)"
        done
    fi
    
    return 0
}

# =====================================
# INSTALLATION SUMMARY
# =====================================

display_services_summary() {
    echo ""
    echo "=== Systemd Services Configuration Summary ==="
    echo ""
    
    echo "=== Critical System Services ==="
    for service in "${CRITICAL_SERVICES[@]}"; do
        local status="✗"
        if systemctl is-enabled "$service" --root=/mnt &>/dev/null; then
            status="✓"
        fi
        echo "  $status $service"
    done
    
    echo ""
    echo "=== Security Services ==="
    for service in "${SECURITY_SERVICES[@]}"; do
        local status="✗"
        if systemctl is-enabled "$service" --root=/mnt &>/dev/null; then
            status="✓"
        fi
        echo "  $status $service"
    done
    
    echo ""
    echo "=== Network Services ==="
    for service in "${NETWORK_SERVICES[@]}"; do
        local status="✗"
        if systemctl is-enabled "$service" --root=/mnt &>/dev/null; then
            status="✓"
        fi
        echo "  $status $service"
    done
    
    echo ""
    echo "=== Hardware & Peripheral Services ==="
    for service in "${HARDWARE_SERVICES[@]}"; do
        local status="✗"
        if systemctl is-enabled "$service" --root=/mnt &>/dev/null; then
            status="✓"
        fi
        echo "  $status $service"
    done
    
    echo ""
    echo "=== Snapshot & Backup Services ==="
    for service in "${SNAPSHOT_SERVICES[@]}"; do
        local status="✗"
        if systemctl is-enabled "$service" --root=/mnt &>/dev/null; then
            status="✓"
        fi
        echo "  $status $service"
    done
    
    echo ""
    echo "=== Service Integration ==="
    echo "  • DNS: Applications → systemd-resolved → unbound → secure DNS"
    echo "  • Security: AppArmor + audit logging + fail2ban"
    echo "  • Network: Unbound DoT + NetworkManager privacy"
    echo "  • Snapshots: Timeline + cleanup automation"
    echo "  • Memory: zram compression enabled"
    echo ""
    
    echo "=== Post-Boot Commands ==="
    echo "  • Check services: systemctl status unbound apparmor"
    echo "  • DNS test: resolvectl query cloudflare.com"
    echo "  • Security check: network-security-check"
    echo "  • Snapshot list: snapper list"
    echo "  • Firewall setup: ufw allow ssh && ufw enable"
    echo "===================================================="
    echo ""
}

# =====================================
# MAIN SERVICE CONFIGURATION PROCESS
# =====================================

echo "=== Systemd Services Configuration ==="
echo "Enabling services for secure, modern Arch Linux system"
echo ""

# Pre-configuration validation
validate_systemctl_environment || return 1
validate_service_units

# Disable conflicting services first
echo ""
echo "Disabling conflicting services..."
for service in "${DISABLED_SERVICES[@]}"; do
    disable_service_with_validation "$service"
done

# Enable services by category (order matters)
enable_service_category "Critical" "${CRITICAL_SERVICES[@]}" || return 1
enable_service_category "Security" "${SECURITY_SERVICES[@]}" || return 1
enable_service_category "Network" "${NETWORK_SERVICES[@]}" || return 1
enable_service_category "Hardware" "${HARDWARE_SERVICES[@]}" || return 1
enable_service_category "Snapshot" "${SNAPSHOT_SERVICES[@]}" || return 1

# Configure additional system services
configure_dns_resolution || return 1
configure_zram || return 1

# Validation and verification
validate_service_dependencies
verify_enabled_services

# Display comprehensive summary
display_services_summary

echo "=== Systemd Services Configuration Complete ==="
echo "✓ Critical services enabled and validated"
echo "✓ Security framework services configured"
echo "✓ Network services with privacy and security"
echo "✓ Hardware support services enabled"
echo "✓ Snapshot and backup automation configured"
echo "✓ DNS resolution chain properly integrated"
echo "✓ Memory compression (zram) configured"
echo ""
echo "System services ready for secure, modern operation"
