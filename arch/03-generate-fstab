}

# =====================================
# MAIN NETWORK CONFIGURATION PROCESS
# =====================================

output "=== Secure Network Configuration ==="
output "Implementing unbound + systemd-resolved + NetworkManager integration"
output ""

# Pre-configuration validation
validate_network_packages || exit 1
validate_target_directories || exit 1

# Main network configuration steps
configure_unbound_resolver || exit 1
configure_systemd_resolved || exit 1
configure_networkmanager || exit 1
integrate_network_security || exit 1

# Post-configuration validation
validate_network_configuration || exit 1

# Display summary
display_network_summary

output "=== Network Configuration Complete ==="
output "✓ Unbound DNS resolver with DoT and DNSSEC"
output "✓ systemd-resolved integration (no conflicts)"
output "✓ NetworkManager privacy and security"
output "✓ Performance optimizations for development"
output "✓ Security monitoring and fallback configured"
output "✓ All components working together seamlessly"
output ""
output "Network stack ready with enterprise-grade security and performance"
