#!/usr/bin/env bash

# arch/03-generate-fstab
# Generate filesystem table for the new system

set -euo pipefail

# Source output function
output() {
    printf '\\e[1;34m%-6s\\e[m\\n' \"${@}\"
}

# =====================================
# VALIDATION FUNCTIONS
# =====================================

validate_current_mounts() {
    output "Validating current mount structure..."
    
    # Expected mount points based on our BTRFS setup
    local expected_mounts=(
        "/mnt"                # Root filesystem
        "/mnt/home"          # Home subvolume
        "/mnt/var/log"       # Logs subvolume
        "/mnt/swap"          # Swap subvolume
        "/mnt/.snapshots"    # Snapshots subvolume
        "/mnt/boot/efi"      # ESP partition
    )
    
    local mount_errors=0
    
    for mount_point in "${expected_mounts[@]}"; do
        if ! mountpoint -q "$mount_point"; then
            output "ERROR: $mount_point is not mounted"
            ((mount_errors++))
        else
            output "  ✓ $mount_point is properly mounted"
        fi
    done
    
    if [[ $mount_errors -gt 0 ]]; then
        output "ERROR: $mount_errors mount points are missing"
        output "Cannot generate fstab with incomplete mount structure"
        return 1
    fi
    
    output "Mount structure validation passed"
    return 0
}

verify_filesystem_types() {
    output "Verifying filesystem types..."
    
    # Check BTRFS root
    local root_fstype
    root_fstype=$(findmnt -n -o FSTYPE /mnt)
    if [[ "$root_fstype" != "btrfs" ]]; then
        output "ERROR: Root filesystem is not BTRFS (found: $root_fstype)"
        return 1
    fi
    
    # Check ESP
    local esp_fstype
    esp_fstype=$(findmnt -n -o FSTYPE /mnt/boot/efi)
    if [[ "$esp_fstype" != "vfat" ]]; then
        output "ERROR: ESP is not FAT32 (found: $esp_fstype)"
        return 1
    fi
    
    output "Filesystem types verified correctly"
    return 0
}

# =====================================
# FSTAB GENERATION
# =====================================

generate_fstab() {
    output "Generating fstab with UUIDs..."
    
    # Generate fstab using UUIDs for device identification
    if ! genfstab -U /mnt > /tmp/fstab.new 2>/dev/null; then
        output "ERROR: Failed to generate fstab"
        return 1
    fi
    
    # Validate fstab was created and is not empty
    if [[ ! -s /tmp/fstab.new ]]; then
        output "ERROR: Generated fstab is empty"
        return 1
    fi
    
    # Check for minimum expected entries
    local fstab_lines
    fstab_lines=$(grep -c "^[^#]" /tmp/fstab.new || echo "0")
    if [[ $fstab_lines -lt 6 ]]; then
        output "ERROR: Generated fstab has too few entries ($fstab_lines)"
        output "Expected at least 6 filesystem entries"
        return 1
    fi
    
    output "fstab generated successfully with $fstab_lines filesystem entries"
    return 0
}

clean_fstab_subvolume_references() {
    output "Cleaning conflicting subvolume references..."
    
    # Explanation of the sed operation:
    # When we set a default subvolume for snapper (@snapshots/1/snapshot),
    # genfstab generates entries that reference this snapshot subvolume explicitly.
    # This creates conflicts because:
    # 1. The default subvolume is already set to the snapshot
    # 2. Explicit subvolume options override the default subvolume
    # 3. This breaks the snapper snapshot boot mechanism
    #
    # We need to remove these explicit references so the default subvolume is used
    
    # Create backup before modification
    cp /tmp/fstab.new /tmp/fstab.backup
    
    # Remove the specific subvolume reference pattern that genfstab adds
    # Pattern: ,subvolid=XXX,subvol=/@/.snapshots/1/snapshot,subvol=@/.snapshots/1/snapshot
    sed -i 's|,subvolid=[0-9]*,subvol=/@/\.snapshots/1/snapshot,subvol=@/\.snapshots/1/snapshot||g' /tmp/fstab.new
    
    # Also remove any remaining single references to the snapshot subvolume
    sed -i 's|,subvol=@/\.snapshots/1/snapshot||g' /tmp/fstab.new
    sed -i 's|subvol=@/\.snapshots/1/snapshot,||g' /tmp/fstab.new
    
    # Verify the cleaning operation worked
    if grep -q "\.snapshots/1/snapshot" /tmp/fstab.new; then
        output "WARNING: Some snapshot subvolume references still exist in fstab"
        output "This may cause boot issues with snapper snapshots"
        
        # Show the problematic lines
        output "Problematic lines:"
        grep "\.snapshots/1/snapshot" /tmp/fstab.new || true
    else
        output "Successfully removed all snapshot subvolume references"
    fi
    
    # Check if any modifications were actually made
    if diff -q /tmp/fstab.backup /tmp/fstab.new &>/dev/null; then
        output "No subvolume references needed cleaning"
    else
        output "fstab cleaned of conflicting subvolume references"
    fi
}

validate_fstab() {
    output "Validating fstab syntax and feasibility..."
    
    # Check for basic syntax issues using findmnt
    if ! findmnt --verify --tab-file /tmp/fstab.new 2>/dev/null; then
        output "ERROR: fstab has syntax errors or invalid entries"
        output "Running detailed verification..."
        findmnt --verify --tab-file /tmp/fstab.new || true
        return 1
    fi
    
    # Check for duplicate mount points
    local duplicate_mounts
    duplicate_mounts=$(awk '$2 != "" {print $2}' /tmp/fstab.new | sort | uniq -d)
    if [[ -n $duplicate_mounts ]]; then
        output "ERROR: Duplicate mount points found in fstab:"
        echo "$duplicate_mounts"
        return 1
    fi
    
    # Verify all our expected mount points are in fstab
    local expected_in_fstab=("/" "/home" "/var/log" "/swap" "/.snapshots" "/boot/efi")
    local missing_mounts=()
    
    for mount_point in "${expected_in_fstab[@]}"; do
        if ! grep -q "^[^#].*[[:space:]]${mount_point}[[:space:]]" /tmp/fstab.new; then
            missing_mounts+=("$mount_point")
        fi
    done
    
    if [[ ${#missing_mounts[@]} -gt 0 ]]; then
        output "ERROR: Missing expected mount points in fstab:"
        printf '  %s\n' "${missing_mounts[@]}"
        return 1
    fi
    
    output "fstab validation passed - syntax and content verified"
    return 0
}

install_fstab() {
    output "Installing validated fstab..."
    
    # Create target directory if it doesn't exist
    mkdir -p /mnt/etc
    
    # Install the validated fstab
    if ! cp /tmp/fstab.new /mnt/etc/fstab; then
        output "ERROR: Failed to install fstab to /mnt/etc/fstab"
        return 1
    fi
    
    # Set proper permissions
    chmod 644 /mnt/etc/fstab
    
    # Create backup in the target system
    cp /mnt/etc/fstab /mnt/etc/fstab.backup
    
    output "fstab installed successfully with backup created"
    return 0
}

display_fstab_summary() {
    output ""
    output "=== Generated fstab Summary ==="
    
    # Count entries by filesystem type
    local btrfs_entries
    local vfat_entries
    local total_entries
    
    btrfs_entries=$(grep -c "btrfs" /mnt/etc/fstab || echo "0")
    vfat_entries=$(grep -c "vfat" /mnt/etc/fstab || echo "0")
    total_entries=$(grep -c "^[^#]" /mnt/etc/fstab || echo "0")
    
    output "Total filesystem entries: $total_entries"
    output "  BTRFS subvolumes: $btrfs_entries"
    output "  FAT32 (ESP): $vfat_entries"
    output ""
    
    output "=== fstab Contents ==="
    # Display with line numbers for easier reference
    nl -ba /mnt/etc/fstab
    output "========================"
    output ""
    
    # Show mount options summary
    output "=== Mount Options Summary ==="
    while IFS= read -r line; do
        if [[ $line =~ ^[^#] ]]; then
            local mount_point fs_type options
            mount_point=$(echo "$line" | awk '{print $2}')
            fs_type=$(echo "$line" | awk '{print $3}')
            options=$(echo "$line" | awk '{print $4}')
            
            output "  $mount_point ($fs_type): $options"
        fi
    done < /mnt/etc/fstab
    output "=============================="
    output ""
}

# =====================================
# MAIN FSTAB GENERATION PROCESS
# =====================================

output "=== fstab Generation ==="

# Step 1: Validate current system state
validate_current_mounts || return 1
verify_filesystem_types || return 1

# Step 2: Generate fstab
generate_fstab || return 1

# Step 3: Clean conflicting references
clean_fstab_subvolume_references

# Step 4: Validate generated fstab
validate_fstab || return 1

# Step 5: Install fstab
install_fstab || return 1

# Step 6: Display summary
display_fstab_summary

# Cleanup temporary files
rm -f /tmp/fstab.new /tmp/fstab.backup

output "=== fstab Generation Complete ==="
output "✓ Mount structure validated"
output "✓ fstab generated with UUIDs"
output "✓ Subvolume conflicts resolved"
output "✓ Syntax and content validated"
output "✓ fstab installed with backup"
output ""
output "The system is ready for boot with the generated fstab"
