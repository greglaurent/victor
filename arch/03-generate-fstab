#!/usr/bin/env bash

# arch/03-generate-fstab
# Generate filesystem table for the new system

set -euo pipefail

# Source echo function

# =====================================
# VALIDATION FUNCTIONS
# =====================================

validate_current_mounts() {
    echo "Validating current mount structure..."
    
    # Expected mount points based on our BTRFS setup
    local expected_mounts=(
        "/mnt"                # Root filesystem
        "/mnt/home"          # Home subvolume
        "/mnt/var/log"       # Logs subvolume
        "/mnt/swap"          # Swap subvolume
        "/mnt/.snapshots"    # Snapshots subvolume
        "/mnt/boot/efi"      # ESP partition
    )
    
    local mount_errors=0
    
    for mount_point in "${expected_mounts[@]}"; do
        if ! mountpoint -q "$mount_point"; then
            echo "ERROR: $mount_point is not mounted"
            ((mount_errors++))
        else
            echo "  ✓ $mount_point is properly mounted"
        fi
    done
    
    if [[ $mount_errors -gt 0 ]]; then
        echo "ERROR: $mount_errors mount points are missing"
        echo "Cannot generate fstab with incomplete mount structure"
        return 1
    fi
    
    echo "Mount structure validation passed"
    return 0
}

verify_filesystem_types() {
    echo "Verifying filesystem types..."
    
    # Check BTRFS root
    local root_fstype
    root_fstype=$(findmnt -n -o FSTYPE /mnt)
    if [[ "$root_fstype" != "btrfs" ]]; then
        echo "ERROR: Root filesystem is not BTRFS (found: $root_fstype)"
        return 1
    fi
    
    # Check ESP
    local esp_fstype
    esp_fstype=$(findmnt -n -o FSTYPE /mnt/boot/efi)
    if [[ "$esp_fstype" != "vfat" ]]; then
        echo "ERROR: ESP is not FAT32 (found: $esp_fstype)"
        return 1
    fi
    
    echo "Filesystem types verified correctly"
    return 0
}

# =====================================
# FSTAB GENERATION
# =====================================

generate_fstab() {
    echo "Generating fstab from template..."
    
    # Check if template exists
    if [[ ! -f "fstab.template" ]]; then
        echo "ERROR: fstab template not found"
        return 1
    fi
    
    # Get UUIDs
    local esp_uuid root_device
    esp_uuid=$(lsblk -no UUID /dev/disk/by-partlabel/ESP)
    
    # Determine root device based on encryption
    if [[ ${use_luks:-0} -eq 1 ]]; then
        root_device="/dev/mapper/cryptroot"
    else
        local root_uuid
        root_uuid=$(lsblk -no UUID /dev/disk/by-partlabel/ROOT)
        root_device="UUID=${root_uuid}"
    fi
    
    # Validate UUIDs were found
    if [[ -z "$esp_uuid" ]]; then
        echo "ERROR: ESP UUID not found"
        return 1
    fi
    
    if [[ ${use_luks:-0} -eq 0 && -z "${root_uuid:-}" ]]; then
        echo "ERROR: Root UUID not found"
        return 1
    fi
    
    # Generate fstab from template
    sed -e "s|__ROOT_DEVICE__|${root_device}|g" \
        -e "s|__ESP_UUID__|${esp_uuid}|g" \
        "fstab.template" > /tmp/fstab.new
    
    # Validate fstab was created
    if [[ ! -s /tmp/fstab.new ]]; then
        echo "ERROR: Generated fstab is empty"
        return 1
    fi
    
    echo "fstab generated successfully from template"
    return 0
}


validate_fstab() {
    echo "Validating fstab syntax and feasibility..."
    
    # Check for basic syntax issues using findmnt
    if ! findmnt --verify --tab-file /tmp/fstab.new 2>/dev/null; then
        echo "ERROR: fstab has syntax errors or invalid entries"
        echo "Running detailed verification..."
        findmnt --verify --tab-file /tmp/fstab.new || true
        echo ""
        echo "Current fstab content:"
        cat /tmp/fstab.new
        echo ""
        echo "Checking for common issues..."
        
        # Check for malformed mount options
        if grep -n ",," /tmp/fstab.new; then
            echo "Found double commas in mount options (lines shown above)"
        fi
        
        # Check for trailing/leading commas
        if grep -n "[[:space:]]," /tmp/fstab.new; then
            echo "Found leading commas in mount options (lines shown above)"
        fi
        
        if grep -n ",[[:space:]]" /tmp/fstab.new; then
            echo "Found trailing commas in mount options (lines shown above)"
        fi
        
        return 1
    fi
    
    # Check for duplicate mount points
    local duplicate_mounts
    duplicate_mounts=$(awk '$2 != "" {print $2}' /tmp/fstab.new | sort | uniq -d)
    if [[ -n $duplicate_mounts ]]; then
        echo "ERROR: Duplicate mount points found in fstab:"
        echo "$duplicate_mounts"
        return 1
    fi
    
    # Verify all our expected mount points are in fstab
    local expected_in_fstab=("/" "/home" "/var/log" "/swap" "/.snapshots" "/boot/efi")
    local missing_mounts=()
    
    for mount_point in "${expected_in_fstab[@]}"; do
        if ! grep -q "^[^#].*[[:space:]]${mount_point}[[:space:]]" /tmp/fstab.new; then
            missing_mounts+=("$mount_point")
        fi
    done
    
    if [[ ${#missing_mounts[@]} -gt 0 ]]; then
        echo "ERROR: Missing expected mount points in fstab:"
        printf '  %s\n' "${missing_mounts[@]}"
        return 1
    fi
    
    echo "fstab validation passed - syntax and content verified"
    return 0
}

install_fstab() {
    echo "Installing validated fstab..."
    
    # Create target directory if it doesn't exist
    mkdir -p /mnt/etc
    
    # Install the validated fstab
    if ! cp /tmp/fstab.new /mnt/etc/fstab; then
        echo "ERROR: Failed to install fstab to /mnt/etc/fstab"
        return 1
    fi
    
    # Set proper permissions
    chmod 644 /mnt/etc/fstab
    
    # Create backup in the target system
    cp /mnt/etc/fstab /mnt/etc/fstab.backup
    
    echo "fstab installed successfully with backup created"
    return 0
}

display_fstab_summary() {
    echo ""
    echo "=== Generated fstab Summary ==="
    
    # Count entries by filesystem type
    local btrfs_entries
    local vfat_entries
    local total_entries
    
    btrfs_entries=$(grep -c "btrfs" /mnt/etc/fstab || echo "0")
    vfat_entries=$(grep -c "vfat" /mnt/etc/fstab || echo "0")
    total_entries=$(grep -c "^[^#]" /mnt/etc/fstab || echo "0")
    
    echo "Total filesystem entries: $total_entries"
    echo "  BTRFS subvolumes: $btrfs_entries"
    echo "  FAT32 (ESP): $vfat_entries"
    echo ""
    
    echo "=== fstab Contents ==="
    # Display with line numbers for easier reference
    nl -ba /mnt/etc/fstab
    echo "========================"
    echo ""
    
    # Show mount options summary
    echo "=== Mount Options Summary ==="
    while IFS= read -r line; do
        if [[ $line =~ ^[^#] ]]; then
            local mount_point fs_type options
            mount_point=$(echo "$line" | awk '{print $2}')
            fs_type=$(echo "$line" | awk '{print $3}')
            options=$(echo "$line" | awk '{print $4}')
            
            echo "  $mount_point ($fs_type): $options"
        fi
    done < /mnt/etc/fstab
    echo "=============================="
    echo ""
}

# =====================================
# MAIN FSTAB GENERATION PROCESS
# =====================================

echo "=== fstab Generation ==="

# Step 1: Validate current system state
validate_current_mounts || exit 1
verify_filesystem_types || exit 1

# Step 2: Generate fstab
generate_fstab || exit 1

# Step 3: Validate generated fstab
validate_fstab || exit 1

# Step 4: Install fstab
install_fstab || exit 1

# Step 5: Display summary
display_fstab_summary

# Cleanup temporary files
rm -f /tmp/fstab.new /tmp/fstab.backup

echo "=== fstab Generation Complete ==="
echo "✓ Mount structure validated"
echo "✓ fstab generated with UUIDs"
echo "✓ Subvolume conflicts resolved"
echo "✓ Syntax and content validated"
echo "✓ fstab installed with backup"
echo ""
echo "The system is ready for boot with the generated fstab"
