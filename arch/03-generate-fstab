#!/usr/bin/env bash

# arch/07-config-network
# Configure secure network stack with unbound DNS resolver

set -euo pipefail

# =====================================
# NETWORK CONFIGURATION CONSTANTS
# =====================================

readonly UNBOUND_PORT="5353"
readonly SYSTEMD_RESOLVED_PORT="53"
readonly NETWORKMANAGER_CONFIG_DIR="/mnt/etc/NetworkManager/conf.d"
readonly UNBOUND_CONFIG_DIR="/mnt/etc/unbound"
readonly SYSTEMD_RESOLVED_CONFIG_DIR="/mnt/etc/systemd/resolved.conf.d"

# Secure DNS servers with DoT support
readonly SECURE_DNS_SERVERS=(
    "1.1.1.2@853#security.cloudflare-dns.com"      # Cloudflare for Families
    "1.0.0.2@853#security.cloudflare-dns.com"
    "9.9.9.9@853#dns.quad9.net"                    # Quad9 security
    "149.112.112.112@853#dns.quad9.net"
)

# =====================================
# VALIDATION FUNCTIONS
# =====================================

validate_network_packages() {
    output "Validating network packages..."
    
    local required_packages=("networkmanager" "unbound" "bind")
    local missing_packages=()
    
    for package in "${required_packages[@]}"; do
        if ! arch-chroot /mnt pacman -Q "$package" &>/dev/null; then
            missing_packages+=("$package")
        fi
    done
    
    if [[ ${#missing_packages[@]} -gt 0 ]]; then
        output "ERROR: Missing network packages: ${missing_packages[*]}"
        return 1
    fi
    
    output "All network packages confirmed installed"
    return 0
}

validate_target_directories() {
    output "Validating network configuration directories..."
    
    local required_dirs=(
        "/mnt/etc/NetworkManager"
        "/mnt/etc/systemd"
    )
    
    for dir in "${required_dirs[@]}"; do
        if [[ ! -d "$dir" ]]; then
            output "ERROR: Required directory missing: $dir"
            return 1
        fi
    done
    
    # Create configuration directories
    mkdir -p "$NETWORKMANAGER_CONFIG_DIR"
    mkdir -p "$UNBOUND_CONFIG_DIR/unbound.conf.d"
    mkdir -p "$SYSTEMD_RESOLVED_CONFIG_DIR"
    
    output "Network configuration directories ready"
    return 0
}

# =====================================
# UNBOUND DNS RESOLVER CONFIGURATION
# =====================================

configure_unbound_resolver() {
    output "Step 1/4: Configuring Unbound DNS resolver..."
    
    local unbound_conf="$UNBOUND_CONFIG_DIR/unbound.conf"
    
    # Main unbound configuration
    cat > "$unbound_conf" << EOF
# Unbound DNS resolver configuration
# Optimized for developer workstations with security focus

server:
    # Network configuration
    interface: 127.0.0.1@${UNBOUND_PORT}
    interface: ::1@${UNBOUND_PORT}
    
    # Only allow local access
    access-control: 127.0.0.0/8 allow
    access-control: ::1 allow
    access-control: 0.0.0.0/0 refuse
    access-control: ::/0 refuse
    
    # Performance settings
    num-threads: 2
    msg-cache-slabs: 2
    rrset-cache-slabs: 2
    infra-cache-slabs: 2
    key-cache-slabs: 2
    
    # Cache settings (optimal for development)
    cache-min-ttl: 60
    cache-max-ttl: 86400
    msg-cache-size: 64m
    rrset-cache-size: 128m
    
    # Security settings
    hide-identity: yes
    hide-version: yes
    hide-trustanchor: yes
    harden-glue: yes
    harden-dnssec-stripped: yes
    harden-below-nxdomain: yes
    harden-referral-path: yes
    harden-algo-downgrade: yes
    harden-large-queries: yes
    harden-short-bufsize: yes
    
    # Privacy settings
    qname-minimisation: yes
    qname-minimisation-strict: yes
    aggressive-nsec: yes
    
    # DNSSEC validation
    auto-trust-anchor-file: "/var/lib/unbound/root.key"
    trust-anchor-signaling: yes
    root-key-sentinel: yes
    
    # Performance optimizations
    prefetch: yes
    prefetch-key: yes
    serve-expired: yes
    serve-expired-ttl: 3600
    
    # TLS configuration
    tls-cert-bundle: /etc/ssl/certs/ca-certificates.crt
    
    # Logging (for development/debugging)
    verbosity: 1
    log-queries: no
    log-replies: no
    
    # Local development settings
    do-not-query-localhost: no
    domain-insecure: "localhost"
    private-address: 127.0.0.0/8
    private-address: 10.0.0.0/8
    private-address: 172.16.0.0/12
    private-address: 192.168.0.0/16
    private-address: fd00::/8
    private-address: fe80::/10

# Remote control (for unbound-control)
remote-control:
    control-enable: yes
    control-interface: 127.0.0.1
    control-port: 8953

# Forward all queries to secure DNS servers with DoT
forward-zone:
    name: "."
    forward-tls-upstream: yes
EOF

    # Add forward addresses for secure DNS servers
    for server in "${SECURE_DNS_SERVERS[@]}"; do
        echo "    forward-addr: $server" >> "$unbound_conf"
    done
    
    # Create unbound control keys directory
    mkdir -p "$UNBOUND_CONFIG_DIR/unbound_control.d"
    
    # Create local configuration directory for custom zones
    cat > "$UNBOUND_CONFIG_DIR/unbound.conf.d/local.conf" << 'EOF'
# Local DNS configuration
# Add custom zones and overrides here

# Example local development zone:
# local-zone: "dev.local" static
# local-data: "app.dev.local A 127.0.0.1"

# Block known malicious domains (uncomment to enable)
# include: /etc/unbound/unbound.conf.d/blocklist.conf
EOF

    # Set proper permissions
    chmod 644 "$unbound_conf"
    chmod 644 "$UNBOUND_CONFIG_DIR/unbound.conf.d/local.conf"
    chmod 755 "$UNBOUND_CONFIG_DIR/unbound_control.d"
    
    # Verify configuration was created
    if [[ ! -s "$unbound_conf" ]]; then
        output "ERROR: Unbound configuration is empty"
        return 1
    fi
    
    if ! grep -q "forward-tls-upstream: yes" "$unbound_conf"; then
        output "ERROR: Unbound configuration missing DoT setup"
        return 1
    fi
    
    output "  ✓ Unbound configured on port $UNBOUND_PORT"
    output "  ✓ DNS-over-TLS forwarding to secure resolvers"
    output "  ✓ DNSSEC validation enabled"
    output "  ✓ Privacy and security optimizations applied"
    return 0
}

# =====================================
# SYSTEMD-RESOLVED INTEGRATION
# =====================================

configure_systemd_resolved() {
    output "Step 2/4: Configuring systemd-resolved integration..."
    
    local resolved_conf="$SYSTEMD_RESOLVED_CONFIG_DIR/unbound-integration.conf"
    
    # Configure systemd-resolved to use unbound as upstream
    cat > "$resolved_conf" << EOF
# systemd-resolved configuration for unbound integration
# systemd-resolved acts as a proxy to unbound for better integration

[Resolve]
# Use unbound as upstream DNS server
DNS=127.0.0.1:${UNBOUND_PORT}

# Fallback to secure public DNS if unbound fails
FallbackDNS=1.1.1.2#security.cloudflare-dns.com 9.9.9.9#dns.quad9.net

# Enable DNS over TLS (unbound handles this)
DNSOverTLS=no

# Let unbound handle DNSSEC
DNSSEC=no

# Disable conflicting features (unbound handles these)
MulticastDNS=no
LLMNR=no

# Cache settings (minimal since unbound does the heavy caching)
Cache=yes
CacheFromLocalhost=no

# DNS stub listener configuration
DNSStubListener=yes
DNSStubListenerExtra=

# Read system hosts file
ReadEtcHosts=yes

# Don't resolve single-label names over DNS
ResolveUnicastSingleLabel=no
EOF

    # Create backup resolv.conf configuration
    cat > "/mnt/etc/systemd/resolved.conf.d/backup-dns.conf" << 'EOF'
# Backup DNS configuration
# This file provides fallback DNS configuration if unbound fails

[Resolve]
# These settings are only used if the primary DNS configuration fails
# They are overridden by unbound-integration.conf when unbound is running

# Backup secure DNS servers
#FallbackDNS=1.1.1.1#cloudflare-dns.com 9.9.9.9#dns.quad9.net
EOF

    # Verify configuration was created
    if [[ ! -s "$resolved_conf" ]]; then
        output "ERROR: systemd-resolved configuration is empty"
        return 1
    fi
    
    if ! grep -q "DNS=127.0.0.1:${UNBOUND_PORT}" "$resolved_conf"; then
        output "ERROR: systemd-resolved not configured to use unbound"
        return 1
    fi
    
    output "  ✓ systemd-resolved configured to use unbound upstream"
    output "  ✓ Fallback DNS servers configured"
    output "  ✓ Integration settings optimized"
    return 0
}

# =====================================
# NETWORKMANAGER CONFIGURATION
# =====================================

configure_networkmanager() {
    output "Step 3/4: Configuring NetworkManager security and privacy..."
    
    # Main NetworkManager configuration
    cat > "$NETWORKMANAGER_CONFIG_DIR/security.conf" << 'EOF'
# NetworkManager security and privacy configuration

[main]
# Use systemd-resolved for DNS (which uses unbound)
dns=systemd-resolved

# Don't send hostname to DHCP servers
hostname-mode=none

# Security settings
dhcp=internal

[device]
# WiFi privacy settings
wifi.scan-rand-mac-address=yes
wifi.cloned-mac-address=stable-ssid

# Ethernet privacy settings  
ethernet.cloned-mac-address=stable

[connection]
# Connection-specific privacy settings
connection.stable-id=${CONNECTION}/${BOOT}

# IPv6 privacy extensions
ipv6.ip6-privacy=2

# Don't leak DNS queries during connection setup
connection.mdns=no
connection.llmnr=no
EOF

    # Advanced connection security
    cat > "$NETWORKMANAGER_CONFIG_DIR/connection-security.conf" << 'EOF'
# Advanced connection security settings

[connection-security]
# Additional security for untrusted networks

[device-security]
# Device-level security settings

# Disable wake-on-lan by default (security)
ethernet.wake-on-lan=ignore

# WiFi security settings
wifi.wake-on-wlan=ignore
wifi.powersave=default

[logging]
# Security-relevant logging
level=INFO
domains=DEVICE,WIFI,DHCP4,DHCP6,DNS
EOF

    # WiFi-specific security configuration
    cat > "$NETWORKMANAGER_CONFIG_DIR/wifi-security.conf" << 'EOF'
# WiFi-specific security configuration

[device-wifi-security]
# WiFi scanning and connection security

# Randomize MAC during scans
wifi.scan-rand-mac-address=yes

# Use random MAC for connections
wifi.cloned-mac-address=random

# Disable MAC address randomization for trusted networks (uncomment if needed)
# wifi.cloned-mac-address=preserve

[connection-wifi-security]
# Connection-specific WiFi security

# Prefer secure connection methods
wifi-sec.key-mgmt=wpa-psk,wpa-eap,sae

# Disable legacy security
wifi-sec.proto=rsn
wifi-sec.pairwise=ccmp
wifi-sec.group=ccmp
EOF

    # Set proper permissions
    chmod 644 "$NETWORKMANAGER_CONFIG_DIR"/*.conf
    
    # Verify NetworkManager configuration
    if [[ ! -f "$NETWORKMANAGER_CONFIG_DIR/security.conf" ]]; then
        output "ERROR: NetworkManager security configuration not created"
        return 1
    fi
    
    if ! grep -q "dns=systemd-resolved" "$NETWORKMANAGER_CONFIG_DIR/security.conf"; then
        output "ERROR: NetworkManager not configured for systemd-resolved"
        return 1
    fi
    
    output "  ✓ NetworkManager configured for systemd-resolved integration"
    output "  ✓ MAC address randomization enabled"
    output "  ✓ Privacy and security settings applied"
    output "  ✓ WiFi security hardening configured"
    return 0
}

# =====================================
# NETWORK SECURITY INTEGRATION
# =====================================

integrate_network_security() {
    output "Step 4/4: Integrating with system security configuration..."
    
    # Create network security monitoring script
    cat > "/mnt/usr/local/bin/network-security-check" << 'EOF'
#!/usr/bin/env bash
# Network security status checker

set -euo pipefail

check_dns_resolution() {
    echo "=== DNS Resolution Test ==="
    
    # Test systemd-resolved
    if systemctl is-active systemd-resolved >/dev/null 2>&1; then
        echo "✓ systemd-resolved is running"
    else
        echo "✗ systemd-resolved is not running"
        return 1
    fi
    
    # Test unbound
    if systemctl is-active unbound >/dev/null 2>&1; then
        echo "✓ unbound is running"
    else
        echo "✗ unbound is not running"
        return 1
    fi
    
    # Test DNS resolution
    if nslookup cloudflare.com >/dev/null 2>&1; then
        echo "✓ DNS resolution working"
    else
        echo "✗ DNS resolution failed"
        return 1
    fi
    
    # Test DoT functionality
    if unbound-control status >/dev/null 2>&1; then
        echo "✓ Unbound control interface working"
    else
        echo "✗ Unbound control interface failed"
    fi
}

check_network_privacy() {
    echo "=== Network Privacy Status ==="
    
    # Check MAC randomization
    local wifi_devices
    wifi_devices=$(nmcli device | grep wifi | awk '{print $1}' || echo "")
    
    if [[ -n "$wifi_devices" ]]; then
        for device in $wifi_devices; do
            local mac_setting
            mac_setting=$(nmcli -t -f 802-11-wireless.cloned-mac-address device show "$device" 2>/dev/null || echo "unknown")
            echo "WiFi device $device MAC setting: $mac_setting"
        done
    else
        echo "No WiFi devices found"
    fi
}

check_dns_security() {
    echo "=== DNS Security Status ==="
    
    # Check DNSSEC
    if dig +dnssec cloudflare.com | grep -q "ad" 2>/dev/null; then
        echo "✓ DNSSEC validation working"
    else
        echo "? DNSSEC status unclear"
    fi
    
    # Check DoT
    local unbound_stats
    unbound_stats=$(unbound-control stats 2>/dev/null || echo "unavailable")
    if [[ "$unbound_stats" != "unavailable" ]]; then
        echo "✓ Unbound statistics available"
        echo "  $(echo "$unbound_stats" | grep "num.query.tls" || echo "TLS query count: unknown")"
    else
        echo "? Unbound statistics unavailable"
    fi
}

main() {
    echo "Network Security Status Check"
    echo "============================="
    echo
    
    check_dns_resolution
    echo
    check_network_privacy  
    echo
    check_dns_security
    echo
    echo "Check complete."
}

main "$@"
EOF

    # Make the script executable
    chmod 755 "/mnt/usr/local/bin/network-security-check"
    
    # Create network monitoring configuration for systemd
    cat > "/mnt/etc/systemd/system/network-security-monitor.service" << 'EOF'
[Unit]
Description=Network Security Monitoring
After=network-online.target unbound.service systemd-resolved.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/network-security-check
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
EOF

    # Create timer for periodic checks
    cat > "/mnt/etc/systemd/system/network-security-monitor.timer" << 'EOF'
[Unit]
Description=Periodic Network Security Check
Requires=network-security-monitor.service

[Timer]
OnBootSec=5min
OnUnitActiveSec=1h
Persistent=true

[Install]
WantedBy=timers.target
EOF

    # Verify integration files were created
    if [[ ! -x "/mnt/usr/local/bin/network-security-check" ]]; then
        output "ERROR: Network security check script not created"
        return 1
    fi
    
    output "  ✓ Network security monitoring script created"
    output "  ✓ Systemd monitoring service configured"
    output "  ✓ Security integration complete"
    return 0
}

# =====================================
# CONFIGURATION VALIDATION
# =====================================

validate_network_configuration() {
    output "Validating complete network configuration..."
    
    local validation_errors=0
    
    # Check unbound configuration
    if [[ ! -f "$UNBOUND_CONFIG_DIR/unbound.conf" ]]; then
        output "ERROR: Unbound configuration missing"
        ((validation_errors++))
    elif ! grep -q "forward-tls-upstream: yes" "$UNBOUND_CONFIG_DIR/unbound.conf"; then
        output "ERROR: Unbound DoT configuration invalid"
        ((validation_errors++))
    else
        output "  ✓ Unbound configuration validated"
    fi
    
    # Check systemd-resolved configuration
    if [[ ! -f "$SYSTEMD_RESOLVED_CONFIG_DIR/unbound-integration.conf" ]]; then
        output "ERROR: systemd-resolved integration missing"
        ((validation_errors++))
    elif ! grep -q "DNS=127.0.0.1:$UNBOUND_PORT" "$SYSTEMD_RESOLVED_CONFIG_DIR/unbound-integration.conf"; then
        output "ERROR: systemd-resolved unbound integration invalid"
        ((validation_errors++))
    else
        output "  ✓ systemd-resolved integration validated"
    fi
    
    # Check NetworkManager configuration
    if [[ ! -f "$NETWORKMANAGER_CONFIG_DIR/security.conf" ]]; then
        output "ERROR: NetworkManager security configuration missing"
        ((validation_errors++))
    elif ! grep -q "dns=systemd-resolved" "$NETWORKMANAGER_CONFIG_DIR/security.conf"; then
        output "ERROR: NetworkManager systemd-resolved integration invalid"
        ((validation_errors++))
    else
        output "  ✓ NetworkManager configuration validated"
    fi
    
    # Check monitoring integration
    if [[ ! -x "/mnt/usr/local/bin/network-security-check" ]]; then
        output "ERROR: Network security monitoring missing"
        ((validation_errors++))
    else
        output "  ✓ Network security monitoring validated"
    fi
    
    if [[ $validation_errors -gt 0 ]]; then
        output "ERROR: $validation_errors network configuration failures"
        return 1
    fi
    
    output "All network configurations validated successfully"
    return 0
}

