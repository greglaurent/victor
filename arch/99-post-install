#!/usr/bin/env bash

# arch/99-post-install
# Final installation validation, cleanup, and preparation

set -euo pipefail

# Source echo function and ensure required variables

# Ensure required variables are defined
username=${username:-\"\"}
HERE=${HERE:-\"\"}

# Validate required variables
if [[ -z \"$username\" ]]; then
    echo \"ERROR: Username variable not set. This script requires username to be defined.\"
    exit 1
fi

if [[ -z \"$HERE\" ]]; then
    echo \"ERROR: HERE variable not set. This script requires HERE to be defined.\"
    exit 1
fi

# =====================================
# INSTALLATION VALIDATION CONSTANTS
# =====================================

readonly CRITICAL_FILES=(
    "/mnt/etc/fstab"
    "/mnt/etc/hostname"
    "/mnt/etc/hosts"
    "/mnt/etc/passwd"
    "/mnt/etc/group"
    "/mnt/etc/sudoers"
    "/mnt/boot/limine.cfg"
    "/mnt/etc/mkinitcpio.conf"
)

readonly SECURITY_FILES=(
    "/mnt/etc/sysctl.d/99-developer-workstation.conf"
    "/mnt/etc/ssh/sshd_config.d/10-security.conf"
    "/mnt/etc/apparmor.d/local"
    "/mnt/etc/fail2ban/jail.d/sshd.local"
)

readonly NETWORK_FILES=(
    "/mnt/etc/unbound/unbound.conf"
    "/mnt/etc/systemd/resolved.conf.d/unbound-integration.conf"
    "/mnt/etc/NetworkManager/conf.d/security.conf"
)

readonly REQUIRED_SERVICES=(
    "systemd-resolved"
    "NetworkManager"
    "chronyd"
    "apparmor"
    "unbound"
    "sshd"
    "fail2ban"
)

# =====================================
# COMPREHENSIVE SYSTEM VALIDATION
# =====================================

validate_critical_files() {
    echo "Step 1/6: Validating critical system files..."
    
    local missing_files=()
    local empty_files=()
    
    for file in "${CRITICAL_FILES[@]}"; do
        if [[ ! -f "$file" ]]; then
            missing_files+=("$file")
        elif [[ ! -s "$file" ]]; then
            empty_files+=("$file")
        fi
    done
    
    if [[ ${#missing_files[@]} -gt 0 ]]; then
        echo "ERROR: Critical files missing:"
        printf '  %s\n' "${missing_files[@]}"
        return 1
    fi
    
    if [[ ${#empty_files[@]} -gt 0 ]]; then
        echo "ERROR: Critical files are empty:"
        printf '  %s\n' "${empty_files[@]}"
        return 1
    fi
    
    echo "  ✓ All critical system files present and non-empty"
    return 0
}

validate_security_configuration() {
    echo "Step 2/6: Validating security configuration..."
    
    local validation_errors=0
    
    # Check security files exist
    for file in "${SECURITY_FILES[@]}"; do
        if [[ ! -e "$file" ]]; then
            echo "ERROR: Security file missing: $file"
            ((validation_errors++))
        fi
    done
    
    # Validate sysctl configuration
    if [[ -f "/mnt/etc/sysctl.d/99-developer-workstation.conf" ]]; then
        if ! grep -q "kernel.yama.ptrace_scope = 1" "/mnt/etc/sysctl.d/99-developer-workstation.conf"; then
            echo "ERROR: sysctl security configuration invalid"
            ((validation_errors++))
        fi
    fi
    
    # Validate SSH security
    if [[ -f "/mnt/etc/ssh/sshd_config.d/10-security.conf" ]]; then
        if ! grep -q "AuthenticationMethods publickey" "/mnt/etc/ssh/sshd_config.d/10-security.conf"; then
            echo "ERROR: SSH security configuration invalid"
            ((validation_errors++))
        fi
    fi
    
    # Validate AppArmor structure
    if [[ ! -d "/mnt/etc/apparmor.d/local" ]]; then
        echo "ERROR: AppArmor directory structure missing"
        ((validation_errors++))
    fi
    
    if [[ $validation_errors -eq 0 ]]; then
        echo "  ✓ Security configuration validated"
        return 0
    else
        echo "ERROR: $validation_errors security validation failures"
        return 1
    fi
}

validate_network_stack() {
    echo "Step 3/6: Validating network stack integration..."
    
    local network_errors=0
    
    # Check network configuration files
    for file in "${NETWORK_FILES[@]}"; do
        if [[ ! -f "$file" ]]; then
            echo "ERROR: Network file missing: $file"
            ((network_errors++))
        fi
    done
    
    # Validate unbound configuration
    if [[ -f "/mnt/etc/unbound/unbound.conf" ]]; then
        if ! grep -q "forward-tls-upstream: yes" "/mnt/etc/unbound/unbound.conf"; then
            echo "ERROR: Unbound DoT configuration missing"
            ((network_errors++))
        fi
    fi
    
    # Validate systemd-resolved integration
    if [[ -f "/mnt/etc/systemd/resolved.conf.d/unbound-integration.conf" ]]; then
        if ! grep -q "DNS=127.0.0.1:5353" "/mnt/etc/systemd/resolved.conf.d/unbound-integration.conf"; then
            echo "ERROR: systemd-resolved integration invalid"
            ((network_errors++))
        fi
    fi
    
    # Validate NetworkManager integration
    if [[ -f "/mnt/etc/NetworkManager/conf.d/security.conf" ]]; then
        if ! grep -q "dns=systemd-resolved" "/mnt/etc/NetworkManager/conf.d/security.conf"; then
            echo "ERROR: NetworkManager DNS integration invalid"
            ((network_errors++))
        fi
    fi
    
    # Validate DNS resolution chain configuration
    local resolv_conf_target
    resolv_conf_target=$(readlink /mnt/etc/resolv.conf 2>/dev/null || echo "missing")
    if [[ "$resolv_conf_target" != "/run/systemd/resolve/stub-resolv.conf" ]]; then
        echo "ERROR: DNS resolution chain not configured correctly"
        ((network_errors++))
    fi
    
    if [[ $network_errors -eq 0 ]]; then
        echo "  ✓ Network stack integration validated"
        echo "    DNS chain: Applications → systemd-resolved → unbound → secure DNS"
        return 0
    else
        echo "ERROR: $network_errors network validation failures"
        return 1
    fi
}

validate_bootloader_configuration() {
    echo "Step 4/6: Validating bootloader configuration..."
    
    # Check Limine configuration exists
    if [[ ! -f "/mnt/boot/limine.cfg" ]]; then
        echo "ERROR: Limine configuration missing"
        return 1
    fi
    
    # Validate required boot entries
    local required_entries=("Arch Linux" "Arch Linux LTS" "Recovery")
    local missing_entries=()
    
    for entry in "${required_entries[@]}"; do
        if ! grep -q ":.*$entry" "/mnt/boot/limine.cfg"; then
            missing_entries+=("$entry")
        fi
    done
    
    if [[ ${#missing_entries[@]} -gt 0 ]]; then
        echo "ERROR: Missing boot entries: ${missing_entries[*]}"
        return 1
    fi
    
    # Validate kernel files exist
    local kernel_files=(
        "/mnt/boot/vmlinuz-linux"
        "/mnt/boot/vmlinuz-linux-lts"
        "/mnt/boot/initramfs-linux.img"
        "/mnt/boot/initramfs-linux-lts.img"
    )
    
    for file in "${kernel_files[@]}"; do
        if [[ ! -f "$file" ]]; then
            echo "ERROR: Kernel file missing: $file"
            return 1
        fi
    done
    
    # Check Limine bootloader installation
    if [[ ! -f "/mnt/boot/efi/EFI/BOOT/BOOTX64.EFI" ]]; then
        echo "ERROR: Limine UEFI bootloader not installed"
        return 1
    fi
    
    echo "  ✓ Bootloader configuration validated"
    echo "    Limine installed with UEFI + BIOS compatibility"
    return 0
}

validate_service_integration() {
    echo "Step 5/6: Validating service integration..."
    
    local service_errors=0
    
    # Check required services are enabled
    for service in "${REQUIRED_SERVICES[@]}"; do
        if ! systemctl is-enabled "$service" --root=/mnt &>/dev/null; then
            echo "ERROR: Required service not enabled: $service"
            ((service_errors++))
        fi
    done
    
    # Validate service integration chains
    
    # DNS resolution chain
    if systemctl is-enabled systemd-resolved --root=/mnt &>/dev/null && \
       systemctl is-enabled unbound --root=/mnt &>/dev/null; then
        echo "  ✓ DNS resolution chain: systemd-resolved ↔ unbound"
    else
        echo "ERROR: DNS resolution chain broken"
        ((service_errors++))
    fi
    
    # Security integration
    if systemctl is-enabled apparmor --root=/mnt &>/dev/null && \
       systemctl is-enabled auditd --root=/mnt &>/dev/null; then
        echo "  ✓ Security integration: AppArmor + audit logging"
    else
        echo "WARNING: Security audit integration incomplete"
    fi
    
    # Network security
    if systemctl is-enabled NetworkManager --root=/mnt &>/dev/null && \
       systemctl is-enabled fail2ban --root=/mnt &>/dev/null; then
        echo "  ✓ Network security: NetworkManager + fail2ban"
    else
        echo "ERROR: Network security integration incomplete"
        ((service_errors++))
    fi
    
    if [[ $service_errors -eq 0 ]]; then
        echo "  ✓ Service integration validated"
        return 0
    else
        echo "ERROR: $service_errors service integration failures"
        return 1
    fi
}

validate_user_configuration() {
    echo "Step 6/6: Validating user configuration..."
    
    # Check user account exists
    if ! grep -q "^$username:" /mnt/etc/passwd; then
        echo "ERROR: User account not found: ${username}"
        return 1
    fi
    
    # Check user home directory
    if [[ ! -d "/mnt/home/${username}" ]]; then
        echo "ERROR: User home directory missing: /home/${username}"
        return 1
    fi
    
    # Check user is in wheel group
    if ! grep -q "^wheel:.*${username}" /mnt/etc/group; then
        echo "ERROR: User not in wheel group: ${username}"
        return 1
    fi
    
    # Check sudo configuration
    if ! grep -q "^%wheel ALL=(ALL:ALL) ALL" /mnt/etc/sudoers; then
        echo "ERROR: Sudo configuration for wheel group missing"
        return 1
    fi
    
    echo "  ✓ User configuration validated"
    echo "    User: ${username} with sudo access"
    return 0
}

# =====================================
# INTEGRATION TESTING
# =====================================

test_system_integration() {
    echo ""
    echo "=== Integration Testing ==="
    
    # Test configuration file consistency
    echo "Testing configuration consistency..."
    
    # Check for conflicting DNS configurations
    local dns_configs_count=0
    [[ -f "/mnt/etc/systemd/resolved.conf.d/unbound-integration.conf" ]] && ((dns_configs_count++))
    [[ -f "/mnt/etc/unbound/unbound.conf" ]] && ((dns_configs_count++))
    
    if [[ $dns_configs_count -eq 2 ]]; then
        echo "  ✓ DNS configuration stack complete"
    else
        echo "  ⚠ DNS configuration incomplete ($dns_configs_count/2 components)"
    fi
    
    # Test security configuration completeness
    local security_configs_count=0
    [[ -f "/mnt/etc/sysctl.d/99-developer-workstation.conf" ]] && ((security_configs_count++))
    [[ -d "/mnt/etc/apparmor.d/local" ]] && ((security_configs_count++))
    [[ -f "/mnt/etc/ssh/sshd_config.d/10-security.conf" ]] && ((security_configs_count++))
    [[ -f "/mnt/etc/fail2ban/jail.d/sshd.local" ]] && ((security_configs_count++))
    
    echo "  ✓ Security configuration: $security_configs_count/4 components configured"
    
    # Check for configuration conflicts
    local conflicts=0
    
    # Check for timesyncd vs chronyd conflict
    if systemctl is-enabled systemd-timesyncd --root=/mnt &>/dev/null && \
       systemctl is-enabled chronyd --root=/mnt &>/dev/null; then
        echo "  ⚠ Time sync conflict: both systemd-timesyncd and chronyd enabled"
        ((conflicts++))
    fi
    
    if [[ $conflicts -eq 0 ]]; then
        echo "  ✓ No configuration conflicts detected"
    else
        echo "  ⚠ $conflicts configuration conflicts detected"
    fi
    
    echo "Integration testing complete"
    return 0
}

# =====================================
# VICTOR TOOLS PREPARATION
# =====================================

prepare_victor_integration() {
    echo ""
    echo "=== Preparing Victor Tools Integration ==="
    
    # Create target directories
    local victor_target="/mnt/home/$username/Workspace/victor"
    local victor_bin="/mnt/usr/local/bin"
    
    echo "Creating Victor directory structure..."
    mkdir -p "$victor_target"
    mkdir -p "$victor_bin"
    
    # Copy Victor tools to target system
    echo "Installing Victor tools..."
    
    # Copy main Victor structure (excluding repos and temporary files)
    if ! cp -r "$HERE"/{utils,vic,setup,install,run,arch} "$victor_target/" 2>/dev/null; then
        echo "ERROR: Failed to copy Victor tools"
        return 1
    fi
    
    # Create symlink for system-wide access
    if ! ln -sf "$victor_target/vic" "$victor_bin/vic"; then
        echo "ERROR: Failed to create Victor symlink"
        return 1
    fi
    
    # Set proper ownership
    arch-chroot /mnt chown -R "${username}:${username}" "/home/${username}/Workspace"
    
    # Make Victor executable
    chmod +x "$victor_target/vic"
    chmod +x "$victor_target/utils"
    find "$victor_target" -name "*.sh" -exec chmod +x {} \; 2>/dev/null || true
    find "$victor_target" -path "*/run/*" -type f -exec chmod +x {} \; 2>/dev/null || true
    find "$victor_target" -path "*/setup/*" -type f -exec chmod +x {} \; 2>/dev/null || true
    find "$victor_target" -path "*/install/*" -type f -exec chmod +x {} \; 2>/dev/null || true
    
    # Verify Victor installation
    if [[ ! -f "$victor_bin/vic" ]] || [[ ! -x "$victor_target/vic" ]]; then
        echo "ERROR: Victor installation verification failed"
        return 1
    fi
    
    echo "  ✓ Victor tools installed to $victor_target"
    echo "  ✓ System-wide access via: vic"
    echo "  ✓ User ownership configured"
    return 0
}

# =====================================
# SECURITY HARDENING FINALIZATION
# =====================================

finalize_security_hardening() {
    echo ""
    echo "=== Finalizing Security Hardening ==="
    
    echo "Setting final security permissions..."
    
    # SSH key permissions
    find /mnt/etc/ssh -name "ssh_host_*_key" -exec chmod 600 {} \; 2>/dev/null || true
    find /mnt/etc/ssh -name "ssh_host_*_key.pub" -exec chmod 644 {} \; 2>/dev/null || true
    
    # AppArmor permissions
    if [[ -d /mnt/etc/apparmor.d ]]; then
        find /mnt/etc/apparmor.d -type d -exec chmod 755 {} \;
        find /mnt/etc/apparmor.d -type f -exec chmod 644 {} \;
    fi
    
    # Audit configuration permissions
    if [[ -d /mnt/etc/audit ]]; then
        chmod 750 /mnt/etc/audit
        find /mnt/etc/audit -name "*.rules" -exec chmod 640 {} \; 2>/dev/null || true
    fi
    
    # Sudo configuration permissions
    if [[ -f /mnt/etc/sudoers.d/security ]]; then
        chmod 440 /mnt/etc/sudoers.d/security
    fi
    
    # Fail2ban configuration permissions
    if [[ -d /mnt/etc/fail2ban ]]; then
        find /mnt/etc/fail2ban -type f -exec chmod 644 {} \;
    fi
    
    # Create security monitoring preparation file
    cat > "/mnt/etc/security-deployment.conf" << EOF
# Security Deployment Configuration
# This file tracks security framework deployment status

SECURITY_FRAMEWORK_VERSION="1.0"
INSTALLATION_DATE="$(date -Iseconds)"
APPARMOR_PROFILES_DEPLOYED="false"
SECURITY_MONITORING_ENABLED="false"
FIREWALL_CONFIGURED="false"

# Next steps for security deployment:
# 1. Deploy AppArmor profiles: vic setup security apparmor
# 2. Configure firewall: ufw allow ssh && ufw enable  
# 3. Enable monitoring: systemctl enable --now network-security-monitor.timer
# 4. Check status: vic run system security-status
EOF
    
    chmod 644 /mnt/etc/security-deployment.conf
    
    echo "  ✓ Security permissions finalized"
    echo "  ✓ Security deployment tracking configured"
    return 0
}

# =====================================
# INSTALLATION CLEANUP
# =====================================

cleanup_installation_artifacts() {
    echo ""
    echo "=== Cleaning Up Installation Artifacts ==="
    
    echo "Cleaning temporary files..."
    
    # Clean package cache (keep recent packages)
    if ! arch-chroot /mnt pacman -Sc --noconfirm; then
        echo "WARNING: Package cache cleanup failed"
    fi
    
    # Remove temporary installation files
    rm -f /mnt/tmp/fstab.* 2>/dev/null || true
    rm -f /mnt/*.backup 2>/dev/null || true
    
    # Clean systemd journal space
    arch-chroot /mnt journalctl --vacuum-size=100M 2>/dev/null || true
    
    # Update package database
    arch-chroot /mnt pacman -Sy --noconfirm || true
    
    # Update locate database
    if command -v updatedb &>/dev/null; then
        arch-chroot /mnt updatedb 2>/dev/null || true
    fi
    
    echo "  ✓ Temporary files cleaned"
    echo "  ✓ Package cache optimized"
    echo "  ✓ System databases updated"
    return 0
}

