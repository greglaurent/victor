# /etc/fstab: static file system information
#
# Generated by Victor Arch Linux installer
# 
# <device>                                 <dir> <type> <options> <dump> <fsck>

# Root filesystem (BTRFS)
__ROOT_DEVICE__                            /     btrfs  rw,relatime,compress=zstd:3,ssd,discard=async,space_cache=v2,subvol=@ 0 0

# Home subvolume
__ROOT_DEVICE__                            /home btrfs  rw,relatime,compress=zstd:3,ssd,discard=async,space_cache=v2,subvol=@home 0 0

# Var/log subvolume
__ROOT_DEVICE__                            /var/log btrfs rw,relatime,compress=zstd:3,ssd,discard=async,space_cache=v2,subvol=@var_log 0 0

# Snapshots subvolume
__ROOT_DEVICE__                            /.snapshots btrfs rw,relatime,compress=zstd:3,ssd,discard=async,space_cache=v2,subvol=@snapshots 0 0

# Swap subvolume
__ROOT_DEVICE__                            /swap btrfs  rw,relatime,ssd,discard=async,space_cache=v2,subvol=@swap 0 0

# ESP partition
UUID=__ESP_UUID__                          /boot/efi vfat rw,relatime,fmask=0022,dmask=0022,codepage=437,iocharset=ascii,shortname=mixed,utf8,errors=remount-ro 0 2