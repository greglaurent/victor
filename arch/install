#!/usr/bin/env bash

set -euo pipefail

# Installation logging and error handling
INSTALL_LOG="/tmp/arch-install-$(date +%Y%m%d-%H%M%S).log"
exec 1> >(tee -a "$INSTALL_LOG")
exec 2> >(tee -a "$INSTALL_LOG" >&2)

# Error handler function
handle_installation_error() {
    local exit_code=$?
    local line_number=$1
    echo "" >&2
    echo "=======================================" >&2
    echo "INSTALLATION FAILED" >&2
    echo "=======================================" >&2
    echo "Error occurred at line $line_number with exit code $exit_code" >&2
    echo "Full installation log: $INSTALL_LOG" >&2
    echo "Progress file: $INSTALL_PROGRESS_FILE" >&2
    echo "" >&2
    echo "To resume installation after fixing the issue:" >&2
    echo "1. Fix the reported problem" >&2
    echo "2. Re-run this installer" >&2
    echo "3. It will continue from where it left off" >&2
    echo "=======================================" >&2
    exit $exit_code
}

# Set error trap for main installer
trap 'handle_installation_error $LINENO' ERR

# Installation start logging
echo "======================================="
echo "Arch Linux Installation Started"
echo "Date: $(date)"
echo "Log file: $INSTALL_LOG"
echo "======================================="

# =====================================
# INSTALLATION CONFIGURATION
# =====================================
readonly DEFAULT_LOCALE="en_US"
readonly DEFAULT_KBLAYOUT="us"
readonly DEFAULT_TIMEZONE="America/Los_Angeles"
readonly DEFAULT_INSTALL_MODE="desktop"
readonly SUPPORTED_LOCALES=("en_US" "en_GB" "de_DE" "fr_FR")
readonly SUPPORTED_KEYBOARDS=("us" "uk" "de" "fr")
readonly SUPPORTED_TIMEZONES=("America/Los_Angeles" "America/New_York" "America/Chicago" "America/Denver" "Europe/London" "Europe/Berlin" "Europe/Paris")

# =====================================
# ENVIRONMENT VARIABLE OVERRIDES
# =====================================
# Allow automation via environment variables
use_luks=${USE_LUKS:-0}
kblayout=${KBLAYOUT:-$DEFAULT_KBLAYOUT}
locale=${LOCALE:-$DEFAULT_LOCALE}
timezone=${TIMEZONE:-$DEFAULT_TIMEZONE}
install_mode=${INSTALL_MODE:-$DEFAULT_INSTALL_MODE}
hostname=""
username=${USERNAME:-""}
fullname=${FULLNAME:-""}
user_password=${USER_PASSWORD:-""}
luks_passphrase=${LUKS_PASSPHRASE:-""}

installation_date=$(date "+%Y-%m-%d %H:%M:%S")

# =====================================
# VICTOR TOOLS INTEGRATION
# =====================================
# Set up paths needed by installation scripts
if [[ -n "${HERE:-}" ]]; then
  # Running from Victor context
  export HERE
  export RESOURCES="${HERE}/setup/resources"
  export REPOS="${HERE}/repos"
else
  # Detect current directory context
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  if [[ -f "$SCRIPT_DIR/../vic" ]]; then
    # We're in arch/ subdirectory of Victor
    HERE="$(cd "$SCRIPT_DIR/.." && pwd)"
    export HERE
    export RESOURCES="${HERE}/setup/resources"
    export REPOS="${HERE}/repos"
  else
    # Standalone installation
    export HERE="$SCRIPT_DIR"
    export RESOURCES="$HERE/resources"
    export REPOS="$HERE/repos"
  fi
fi

# =====================================
# VALIDATION FUNCTIONS
# =====================================
validate_installation_environment() {
  echo "Validating installation environment..."

  # Check if running in live environment
  if [[ ! -d /run/archiso ]]; then
    echo "ERROR: This script must be run from an Arch Linux live environment"
    exit 1
  fi

  # Verify internet connectivity
  local connectivity_test_passed=false
  for test_site in archlinux.org google.com cloudflare.com; do
    if curl -s --connect-timeout 3 --max-time 5 -I "https://$test_site" >/dev/null 2>&1; then
      connectivity_test_passed=true
      break
    fi
  done
  
  if [[ "$connectivity_test_passed" == "false" ]]; then
    echo "ERROR: No internet connection detected"
    echo "Please configure networking before running the installation"
    exit 1
  fi

  # Check available disk space (minimum 20GB)
  local available_space
  available_space=$(df /tmp --output=avail -BG | tail -n1 | tr -d 'G')
  if [[ $available_space -lt 2 ]]; then
    echo "WARNING: Low disk space in live environment (${available_space}GB)"
    echo "Consider using a larger live USB or cleaning /tmp"
  fi

  # Validate working directory context
  if [[ ! -f "01-format-disks" ]] || [[ ! -f "99-post-install" ]]; then
    echo "ERROR: Installation scripts not found in current directory"
    echo "Please run this script from the arch/ directory"
    exit 1
  fi

  # Check for required Victor context files (if available)
  if [[ -n "${HERE:-}" ]] && [[ ! -f "${HERE}/vic" ]]; then
    echo "WARNING: Victor tools context not found at ${HERE}"
    echo "Post-installation Victor integration may not work correctly"
  fi

  echo "Installation environment validated"
}

validate_required_packages() {
  echo "Validating required packages availability..."

  # Update package database first
  pacman -Sy --noconfirm


  echo "Package database updated"
}

unpriv() {
  sudo -u nobody "${@}"
}

# No automatic cleanup - mounts need to persist between scripts

validate_hostname() {
  local hostname="$1"
  if [[ ! $hostname =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$ ]]; then
    echo "Invalid hostname format. Use alphanumeric characters and hyphens only."
    exit 1
  fi
  return 0
}

validate_username() {
  local username="$1"
  if [[ ! $username =~ ^[a-z_]([a-z0-9_-]{0,31}|[a-z0-9_-]{0,30}\$)$ ]]; then
    echo "Invalid username format. Use lowercase letters, numbers, underscore, and hyphen only."
    exit 1
  fi
  return 0
}

is_in_array() {
  local element="$1"
  shift
  local array=("$@")
  for item in "${array[@]}"; do
    [[ $item == "$element" ]] && return 0
  done
  exit 1
}

# =====================================
# INTERACTIVE PROMPTS
# =====================================
luks_passphrase_prompt() {
  if [[ $use_luks -eq 1 && -z $luks_passphrase ]]; then
    echo 'Enter your encryption passphrase (the passphrase will not be shown on the screen):'
    read -r -s luks_passphrase </dev/tty

    if [[ -z $luks_passphrase ]]; then
      echo 'To use encryption, you need to enter a passphrase.'
      luks_passphrase_prompt
      return
    fi

    echo 'Confirm your encryption passphrase (the passphrase will not be shown on the screen):'
    read -r -s luks_passphrase2 </dev/tty
    if [[ $luks_passphrase != "$luks_passphrase2" ]]; then
      echo 'Passphrases do not match, please try again.'
      luks_passphrase_prompt
      return
    fi
  fi
}

disk_prompt() {
  if [[ -n ${DISK:-} ]]; then
    disk="$DISK"
    echo "Using disk from environment: ${disk}"
    return
  fi

  echo "Available disks:"
  lsblk -d -o NAME,SIZE,TYPE,MODEL | grep -E "(nvme|sd|mmcblk|vd)" || {
    echo "No suitable disks found!"
    exit 1
  }

  echo 'Please select the disk for installation:'
  local disks=()
  while IFS= read -r line; do
    disks+=("$line")
  done < <(lsblk -dpnoNAME | grep -P "/dev/(nvme|sd|mmcblk|vd)")

  if [[ ${#disks[@]} -eq 0 ]]; then
    echo "No suitable disks found!"
    exit 1
  fi

  select entry in "${disks[@]}"; do
    if [[ -n $entry ]]; then
      disk="$entry"
      echo "Selected disk: ${disk}"

      # Confirmation for destructive operation
      echo "WARNING: This will DESTROY all data on ${disk}!"
      confirmation=""
      echo -n "Type 'YES' to continue: " >/dev/tty
      read -r confirmation </dev/tty
      if [[ $confirmation != "YES" ]]; then
        echo "Installation cancelled."
        exit 1
      fi
      break
    else
      echo "Invalid selection. Please try again."
    fi
  done
}

timezone_prompt() {
  if [[ -n $timezone && $timezone != "$DEFAULT_TIMEZONE" ]]; then
    echo "Using timezone from environment: ${timezone}"
    return
  fi

  echo 'Select timezone:'
  select tz in "${SUPPORTED_TIMEZONES[@]}" "Other"; do
    if [[ $tz == "Other" ]]; then
      echo 'Enter timezone (e.g., America/Chicago):'
      read -r custom_timezone </dev/tty
      if [[ -f /usr/share/zoneinfo/$custom_timezone ]]; then
        timezone="$custom_timezone"
        break
      else
        echo "Invalid timezone. Please try again."
      fi
    elif [[ -n $tz ]]; then
      timezone="$tz"
      break
    else
      echo "Invalid selection. Please try again."
    fi
  done
}

username_prompt() {
  if [[ -n $username ]]; then
    echo "Using username from environment: ${username}"
    return
  fi

  while true; do
    echo 'Please enter the username:'
    read -r username </dev/tty

    if [[ -z $username ]]; then
      echo 'You need to enter a username.'
      continue
    fi

    if validate_username "$username"; then
      break
    fi
  done
}

user_password_prompt() {
  if [[ -n $user_password ]]; then
    echo "Using password from environment variable."
    return
  fi

  while true; do
    echo 'Enter your user password (the password will not be shown on the screen):'
    read -r -s user_password </dev/tty

    if [[ -z $user_password ]]; then
      echo 'You need to enter a password.'
      continue
    fi

    echo 'Confirm your user password (the password will not be shown on the screen):'
    read -r -s user_password2 </dev/tty
    if [[ $user_password == "$user_password2" ]]; then
      break
    else
      echo 'Passwords do not match, please try again.'
    fi
  done
}

fullname_prompt() {
  if [[ -n $fullname ]]; then
    echo "Using full name from environment: ${fullname}"
    return
  fi

  while true; do
    echo 'Please enter the full name for the account:'
    read -r fullname </dev/tty

    if [[ -n $fullname ]]; then
      break
    else
      echo 'Please enter the full name for the account.'
    fi
  done
}

hostname_prompt() {
  while true; do
    echo 'Enter your hostname:'
    read -r hostname </dev/tty

    if [[ -z $hostname ]]; then
      echo 'You need to enter a hostname.'
      continue
    fi

    if validate_hostname "$hostname"; then
      break
    fi
  done
}

locale_prompt() {
  if [[ -n $locale && $locale != "$DEFAULT_LOCALE" ]]; then
    echo "Using locale from environment: ${locale}"
    return
  fi

  echo 'Select system locale:'
  select loc in "${SUPPORTED_LOCALES[@]}"; do
    if [[ -n $loc ]]; then
      locale="$loc"
      echo "Selected locale: ${locale}"
      break
    else
      echo "Invalid selection. Please try again."
    fi
  done
}

keyboard_prompt() {
  if [[ -n $kblayout && $kblayout != "$DEFAULT_KBLAYOUT" ]]; then
    echo "Using keyboard layout from environment: ${kblayout}"
    return
  fi

  echo 'Select keyboard layout:'
  select kb in "${SUPPORTED_KEYBOARDS[@]}"; do
    if [[ -n $kb ]]; then
      kblayout="$kb"
      echo "Selected keyboard layout: ${kblayout}"
      break
    else
      echo "Invalid selection. Please try again."
    fi
  done
}

encryption_prompt() {
  if [[ -n ${USE_LUKS:-} ]]; then
    echo "Using encryption setting from environment: $([[ $use_luks -eq 1 ]] && echo "enabled" || echo "disabled")"
    return
  fi

  echo 'Enable disk encryption? (y/N)'
  read -r response </dev/tty
  case "$response" in
  [yY][eE][sS] | [yY])
    use_luks=1
    echo "Disk encryption enabled."
    ;;
  *)
    use_luks=0
    echo "Disk encryption disabled."
    ;;
  esac
}

# =====================================
# MAIN INSTALLATION FLOW
# =====================================

# Clear the TTY
clear

echo "=== Victor Arch Linux Installation ==="
echo "Installation mode: ${install_mode}"
echo "Date: ${installation_date}"
echo

# Check if running in live environment
if [[ ! -d /run/archiso ]]; then
  echo "This script must be run from an Arch Linux live environment."
  exit 1
fi

# Verify internet connectivity
connectivity_test_passed=false
for test_site in archlinux.org google.com cloudflare.com; do
  if curl -s --connect-timeout 3 --max-time 5 -I "https://$test_site" >/dev/null 2>&1; then
    connectivity_test_passed=true
    break
  fi
done

if [[ "$connectivity_test_passed" == "false" ]]; then
  echo "No internet connection detected. Please configure networking first."
  exit 1
fi

# Interactive prompts (skip if environment variables are set)
encryption_prompt
luks_passphrase_prompt
disk_prompt
hostname_prompt
username_prompt
fullname_prompt
user_password_prompt
locale_prompt
keyboard_prompt
timezone_prompt

# Display configuration summary
echo ""
echo "=== Installation Configuration ==="
echo "Disk: ${disk}"
echo "Hostname: ${hostname}"
echo "Username: ${username}"
echo "Full name: ${fullname}"
echo "Locale: ${locale}"
echo "Keyboard: ${kblayout}"
echo "Timezone: ${timezone}"
echo "Install mode: ${install_mode}"
echo ""

confirm=""
echo -n "Proceed with installation? (y/N): " >/dev/tty
read -r confirm </dev/tty
echo ""
if [[ $confirm != [yY] ]]; then
  echo "Installation cancelled."
  exit 0
fi

echo ""
# Export all variables that child scripts need
echo "Preparing installation variables..."
export use_luks
export luks_passphrase
export disk
export hostname
export locale
export kblayout
export timezone
export username
export fullname
export user_password
export install_mode
export installation_date
export HERE
echo "Variables exported successfully."

# Installation steps with error handling
installation_steps=(
    "01-format-disks:Format and partition disk"
    "02-pacstrap-system:Install base system"
    "03-generate-fstab:Generate filesystem table"
    "04-set-locale:Configure system locale"
    "05-config-limine:Configure bootloader"
    "06-config-security:Apply security hardening"
    "07-config-network:Configure networking"
    "08-arch-chroot:Configure system in chroot"
    "09-enable-systemctl:Enable system services"
    "99-post-install:Finalize installation"
)

# Track progress for recovery
INSTALL_PROGRESS_FILE="/tmp/arch_install_progress"

# Check if resuming from previous installation
if [[ -f "$INSTALL_PROGRESS_FILE" ]]; then
    last_completed=$(cat "$INSTALL_PROGRESS_FILE")
    if [[ $last_completed -gt 0 ]]; then
        echo "Found previous installation attempt that completed $last_completed steps"
        echo "Do you want to resume from step $((last_completed + 1))? (y/N)"
        read -r resume_response </dev/tty
        if [[ $resume_response == [yY] ]]; then
            echo "Resuming installation from step $((last_completed + 1))"
            RESUME_FROM_STEP=$last_completed
        else
            echo "Starting fresh installation"
            RESUME_FROM_STEP=0
        fi
    else
        RESUME_FROM_STEP=0
    fi
else
    RESUME_FROM_STEP=0
fi

echo "$RESUME_FROM_STEP" > "$INSTALL_PROGRESS_FILE"

# Execute installation scripts with proper error handling
echo "Starting installation process..."

step_counter=0
for step_info in "${installation_steps[@]}"; do
    step_counter=$((step_counter + 1))
    script="${step_info%%:*}"
    description="${step_info##*:}"
    
    # Skip completed steps when resuming
    if [[ $step_counter -le $RESUME_FROM_STEP ]]; then
        echo "⏭ Skipping step $step_counter: $description (already completed)"
        continue
    fi
    
    echo ""
    echo "=== Step $step_counter/${#installation_steps[@]}: $description ==="
    
    # Run the step with proper error handling
    if bash "./$script"; then
        echo "✓ Step $step_counter completed: $description"
        echo "$step_counter" > "$INSTALL_PROGRESS_FILE"
    else
        echo "✗ FAILED at step $step_counter: $description"
        echo "Installation can be resumed from this point after fixing the issue"
        exit 1
    fi
done

# Clean up progress tracking on successful completion
rm -f "$INSTALL_PROGRESS_FILE"

# Finish up
echo ""
echo "======================================="
echo "ARCH LINUX INSTALLATION COMPLETED"
echo "======================================="
echo "✓ All ${#installation_steps[@]} installation steps completed successfully"
echo "✓ System is ready for first boot"
echo "✓ Installation log saved: $INSTALL_LOG"
echo ""
echo "The system is now configured with:"
echo "  • Modern Limine bootloader (UEFI + BIOS)"
echo "  • BTRFS filesystem with snapshots"
echo "  • Developer-friendly security hardening"
echo "  • Unbound DNS with DoT/DNSSEC"
echo "  • AppArmor framework prepared"
echo "  • Container/VM support (Docker, Podman)"
echo "  • Core dumps enabled for debugging"
echo "  • Comprehensive system monitoring"
echo ""
echo "Next steps after reboot:"
echo "  1. Complete first-boot setup"
echo "  2. Deploy AppArmor profiles: vic setup security apparmor"
echo "  3. Configure development environment"
echo "======================================="
echo "The system has been installed successfully."
echo "You may now reboot into your new Arch Linux system."
echo ""
echo "Post-installation steps:"
echo "1. Remove installation media"
echo "2. Reboot the system"
echo "3. Log in with user: ${username}"
if [[ $use_luks -eq 1 ]]; then
  echo "4. Enter disk encryption passphrase at boot"
fi
echo ""

reboot_confirm=""
echo -n "Reboot now? (y/N): " >/dev/tty
read -r reboot_confirm </dev/tty
if [[ $reboot_confirm == [yY] ]]; then
  reboot
fi

exit 0
