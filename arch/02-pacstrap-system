#!/usr/bin/env bash

# arch/02-pacstrap-system
# Install base system packages via pacstrap

set -euo pipefail

# Source output function
output() {
    echo "$@"
}

# =====================================
# PACKAGE CATEGORIES
# =====================================

# Base system packages (essential)
readonly BASE_PACKAGES=(
    base base-devel
    linux linux-lts linux-headers linux-firmware
    dkms
)

# Filesystem packages
readonly FILESYSTEM_PACKAGES=(
    btrfs-progs e2fsprogs dosfstools xfsprogs
    zram-generator
)

# Hardware support
readonly HARDWARE_PACKAGES=(
    acpi lm_sensors fwupd device-mapper
    upower smartmontools
)

# Bootloader (Limine instead of GRUB)
readonly BOOTLOADER_PACKAGES=(
    limine
    sbctl  # Secure boot support
)

# Security packages (AppArmor framework)
readonly SECURITY_PACKAGES=(
    apparmor audit
    snapper snap-pac
    ufw iptables-nft fail2ban
)

# Network packages  
readonly NETWORK_PACKAGES=(
    networkmanager openssh chrony reflector
    nfs-utils wpa_supplicant wireless_tools
    tcpdump ethtool
)

# Printing support
readonly PRINTING_PACKAGES=(
    cups cups-filters cups-pdf
)

# Essential admin tools
readonly ADMIN_TOOLS=(
    tree curl perl less nano vim neovim
    man-pages man-db wget diffutils logrotate
    cronie clang git inotify-tools
    rsync unzip zip lsof strace htop
    iotop irqbalance
)

# Desktop integration (minimal)
readonly DESKTOP_PACKAGES=(
    xdg-utils xdg-user-dirs accountsservice
)

# System monitoring & security auditing
readonly MONITORING_PACKAGES=(
    lynis
)

# =====================================
# MICROCODE DETECTION
# =====================================
detect_microcode() {
    local cpu_vendor
    cpu_vendor=$(grep -m1 "vendor_id" /proc/cpuinfo | cut -d: -f2 | tr -d ' ' || echo "unknown")
    
    case "$cpu_vendor" in
        "AuthenticAMD")
            echo "amd-ucode"
            output "Detected AMD processor - adding AMD microcode"
            ;;
        "GenuineIntel")
            echo "intel-ucode"
            output "Detected Intel processor - adding Intel microcode"
            ;;
        *)
            output "WARNING: Unknown CPU vendor ($cpu_vendor) - skipping microcode"
            echo ""
            ;;
    esac
}

# =====================================
# VALIDATION FUNCTIONS
# =====================================
validate_pacstrap_success() {
    local critical_packages=("linux" "linux-firmware" "base" "systemd")
    
    for package in "${critical_packages[@]}"; do
        if ! arch-chroot /mnt pacman -Q "$package" &>/dev/null; then
            output "ERROR: Critical package '$package' not found after pacstrap"
            return 1
        fi
    done
    
    output "Package installation validation passed"
    return 0
}

check_available_space() {
    local available_mb
    available_mb=$(df /mnt --output=avail -BM | tail -n1 | tr -d 'M')
    
    if [[ $available_mb -lt 2048 ]]; then
        output "WARNING: Low disk space remaining (${available_mb}MB)"
        output "Consider reducing package selection or expanding disk"
    else
        output "Available space: ${available_mb}MB"
    fi
}

# =====================================
# PACKAGE INSTALLATION
# =====================================
install_package_group() {
    local group_name="$1"
    shift
    local packages=("$@")
    
    output "Installing $group_name packages..."
    output "  Packages: ${packages[*]}"
    
    if ! pacstrap /mnt "${packages[@]}"; then
        output "ERROR: Failed to install $group_name packages"
        output "Failed packages: ${packages[*]}"
        output "Common causes:"
        output "  - Internet connection issues"
        output "  - Repository sync problems"  
        output "  - Package conflicts"
        output "  - Insufficient disk space"
        return 1
    fi
    
    output "  ✓ $group_name packages installed successfully"
}

# =====================================
# MAIN INSTALLATION PROCESS
# =====================================

output "=== Base System Installation ==="
output "Starting pacstrap installation process..."

# Update package database
output "Updating package database..."
if ! pacman -Syy; then
    output "ERROR: Failed to update package database"
    output "This usually means:"
    output "  1. No internet connection"
    output "  2. Repository mirrors are unreachable" 
    output "  3. Pacman keyring issues"
    return 1
fi

# Test repository access
output "Testing repository access..."
if ! pacman -Ss base >/dev/null 2>&1; then
    output "ERROR: Cannot access package repositories"
    output "Repository database may not be properly synced"
    return 1
fi

output "Package database updated successfully"

# Detect microcode package
microcode_package=$(detect_microcode)

# Create complete package list
all_packages=(
    "${BASE_PACKAGES[@]}"
    "${FILESYSTEM_PACKAGES[@]}"
    "${HARDWARE_PACKAGES[@]}"
    "${BOOTLOADER_PACKAGES[@]}"
    "${SECURITY_PACKAGES[@]}"
    "${NETWORK_PACKAGES[@]}"
    "${PRINTING_PACKAGES[@]}"
    "${ADMIN_TOOLS[@]}"
    "${DESKTOP_PACKAGES[@]}"
    "${MONITORING_PACKAGES[@]}"
)

# Add microcode if detected
if [[ -n $microcode_package ]]; then
    all_packages+=("$microcode_package")
fi

# Display installation summary
output ""
output "=== Installation Summary ==="
output "Total packages to install: ${#all_packages[@]}"
output "Microcode package: ${microcode_package:-"none detected"}"
output "Target: /mnt"
output ""

# Install ALL packages in one pacstrap call
output "Installing all packages with pacstrap..."
if ! pacstrap /mnt "${all_packages[@]}"; then
    output "ERROR: Failed to install packages to new root"
    output "Packages attempted: ${all_packages[*]}"
    return 1
fi
output "✓ All packages installed successfully"

# Validate installation
output ""
output "=== Installation Validation ==="
if ! validate_pacstrap_success; then
    output "ERROR: Package installation validation failed"
    output "Critical system packages are missing"
    return 1
fi

# Check remaining space
check_available_space

# Installation summary
output ""
output "=== Pacstrap Installation Complete ==="
output "✓ All package groups installed successfully"
output "✓ Critical packages validated"
output "✓ Bootloader: Limine (modern alternative to GRUB)"
output "✓ Security: AppArmor framework ready"
output "✓ Monitoring: System health tools installed"
output "✓ Admin tools: Complete troubleshooting toolkit"
output ""

# Export microcode info for other scripts
export MICROCODE_PACKAGE="$microcode_package"

output "Ready for next installation phase..."
