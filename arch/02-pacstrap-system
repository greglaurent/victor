#!/usr/bin/env bash

# arch/02-pacstrap-system
# Install base system packages via pacstrap

set -euo pipefail

# No output function - use echo directly

# =====================================
# PACKAGE CATEGORIES
# =====================================

# Base system packages (essential)
readonly BASE_PACKAGES=(
    base base-devel
    linux linux-lts linux-headers linux-firmware
    dkms
)

# Filesystem packages
readonly FILESYSTEM_PACKAGES=(
    btrfs-progs e2fsprogs dosfstools xfsprogs
    zram-generator
)

# Hardware support
readonly HARDWARE_PACKAGES=(
    acpi lm_sensors fwupd device-mapper
    upower smartmontools
)

# Bootloader (Limine instead of GRUB)
readonly BOOTLOADER_PACKAGES=(
    limine
    sbctl  # Secure boot support
)

# Security packages (AppArmor framework)
readonly SECURITY_PACKAGES=(
    apparmor audit
    snapper snap-pac
    ufw iptables-nft fail2ban
)

# Network packages  
readonly NETWORK_PACKAGES=(
    networkmanager openssh chrony reflector
    nfs-utils wpa_supplicant wireless_tools
    tcpdump ethtool
)

# Printing support
readonly PRINTING_PACKAGES=(
    cups cups-filters cups-pdf
)

# Essential admin tools
readonly ADMIN_TOOLS=(
    tree curl perl less nano vim neovim
    man-pages man-db wget diffutils logrotate
    cronie clang git inotify-tools
    rsync unzip zip lsof strace htop
    iotop irqbalance
)

# Desktop integration (minimal)
readonly DESKTOP_PACKAGES=(
    xdg-utils xdg-user-dirs accountsservice
)

# System monitoring & security auditing
readonly MONITORING_PACKAGES=(
    lynis
)

# =====================================
# MICROCODE DETECTION
# =====================================
detect_microcode() {
    local cpu_vendor
    cpu_vendor=$(grep -m1 "vendor_id" /proc/cpuinfo | cut -d: -f2 | tr -d ' ' 2>/dev/null || echo "unknown")
    
    case "$cpu_vendor" in
        "AuthenticAMD")
            echo "amd-ucode"
            ;;
        "GenuineIntel")
            echo "intel-ucode"
            ;;
        *)
            # Return nothing for unknown CPU
            ;;
    esac
}

# =====================================
# VALIDATION FUNCTIONS
# =====================================
validate_pacstrap_success() {
    local critical_packages=("linux" "linux-firmware" "base" "systemd")
    
    for package in "${critical_packages[@]}"; do
        if ! arch-chroot /mnt pacman -Q "$package" &>/dev/null; then
            echo "ERROR: Critical package '$package' not found after pacstrap"
            return 1
        fi
    done
    
    echo "Package installation validation passed"
    return 0
}

check_available_space() {
    local available_mb
    available_mb=$(df /mnt --output=avail -BM | tail -n1 | tr -d 'M')
    
    if [[ $available_mb -lt 2048 ]]; then
        echo "WARNING: Low disk space remaining (${available_mb}MB)"
        echo "Consider reducing package selection or expanding disk"
    else
        echo "Available space: ${available_mb}MB"
    fi
}

# =====================================
# PACKAGE INSTALLATION
# =====================================
install_package_group() {
    local group_name="$1"
    shift
    local packages=("$@")
    
    echo "Installing $group_name packages..."
    echo "  Packages: ${packages[*]}"
    
    if ! pacstrap /mnt "${packages[@]}"; then
        echo "ERROR: Failed to install $group_name packages"
        echo "Failed packages: ${packages[*]}"
        echo "Common causes:"
        echo "  - Internet connection issues"
        echo "  - Repository sync problems"  
        echo "  - Package conflicts"
        echo "  - Insufficient disk space"
        return 1
    fi
    
    echo "  ✓ $group_name packages installed successfully"
}

# =====================================
# MAIN INSTALLATION PROCESS
# =====================================

echo "=== Base System Installation ==="
echo "Starting pacstrap installation process..."

# Update package database
echo "Updating package database..."
if ! pacman -Syy; then
    echo "ERROR: Failed to update package database"
    echo "This usually means:"
    echo "  1. No internet connection"
    echo "  2. Repository mirrors are unreachable" 
    echo "  3. Pacman keyring issues"
    return 1
fi

# Test repository access
echo "Testing repository access..."
if ! pacman -Ss base >/dev/null 2>&1; then
    echo "ERROR: Cannot access package repositories"
    echo "Repository database may not be properly synced"
    return 1
fi

echo "Package database updated successfully"

# Detect microcode package
microcode_package=$(detect_microcode)

# Create complete package list
all_packages=(
    "${BASE_PACKAGES[@]}"
    "${FILESYSTEM_PACKAGES[@]}"
    "${HARDWARE_PACKAGES[@]}"
    "${BOOTLOADER_PACKAGES[@]}"
    "${SECURITY_PACKAGES[@]}"
    "${NETWORK_PACKAGES[@]}"
    "${PRINTING_PACKAGES[@]}"
    "${ADMIN_TOOLS[@]}"
    "${DESKTOP_PACKAGES[@]}"
    "${MONITORING_PACKAGES[@]}"
)

# Add microcode if detected
if [[ -n $microcode_package ]]; then
    all_packages+=("$microcode_package")
fi

# Display installation summary
echo ""
echo "=== Installation Summary ==="
echo "Total packages to install: ${#all_packages[@]}"
echo "Microcode package: ${microcode_package:-"none detected"}"
echo "Target: /mnt"
echo ""

# Install ALL packages in one pacstrap call
echo "Installing all packages with pacstrap..."
if ! pacstrap /mnt "${all_packages[@]}"; then
    echo "ERROR: Failed to install packages to new root"
    echo "Packages attempted: ${all_packages[*]}"
    exit 1
fi
echo "✓ All packages installed successfully"

# Validate installation
echo ""
echo "=== Installation Validation ==="
if ! validate_pacstrap_success; then
    echo "ERROR: Package installation validation failed"
    echo "Critical system packages are missing"
    return 1
fi

# Check remaining space
check_available_space

# Installation summary
echo ""
echo "=== Pacstrap Installation Complete ==="
echo "✓ All package groups installed successfully"
echo "✓ Critical packages validated"
echo "✓ Bootloader: Limine (modern alternative to GRUB)"
echo "✓ Security: AppArmor framework ready"
echo "✓ Monitoring: System health tools installed"
echo "✓ Admin tools: Complete troubleshooting toolkit"
echo ""

# Export microcode info for other scripts
export MICROCODE_PACKAGE="$microcode_package"

echo "Ready for next installation phase..."
