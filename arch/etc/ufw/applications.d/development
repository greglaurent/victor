# Development application profiles for UFW
# Use with: ufw allow in development-web
# Or: ufw allow from 192.168.0.0/16 to any app development-full

[development-web]
title=Development Web Servers
description=Common web development ports
ports=3000:3999/tcp|8000:8999/tcp|4000:4999/tcp|5000:5999/tcp|9000:9999/tcp

[development-full]
title=Full Development Stack
description=Web servers, databases, microservices, debugging
ports=3000:3999/tcp|4000:4999/tcp|5000:5999/tcp|8000:8999/tcp|9000:9999/tcp|27017/tcp|5432/tcp|6379/tcp|9229/tcp|9230/tcp

[development-api]
title=API Development
description=REST APIs, GraphQL, gRPC
ports=3000/tcp|8080/tcp|8081/tcp|9090/tcp|50051/tcp

[development-database]
title=Development Databases
description=Local development databases
ports=3306/tcp|5432/tcp|27017/tcp|6379/tcp|9200/tcp|5984/tcp

[development-debug]
title=Development Debugging
description=Node debugger, Chrome DevTools, etc
ports=9229/tcp|9230/tcp|9222/tcp|9223/tcp