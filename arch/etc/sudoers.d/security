# Sudo security configuration

# Require password for sudo
Defaults passwd_timeout=0
Defaults timestamp_timeout=60

# Log sudo commands (but not sensitive output)
Defaults log_input
Defaults logfile="/var/log/sudo.log"

# Developer-friendly: Don't log output (prevents secret leakage)
# Defaults log_output

# Secure path
Defaults secure_path="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Don't allow shell escapes (commented for developer compatibility)
# Defaults noexec

# Require tty (commented for automation/scripts)
# Defaults requiretty

# Developer-friendly: Allow specific commands without restrictions
# Uncomment the noexec line above if you need maximum security
# Uncomment requiretty if all sudo usage is interactive
