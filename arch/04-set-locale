#!/usr/bin/env bash

# arch/04-set-locale
# Configure hostname, locale, timezone, and keyboard layout

set -euo pipefail

# Source echo function and ensure required variables

# Ensure required variables are defined
hostname=${hostname:-\"\"}
locale=${locale:-\"en_US\"}
kblayout=${kblayout:-\"us\"}
timezone=${timezone:-\"America/Los_Angeles\"}

# Validate required variables
if [[ -z \"$hostname\" ]]; then
    echo \"ERROR: Hostname variable not set. This script requires hostname to be defined.\"
    exit 1
fi

# =====================================
# VALIDATION FUNCTIONS
# =====================================

validate_locale() {
    local locale="${1:?}"
    
    echo "Validating locale: $locale"
    
    # Check locale format (should be like en_US, de_DE, etc.)
    if [[ ! $locale =~ ^[a-z]{2}_[A-Z]{2}$ ]]; then
        echo "ERROR: Invalid locale format: $locale"
        echo "Expected format: xx_XX (e.g., en_US, de_DE)"
        exit 1
    fi
    
    # Check if locale is supported by checking available locales
    if ! grep -q "^#*${locale}.UTF-8" /etc/locale.gen 2>/dev/null; then
        echo "WARNING: Locale $locale may not be available in system"
        echo "Proceeding anyway - will be validated during locale-gen"
    fi
    
    echo "  ✓ Locale format validated: $locale"
    return 0
}

validate_timezone() {
    local tz="${1:?}"
    
    echo "Validating timezone: $tz"
    
    # Check if timezone file exists
    if [[ ! -f "/usr/share/zoneinfo/$tz" ]]; then
        echo "ERROR: Invalid timezone: $tz"
        echo "Timezone file not found: /usr/share/zoneinfo/$tz"
        exit 1
    fi
    
    # Validate timezone format (should have at least one slash)
    if [[ ! $tz =~ / ]]; then
        echo "WARNING: Unusual timezone format: $tz"
        echo "Expected format: Continent/City (e.g., America/New_York)"
    fi
    
    echo "  ✓ Timezone validated: $tz"
    return 0
}

validate_keyboard() {
    local kb="${1:?}"
    
    echo "Validating keyboard layout: $kb"
    
    # Check keyboard layout format (alphanumeric and hyphens only)
    if [[ ! $kb =~ ^[a-zA-Z0-9_-]+$ ]]; then
        echo "ERROR: Invalid keyboard layout format: $kb"
        exit 1
    fi
    
    # List of common keyboard layouts for validation
    local common_layouts=(
        "us" "uk" "de" "fr" "es" "it" "pt" "ru" "jp" "kr"
        "br" "ca" "ch" "dk" "fi" "no" "se" "pl" "cz" "hu"
        "dvorak" "colemak"
    )
    
    # Check if it's a common layout
    local is_common=false
    for layout in "${common_layouts[@]}"; do
        if [[ "$kb" == "$layout" ]]; then
            is_common=true
            break
        fi
    done
    
    if [[ "$is_common" == "false" ]]; then
        echo "WARNING: Uncommon keyboard layout: $kb"
        echo "This may not be available on all systems"
    fi
    
    echo "  ✓ Keyboard layout validated: $kb"
    return 0
}

validate_hostname() {
    local hostname="${1:?}"
    
    echo "Validating hostname: $hostname"
    
    # Check hostname format (RFC 1123 compliant)
    if [[ ! $hostname =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$ ]]; then
        echo "ERROR: Invalid hostname format: $hostname"
        echo "Hostname must be 1-63 characters, alphanumeric and hyphens only"
        echo "Cannot start or end with hyphen"
        exit 1
    fi
    
    # Check for reserved hostnames
    local reserved_hostnames=("localhost" "router" "gateway" "dns" "mail" "www" "ftp")
    for reserved in "${reserved_hostnames[@]}"; do
        if [[ "$hostname" == "$reserved" ]]; then
            echo "WARNING: Using reserved hostname: $hostname"
            echo "This may cause network conflicts"
            break
        fi
    done
    
    echo "  ✓ Hostname validated: $hostname"
    return 0
}

# =====================================
# CONFIGURATION FUNCTIONS
# =====================================

backup_existing_config() {
    local file="${1:?}"
    
    if [[ -f "$file" ]]; then
        local backup_file
        backup_file="${file}.backup.$(date +%s)"
        cp "$file" "$backup_file"
        echo "  Backed up existing $file to $backup_file"
    fi
}

create_hostname_config() {
    echo "Step 1/5: Setting hostname..."
    
    local hostname_file="/mnt/etc/hostname"
    
    # Backup existing file
    backup_existing_config "$hostname_file"
    
    # Create hostname file
    if ! echo "$hostname" > "$hostname_file"; then
        echo "ERROR: Failed to create hostname file"
        exit 1
    fi
    
    # Verify content was written correctly
    local written_hostname
    written_hostname=$(tr -d '\n' < "$hostname_file" 2>/dev/null)
    if [[ "$written_hostname" != "${hostname}" ]]; then
        echo "ERROR: Hostname not written correctly"
        echo "Expected: ${hostname}"
        echo "Found: $written_hostname"
        exit 1
    fi
    
    # Set proper permissions
    chmod 644 "$hostname_file"
    
    echo "  ✓ Hostname configured: ${hostname}"
    return 0
}

create_hosts_file() {
    echo "Step 2/5: Creating hosts file..."
    
    local hosts_file="/mnt/etc/hosts"
    local template_file="$HERE/arch/etc/hosts.template"
    
    # Backup existing file
    backup_existing_config "$hosts_file"
    
    # Verify template exists
    if [[ ! -f "$template_file" ]]; then
        echo "ERROR: hosts template file not found: $template_file"
        exit 1
    fi
    
    # Create hosts file from template
    if ! sed "s/{{HOSTNAME}}/$hostname/g" "$template_file" > "$hosts_file"; then
        echo "ERROR: Failed to create hosts file from template"
        exit 1
    fi

    # Verify hosts file was created correctly
    if [[ ! -f "$hosts_file" ]]; then
        echo "ERROR: Hosts file was not created"
        exit 1
    fi
    
    # Check for required entries
    local required_entries=("127.0.0.1" "localhost" "${hostname}")
    for entry in "${required_entries[@]}"; do
        if ! grep -q "$entry" "$hosts_file"; then
            echo "ERROR: Required entry '$entry' not found in hosts file"
            exit 1
        fi
    done
    
    # Set proper permissions
    chmod 644 "$hosts_file"
    
    echo "  ✓ Hosts file created with hostname: ${hostname}"
    return 0
}

create_locale_config() {
    echo "Step 3/5: Configuring locale..."
    
    local locale_gen_file="/mnt/etc/locale.gen"
    local locale_conf_file="/mnt/etc/locale.conf"
    local locale_line="$locale.UTF-8 UTF-8"
    
    # Backup existing files
    backup_existing_config "$locale_gen_file"
    backup_existing_config "$locale_conf_file"
    
    # Create locale.gen
    if ! echo "$locale_line" > "$locale_gen_file"; then
        echo "ERROR: Failed to create locale.gen"
        exit 1
    fi
    
    # Verify locale.gen content
    if ! grep -q "$locale_line" "$locale_gen_file"; then
        echo "ERROR: Locale configuration not written correctly to locale.gen"
        exit 1
    fi
    
    # Create locale.conf
    local locale_conf_content="LANG=${locale}.UTF-8"
    if ! echo "$locale_conf_content" > "$locale_conf_file"; then
        echo "ERROR: Failed to create locale.conf"
        exit 1
    fi
    
    # Verify locale.conf content
    if ! grep -q "LANG=${locale}.UTF-8" "$locale_conf_file"; then
        echo "ERROR: Locale configuration not written correctly to locale.conf"
        exit 1
    fi
    
    # Set proper permissions
    chmod 644 "$locale_gen_file" "$locale_conf_file"
    
    echo "  ✓ Locale configured: ${locale}.UTF-8"
    return 0
}

create_keyboard_config() {
    echo "Step 4/5: Setting keyboard layout..."
    
    local vconsole_file="/mnt/etc/vconsole.conf"
    local keymap_line="KEYMAP=$kblayout"
    
    # Backup existing file
    backup_existing_config "$vconsole_file"
    
    # Create vconsole.conf
    if ! echo "$keymap_line" > "$vconsole_file"; then
        echo "ERROR: Failed to create vconsole.conf"
        exit 1
    fi
    
    # Verify content was written correctly
    if ! grep -q "KEYMAP=${kblayout}" "$vconsole_file"; then
        echo "ERROR: Keyboard configuration not written correctly"
        exit 1
    fi
    
    # Set proper permissions
    chmod 644 "$vconsole_file"
    
    echo "  ✓ Keyboard layout configured: ${kblayout}"
    return 0
}

configure_timezone() {
    echo "Step 5/5: Configuring timezone..."
    
    local timezone_path="/usr/share/zoneinfo/$timezone"
    local localtime_link="/mnt/etc/localtime"
    
    # Verify timezone file exists (should have been validated earlier)
    if [[ ! -f "$timezone_path" ]]; then
        echo "ERROR: Timezone file not found: $timezone_path"
        exit 1
    fi
    
    # Remove existing localtime if it exists
    if [[ -e "$localtime_link" ]]; then
        rm "$localtime_link"
    fi
    
    # Create timezone symlink
    if ! ln -sf "$timezone_path" "$localtime_link"; then
        echo "ERROR: Failed to create timezone symlink"
        exit 1
    fi
    
    # Verify symlink was created correctly
    if [[ ! -L "$localtime_link" ]]; then
        echo "ERROR: Timezone symlink not created"
        exit 1
    fi
    
    local link_target
    link_target=$(readlink "$localtime_link")
    if [[ "$link_target" != "$timezone_path" ]]; then
        echo "ERROR: Timezone symlink points to wrong target"
        echo "Expected: $timezone_path"
        echo "Found: $link_target"
        exit 1
    fi
    
    echo "  ✓ Timezone configured: ${timezone}"
    return 0
}

verify_all_configuration() {
    echo "Verifying all locale configuration..."
    
    local config_files=(
        "/mnt/etc/hostname:${hostname}"
        "/mnt/etc/hosts:${hostname}"
        "/mnt/etc/locale.gen:${locale}.UTF-8"
        "/mnt/etc/locale.conf:LANG=${locale}.UTF-8"
        "/mnt/etc/vconsole.conf:KEYMAP=${kblayout}"
    )
    
    local verification_errors=0
    
    for config in "${config_files[@]}"; do
        local file="${config%:*}"
        local expected_content="${config#*:}"
        
        if [[ ! -f "$file" ]]; then
            echo "ERROR: Configuration file missing: $file"
            ((verification_errors++))
        elif [[ ! -s "$file" ]]; then
            echo "ERROR: Configuration file empty: $file"
            ((verification_errors++))
        elif ! grep -q "$expected_content" "$file"; then
            echo "ERROR: Expected content not found in $file"
            echo "  Looking for: $expected_content"
            ((verification_errors++))
        else
            echo "  ✓ $file verified"
        fi
    done
    
    # Verify timezone symlink
    if [[ ! -L "/mnt/etc/localtime" ]]; then
        echo "ERROR: Timezone symlink missing"
        ((verification_errors++))
    else
        echo "  ✓ /mnt/etc/localtime verified"
    fi
    
    if [[ $verification_errors -gt 0 ]]; then
        echo "ERROR: $verification_errors configuration verification failures"
        exit 1
    fi
    
    echo "All configuration files verified successfully"
    return 0
}

display_configuration_summary() {
    echo ""
    echo "=== Locale Configuration Summary ==="
    echo "Hostname: ${hostname}"
    echo "Locale: ${locale}.UTF-8"
    echo "Keyboard: ${kblayout}"
    echo "Timezone: ${timezone}"
    echo ""
    
    echo "=== Configuration Files Created ==="
    echo "Hostname: /etc/hostname"
    echo "Hosts: /etc/hosts"
    echo "Locale generation: /etc/locale.gen"
    echo "Locale config: /etc/locale.conf"
    echo "Keyboard: /etc/vconsole.conf"
    echo "Timezone: /etc/localtime -> /usr/share/zoneinfo/${timezone}"
    echo "===================================="
    echo ""
}

# =====================================
# MAIN CONFIGURATION PROCESS
# =====================================

echo "=== Locale and System Configuration ==="

# Validate all input parameters
validate_hostname "$hostname" || exit 1
validate_locale "$locale" || exit 1
validate_keyboard "$kblayout" || exit 1
validate_timezone "$timezone" || exit 1

echo "All input parameters validated successfully"
echo ""

# Create configuration files
create_hostname_config || exit 1
create_hosts_file || exit 1
create_locale_config || exit 1
create_keyboard_config || exit 1
configure_timezone || exit 1

# Verify all configurations
verify_all_configuration || exit 1

# Display summary
display_configuration_summary

echo "=== Locale Configuration Complete ==="
echo "✓ Hostname configured: ${hostname}"
echo "✓ Locale configured: ${locale}.UTF-8"
echo "✓ Keyboard layout: ${kblayout}"
echo "✓ Timezone: ${timezone}"
echo "✓ All configuration files verified"
echo ""
echo "System locale configuration ready for chroot phase"
