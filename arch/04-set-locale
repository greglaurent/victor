#!/usr/bin/env bash

# arch/04-set-locale
# Configure hostname, locale, timezone, and keyboard layout

set -euo pipefail

# =====================================
# VALIDATION FUNCTIONS
# =====================================

validate_locale() {
    local locale="${1:?}"
    
    output "Validating locale: $locale"
    
    # Check locale format (should be like en_US, de_DE, etc.)
    if [[ ! $locale =~ ^[a-z]{2}_[A-Z]{2}$ ]]; then
        output "ERROR: Invalid locale format: $locale"
        output "Expected format: xx_XX (e.g., en_US, de_DE)"
        return 1
    fi
    
    # Check if locale is supported by checking available locales
    if ! grep -q "^#*${locale}.UTF-8" /etc/locale.gen 2>/dev/null; then
        output "WARNING: Locale $locale may not be available in system"
        output "Proceeding anyway - will be validated during locale-gen"
    fi
    
    output "  ✓ Locale format validated: $locale"
    return 0
}

validate_timezone() {
    local tz="${1:?}"
    
    output "Validating timezone: $tz"
    
    # Check if timezone file exists
    if [[ ! -f "/usr/share/zoneinfo/$tz" ]]; then
        output "ERROR: Invalid timezone: $tz"
        output "Timezone file not found: /usr/share/zoneinfo/$tz"
        return 1
    fi
    
    # Validate timezone format (should have at least one slash)
    if [[ ! $tz =~ / ]]; then
        output "WARNING: Unusual timezone format: $tz"
        output "Expected format: Continent/City (e.g., America/New_York)"
    fi
    
    output "  ✓ Timezone validated: $tz"
    return 0
}

validate_keyboard() {
    local kb="${1:?}"
    
    output "Validating keyboard layout: $kb"
    
    # Check keyboard layout format (alphanumeric and hyphens only)
    if [[ ! $kb =~ ^[a-zA-Z0-9_-]+$ ]]; then
        output "ERROR: Invalid keyboard layout format: $kb"
        return 1
    fi
    
    # List of common keyboard layouts for validation
    local common_layouts=(
        "us" "uk" "de" "fr" "es" "it" "pt" "ru" "jp" "kr"
        "br" "ca" "ch" "dk" "fi" "no" "se" "pl" "cz" "hu"
        "dvorak" "colemak"
    )
    
    # Check if it's a common layout
    local is_common=false
    for layout in "${common_layouts[@]}"; do
        if [[ "$kb" == "$layout" ]]; then
            is_common=true
            break
        fi
    done
    
    if [[ "$is_common" == "false" ]]; then
        output "WARNING: Uncommon keyboard layout: $kb"
        output "This may not be available on all systems"
    fi
    
    output "  ✓ Keyboard layout validated: $kb"
    return 0
}

validate_hostname() {
    local hostname="${1:?}"
    
    output "Validating hostname: $hostname"
    
    # Check hostname format (RFC 1123 compliant)
    if [[ ! $hostname =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$ ]]; then
        output "ERROR: Invalid hostname format: $hostname"
        output "Hostname must be 1-63 characters, alphanumeric and hyphens only"
        output "Cannot start or end with hyphen"
        return 1
    fi
    
    # Check for reserved hostnames
    local reserved_hostnames=("localhost" "router" "gateway" "dns" "mail" "www" "ftp")
    for reserved in "${reserved_hostnames[@]}"; do
        if [[ "$hostname" == "$reserved" ]]; then
            output "WARNING: Using reserved hostname: $hostname"
            output "This may cause network conflicts"
            break
        fi
    done
    
    output "  ✓ Hostname validated: $hostname"
    return 0
}

# =====================================
# CONFIGURATION FUNCTIONS
# =====================================

backup_existing_config() {
    local file="${1:?}"
    
    if [[ -f "$file" ]]; then
        local backup_file
        backup_file="${file}.backup.$(date +%s)"
        cp "$file" "$backup_file"
        output "  Backed up existing $file to $backup_file"
    fi
}

create_hostname_config() {
    output "Step 1/5: Setting hostname..."
    
    local hostname_file="/mnt/etc/hostname"
    
    # Backup existing file
    backup_existing_config "$hostname_file"
    
    # Create hostname file
    if ! echo "${hostname:?}" > "$hostname_file"; then
        output "ERROR: Failed to create hostname file"
        return 1
    fi
    
    # Verify content was written correctly
    local written_hostname
    written_hostname=$(tr -d '\n' < "$hostname_file" 2>/dev/null)
    if [[ "$written_hostname" != "${hostname}" ]]; then
        output "ERROR: Hostname not written correctly"
        output "Expected: ${hostname}"
        output "Found: $written_hostname"
        return 1
    fi
    
    # Set proper permissions
    chmod 644 "$hostname_file"
    
    output "  ✓ Hostname configured: ${hostname}"
    return 0
}

create_hosts_file() {
    output "Step 2/5: Creating hosts file..."
    
    local hosts_file="/mnt/etc/hosts"
    local template_file="$HERE/arch/etc/hosts.template"
    
    # Backup existing file
    backup_existing_config "$hosts_file"
    
    # Verify template exists
    if [[ ! -f "$template_file" ]]; then
        output "ERROR: hosts template file not found: $template_file"
        return 1
    fi
    
    # Create hosts file from template
    if ! sed "s/{{HOSTNAME}}/${hostname:?}/g" "$template_file" > "$hosts_file"; then
        output "ERROR: Failed to create hosts file from template"
        return 1
    fi

    # Verify hosts file was created correctly
    if [[ ! -f "$hosts_file" ]]; then
        output "ERROR: Hosts file was not created"
        return 1
    fi
    
    # Check for required entries
    local required_entries=("127.0.0.1" "localhost" "${hostname}")
    for entry in "${required_entries[@]}"; do
        if ! grep -q "$entry" "$hosts_file"; then
            output "ERROR: Required entry '$entry' not found in hosts file"
            return 1
        fi
    done
    
    # Set proper permissions
    chmod 644 "$hosts_file"
    
    output "  ✓ Hosts file created with hostname: ${hostname}"
    return 0
}

create_locale_config() {
    output "Step 3/5: Configuring locale..."
    
    local locale_gen_file="/mnt/etc/locale.gen"
    local locale_conf_file="/mnt/etc/locale.conf"
    local locale_line="${locale:?}.UTF-8 UTF-8"
    
    # Backup existing files
    backup_existing_config "$locale_gen_file"
    backup_existing_config "$locale_conf_file"
    
    # Create locale.gen
    if ! echo "$locale_line" > "$locale_gen_file"; then
        output "ERROR: Failed to create locale.gen"
        return 1
    fi
    
    # Verify locale.gen content
    if ! grep -q "$locale_line" "$locale_gen_file"; then
        output "ERROR: Locale configuration not written correctly to locale.gen"
        return 1
    fi
    
    # Create locale.conf
    local locale_conf_content="LANG=${locale}.UTF-8"
    if ! echo "$locale_conf_content" > "$locale_conf_file"; then
        output "ERROR: Failed to create locale.conf"
        return 1
    fi
    
    # Verify locale.conf content
    if ! grep -q "LANG=${locale}.UTF-8" "$locale_conf_file"; then
        output "ERROR: Locale configuration not written correctly to locale.conf"
        return 1
    fi
    
    # Set proper permissions
    chmod 644 "$locale_gen_file" "$locale_conf_file"
    
    output "  ✓ Locale configured: ${locale}.UTF-8"
    return 0
}

create_keyboard_config() {
    output "Step 4/5: Setting keyboard layout..."
    
    local vconsole_file="/mnt/etc/vconsole.conf"
    local keymap_line="KEYMAP=${kblayout:?}"
    
    # Backup existing file
    backup_existing_config "$vconsole_file"
    
    # Create vconsole.conf
    if ! echo "$keymap_line" > "$vconsole_file"; then
        output "ERROR: Failed to create vconsole.conf"
        return 1
    fi
    
    # Verify content was written correctly
    if ! grep -q "KEYMAP=${kblayout}" "$vconsole_file"; then
        output "ERROR: Keyboard configuration not written correctly"
        return 1
    fi
    
    # Set proper permissions
    chmod 644 "$vconsole_file"
    
    output "  ✓ Keyboard layout configured: ${kblayout}"
    return 0
}

configure_timezone() {
    output "Step 5/5: Configuring timezone..."
    
    local timezone_path="/usr/share/zoneinfo/${timezone:?}"
    local localtime_link="/mnt/etc/localtime"
    
    # Verify timezone file exists (should have been validated earlier)
    if [[ ! -f "$timezone_path" ]]; then
        output "ERROR: Timezone file not found: $timezone_path"
        return 1
    fi
    
    # Remove existing localtime if it exists
    if [[ -e "$localtime_link" ]]; then
        rm "$localtime_link"
    fi
    
    # Create timezone symlink
    if ! ln -sf "$timezone_path" "$localtime_link"; then
        output "ERROR: Failed to create timezone symlink"
        return 1
    fi
    
    # Verify symlink was created correctly
    if [[ ! -L "$localtime_link" ]]; then
        output "ERROR: Timezone symlink not created"
        return 1
    fi
    
    local link_target
    link_target=$(readlink "$localtime_link")
    if [[ "$link_target" != "$timezone_path" ]]; then
        output "ERROR: Timezone symlink points to wrong target"
        output "Expected: $timezone_path"
        output "Found: $link_target"
        return 1
    fi
    
    output "  ✓ Timezone configured: ${timezone}"
    return 0
}

verify_all_configuration() {
    output "Verifying all locale configuration..."
    
    local config_files=(
        "/mnt/etc/hostname:${hostname}"
        "/mnt/etc/hosts:${hostname}"
        "/mnt/etc/locale.gen:${locale}.UTF-8"
        "/mnt/etc/locale.conf:LANG=${locale}.UTF-8"
        "/mnt/etc/vconsole.conf:KEYMAP=${kblayout}"
    )
    
    local verification_errors=0
    
    for config in "${config_files[@]}"; do
        local file="${config%:*}"
        local expected_content="${config#*:}"
        
        if [[ ! -f "$file" ]]; then
            output "ERROR: Configuration file missing: $file"
            ((verification_errors++))
        elif [[ ! -s "$file" ]]; then
            output "ERROR: Configuration file empty: $file"
            ((verification_errors++))
        elif ! grep -q "$expected_content" "$file"; then
            output "ERROR: Expected content not found in $file"
            output "  Looking for: $expected_content"
            ((verification_errors++))
        else
            output "  ✓ $file verified"
        fi
    done
    
    # Verify timezone symlink
    if [[ ! -L "/mnt/etc/localtime" ]]; then
        output "ERROR: Timezone symlink missing"
        ((verification_errors++))
    else
        output "  ✓ /mnt/etc/localtime verified"
    fi
    
    if [[ $verification_errors -gt 0 ]]; then
        output "ERROR: $verification_errors configuration verification failures"
        return 1
    fi
    
    output "All configuration files verified successfully"
    return 0
}

display_configuration_summary() {
    output ""
    output "=== Locale Configuration Summary ==="
    output "Hostname: ${hostname}"
    output "Locale: ${locale}.UTF-8"
    output "Keyboard: ${kblayout}"
    output "Timezone: ${timezone}"
    output ""
    
    output "=== Configuration Files Created ==="
    output "Hostname: /etc/hostname"
    output "Hosts: /etc/hosts"
    output "Locale generation: /etc/locale.gen"
    output "Locale config: /etc/locale.conf"
    output "Keyboard: /etc/vconsole.conf"
    output "Timezone: /etc/localtime -> /usr/share/zoneinfo/${timezone}"
    output "===================================="
    output ""
}

# =====================================
# MAIN CONFIGURATION PROCESS
# =====================================

output "=== Locale and System Configuration ==="

# Validate all input parameters
validate_hostname "${hostname:?}" || exit 1
validate_locale "${locale:?}" || exit 1
validate_keyboard "${kblayout:?}" || exit 1
validate_timezone "${timezone:?}" || exit 1

output "All input parameters validated successfully"
output ""

# Create configuration files
create_hostname_config || exit 1
create_hosts_file || exit 1
create_locale_config || exit 1
create_keyboard_config || exit 1
configure_timezone || exit 1

# Verify all configurations
verify_all_configuration || exit 1

# Display summary
display_configuration_summary

output "=== Locale Configuration Complete ==="
output "✓ Hostname configured: ${hostname}"
output "✓ Locale configured: ${locale}.UTF-8"
output "✓ Keyboard layout: ${kblayout}"
output "✓ Timezone: ${timezone}"
output "✓ All configuration files verified"
output ""
output "System locale configuration ready for chroot phase"
