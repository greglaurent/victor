#!/usr/bin/env bash

# arch/08-arch-chroot
# Final system configuration within chroot environment

set -euo pipefail

# Source echo function and ensure required variables

# Ensure required variables are defined  
timezone=${timezone:-\"America/Los_Angeles\"}
locale=${locale:-\"en_US\"}
username=${username:-\"\"}
fullname=${fullname:-\"\"}
user_password=${user_password:-\"\"}
install_mode=${install_mode:-\"desktop\"}

# Validate required variables
if [[ -z \"$username\" ]]; then
    echo \"ERROR: Username variable not set. This script requires username to be defined.\"
    exit 1
fi

if [[ -z \"$user_password\" ]]; then
    echo \"ERROR: User password variable not set. This script requires user_password to be defined.\"
    exit 1
fi

# =====================================
# CHROOT ENVIRONMENT VALIDATION
# =====================================

validate_chroot_environment() {
    echo "Validating chroot environment..."
    
    # Verify we're in Arch Linux chroot
    if [[ ! -f /etc/arch-release ]]; then
        echo "ERROR: Not running in Arch Linux chroot environment"
        exit 1
    fi
    
    # Verify critical directories exist
    local required_dirs=("/proc" "/sys" "/dev" "/boot" "/etc")
    for dir in "${required_dirs[@]}"; do
        if [[ ! -d "$dir" ]]; then
            echo "ERROR: Required directory missing in chroot: $dir"
            exit 1
        fi
    done
    
    # Verify package manager is functional
    if ! pacman -V &>/dev/null; then
        echo "ERROR: Package manager not functional in chroot"
        exit 1
    fi
    
    echo "Chroot environment validated successfully"
    return 0
}

validate_required_variables() {
    echo "Validating required installation variables..."
    
    local required_vars=("timezone" "username" "fullname" "user_password" "locale" "install_mode")
    local missing_vars=()
    
    for var in "${required_vars[@]}"; do
        if [[ -z "${!var:-}" ]]; then
            missing_vars+=("$var")
        fi
    done
    
    if [[ ${#missing_vars[@]} -gt 0 ]]; then
        echo "ERROR: Missing required variables: ${missing_vars[*]}"
        exit 1
    fi
    
    echo "All required variables validated"
    return 0
}

# =====================================
# HARDWARE DETECTION
# =====================================

detect_cpu_vendor() {
    local cpu_vendor
    cpu_vendor=$(grep -m1 "vendor_id" /proc/cpuinfo | cut -d: -f2 | tr -d ' ' 2>/dev/null || echo "unknown")
    
    case "$cpu_vendor" in
        "AuthenticAMD") echo "amd" ;;
        "GenuineIntel") echo "intel" ;;
        *) echo "unknown" ;;
    esac
}

detect_gpu_hardware() {
    local gpu_vendors=()
    
    # Detect Intel Graphics
    if lspci | grep -qi "VGA.*Intel\|3D.*Intel\|Display.*Intel"; then
        gpu_vendors+=("intel")
    fi
    
    # Detect AMD Graphics
    if lspci | grep -qi "VGA.*AMD\|VGA.*ATI\|3D.*AMD\|3D.*ATI\|Display.*AMD\|Display.*ATI"; then
        gpu_vendors+=("amd")
    fi
    
    # Detect NVIDIA Graphics
    if lspci | grep -qi "VGA.*NVIDIA\|3D.*NVIDIA\|Display.*NVIDIA"; then
        gpu_vendors+=("nvidia")
    fi
    
    # If no discrete GPU found, default to mesa
    if [[ ${#gpu_vendors[@]} -eq 0 ]]; then
        gpu_vendors+=("mesa")
    fi
    
    printf '%s ' "${gpu_vendors[@]}"
}

display_hardware_summary() {
    local cpu_vendor gpu_vendors
    cpu_vendor=$(detect_cpu_vendor)
    mapfile -t gpu_vendors <<< "$(detect_gpu_hardware)"
    
    echo ""
    echo "=== Hardware Detection Summary ==="
    echo "CPU Vendor: $cpu_vendor"
    echo "GPU Vendors: ${gpu_vendors[*]}"
    echo "Microcode Package: ${MICROCODE_PACKAGE:-"none detected"}"
    echo "=================================="
    echo ""
}

# =====================================
# GRAPHICS DRIVER INSTALLATION
# =====================================

install_intel_graphics() {
    echo "  Installing Intel graphics drivers..."
    
    local intel_packages=(
        "intel-gmmlib"
        "intel-media-driver" 
        "libva-intel-driver"
        "vulkan-intel"
        "mesa"
    )
    
    if ! pacman -S --noconfirm "${intel_packages[@]}"; then
        echo "ERROR: Failed to install Intel graphics drivers"
        exit 1
    fi
    
    echo "    ✓ Intel graphics drivers installed"
    return 0
}

install_amd_graphics() {
    echo "  Installing AMD graphics drivers..."
    
    local amd_packages=(
        "xf86-video-amdgpu"
        "vulkan-radeon"
        "libva-mesa-driver"
        "mesa"
        "opencl-rusticl-mesa"
    )
    
    if ! pacman -S --noconfirm "${amd_packages[@]}"; then
        echo "ERROR: Failed to install AMD graphics drivers"
        exit 1
    fi
    
    echo "    ✓ AMD graphics drivers installed"
    return 0
}

install_nvidia_graphics() {
    echo "  Installing NVIDIA graphics drivers..."
    
    local nvidia_packages=(
        "nvidia"
        "nvidia-utils"
        "nvidia-settings"
        "opencl-nvidia"
    )
    
    if ! pacman -S --noconfirm "${nvidia_packages[@]}"; then
        echo "ERROR: Failed to install NVIDIA graphics drivers"
        exit 1
    fi
    
    # Add nvidia modules to mkinitcpio
    sed -i 's/MODULES=(btrfs)/MODULES=(btrfs nvidia nvidia_modeset nvidia_uvm nvidia_drm)/' /etc/mkinitcpio.conf
    
    echo "    ✓ NVIDIA graphics drivers installed"
    return 0
}

install_mesa_fallback() {
    echo "  Installing Mesa fallback drivers..."
    
    local mesa_packages=(
        "mesa"
        "xf86-video-vesa"
    )
    
    if ! pacman -S --noconfirm "${mesa_packages[@]}"; then
        echo "ERROR: Failed to install Mesa fallback drivers"
        exit 1
    fi
    
    echo "    ✓ Mesa fallback drivers installed"
    return 0
}

configure_graphics_drivers() {
    echo "Step 1/8: Configuring graphics drivers..."
    
    local detected_gpus
    mapfile -t detected_gpus <<< "$(detect_gpu_hardware)"
    
    echo "  Detected GPU vendors: ${detected_gpus[*]}"
    
    # Install drivers for each detected GPU vendor
    for gpu in "${detected_gpus[@]}"; do
        case "$gpu" in
            "intel")
                install_intel_graphics || exit 1
                ;;
            "amd")
                install_amd_graphics || exit 1
                ;;
            "nvidia")
                install_nvidia_graphics || exit 1
                ;;
            "mesa")
                install_mesa_fallback || exit 1
                ;;
            *)
                echo "  WARNING: Unknown GPU vendor: $gpu"
                ;;
        esac
    done
    
    # Always install common input and basic graphics packages
    local common_packages=(
        "xf86-input-libinput"
        "libva-utils"
        "vulkan-tools"
    )
    
    if ! pacman -S --noconfirm "${common_packages[@]}"; then
        echo "ERROR: Failed to install common graphics packages"
        exit 1
    fi
    
    echo "  ✓ Graphics drivers configured for detected hardware"
    return 0
}

# =====================================
# SYSTEM CONFIGURATION
# =====================================

configure_timezone() {
    echo "Step 2/8: Configuring timezone..."
    
    local timezone_path="/usr/share/zoneinfo/$timezone"
    
    # Verify timezone exists
    if [[ ! -f "$timezone_path" ]]; then
        echo "ERROR: Invalid timezone: ${timezone}"
        exit 1
    fi
    
    # Set timezone
    if ! ln -sf "$timezone_path" /etc/localtime; then
        echo "ERROR: Failed to set timezone"
        exit 1
    fi
    
    # Set hardware clock
    if ! hwclock --systohc; then
        echo "ERROR: Failed to set hardware clock"
        exit 1
    fi
    
    # Verify timezone was set correctly
    local current_timezone
    current_timezone=$(readlink /etc/localtime | sed 's|/usr/share/zoneinfo/||')
    if [[ "$current_timezone" != "${timezone}" ]]; then
        echo "ERROR: Timezone not set correctly"
        echo "Expected: ${timezone}"
        echo "Current: $current_timezone"
        exit 1
    fi
    
    echo "  ✓ Timezone configured: ${timezone}"
    return 0
}

generate_locales() {
    echo "Step 3/8: Generating locales..."
    
    # Verify locale.gen exists and contains our locale
    if [[ ! -f /etc/locale.gen ]]; then
        echo "ERROR: /etc/locale.gen not found"
        exit 1
    fi
    
    if ! grep -q "$locale.UTF-8" /etc/locale.gen; then
        echo "ERROR: Locale ${locale}.UTF-8 not configured in locale.gen"
        exit 1
    fi
    
    # Generate locales
    if ! locale-gen; then
        echo "ERROR: Locale generation failed"
        exit 1
    fi
    
    # Verify locale was generated
    if ! locale -a | grep -q "${locale}.utf8"; then
        echo "ERROR: Locale ${locale} not available after generation"
        exit 1
    fi
    
    echo "  ✓ Locales generated successfully"
    return 0
}

regenerate_initramfs() {
    echo "Step 4/8: Regenerating initramfs..."
    
    # Set proper permissions for initramfs files
    chmod 600 /boot/initramfs-linux*
    
    # Regenerate initramfs with new configuration
    if ! mkinitcpio -P; then
        echo "ERROR: Failed to regenerate initramfs"
        echo "Check the mkinitcpio echo above for details"
        exit 1
    fi
    
    # Verify initramfs files were created
    local initramfs_files=("/boot/initramfs-linux.img" "/boot/initramfs-linux-lts.img")
    for file in "${initramfs_files[@]}"; do
        if [[ ! -s "$file" ]]; then
            echo "ERROR: Initramfs file missing or empty: $file"
            exit 1
        fi
    done
    
    echo "  ✓ Initramfs regenerated with updated configuration"
    return 0
}

install_limine_bootloader() {
    echo "Step 5/8: Installing Limine bootloader..."
    
    # Install Limine to ESP for UEFI
    if ! limine bios-install /dev/disk/by-partlabel/ESP; then
        echo "ERROR: Failed to install Limine to ESP"
        exit 1
    fi
    
    # Install Limine to disk for BIOS compatibility
    local disk_device
    disk_device=$(lsblk -no PKNAME /dev/disk/by-partlabel/ESP | head -n1)
    if [[ -n "$disk_device" ]]; then
        if ! limine bios-install "/dev/$disk_device"; then
            echo "ERROR: Failed to install Limine to disk"
            exit 1
        fi
    fi
    
    # Verify Limine configuration exists
    if [[ ! -f /boot/limine.cfg ]]; then
        echo "ERROR: Limine configuration not found"
        exit 1
    fi
    
    echo "  ✓ Limine bootloader installed (UEFI + BIOS compatible)"
    return 0
}

# =====================================
# USER ACCOUNT MANAGEMENT
# =====================================

create_user_account() {
    echo "Step 6/8: Creating user account..."
    
    # Validate username format
    if ! [[ "$username" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]; then
        echo "ERROR: Invalid username format: ${username}"
        echo "Username must start with letter/underscore, contain only lowercase letters, numbers, underscore, hyphen"
        exit 1
    fi
    
    # Check if user already exists
    if id "${username}" &>/dev/null; then
        echo "ERROR: User ${username} already exists"
        exit 1
    fi
    
    # Create user with appropriate groups
    local user_groups="wheel,adm,ftp,games,http,log,rfkill,sys,systemd-journal,uucp"
    
    if ! useradd -c "$fullname" -m -G "$user_groups" "$username"; then
        echo "ERROR: Failed to create user account"
        exit 1
    fi
    
    # Verify user was created
    if ! id "${username}" &>/dev/null; then
        echo "ERROR: User creation verification failed"
        exit 1
    fi
    
    # Verify home directory was created
    if [[ ! -d "/home/${username}" ]]; then
        echo "ERROR: User home directory not created"
        exit 1
    fi
    
    echo "  ✓ User account created: ${username}"
    echo "  ✓ Home directory: /home/${username}"
    echo "  ✓ Groups: $user_groups"
    return 0
}

set_user_password() {
    echo "Setting user password..."
    
    # Set user password
    if ! echo -e "$user_password\n$user_password" | passwd "$username"; then
        echo "ERROR: Failed to set user password"
        exit 1
    fi
    
    # Verify password was set (user should not be locked)
    if passwd -S "${username}" | grep -q " L "; then
        echo "ERROR: User account is locked after password set"
        exit 1
    fi
    
    echo "  ✓ User password configured"
    return 0
}

configure_sudo_access() {
    echo "Configuring sudo access..."
    
    # Enable wheel group sudo access
    if ! sed -i 's/# %wheel ALL=(ALL:ALL) ALL/%wheel ALL=(ALL:ALL) ALL/g' /etc/sudoers; then
        echo "ERROR: Failed to configure sudo access"
        exit 1
    fi
    
    # Verify sudo configuration
    if ! grep -q "^%wheel ALL=(ALL:ALL) ALL" /etc/sudoers; then
        echo "ERROR: Sudo configuration not applied correctly"
        exit 1
    fi
    
    # Test sudo configuration syntax
    if ! visudo -c; then
        echo "ERROR: Sudo configuration syntax error"
        exit 1
    fi
    
    echo "  ✓ Sudo access configured for wheel group"
    return 0
}

