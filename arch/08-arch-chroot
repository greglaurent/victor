        fi
    fi
}

# =====================================
# SNAPPER CONFIGURATION
# =====================================

configure_snapper() {
    echo "Step 8/8: Configuring Snapper snapshots..."
    
    # Remove default snapshots subvolume (we manage this manually)
    if mountpoint -q /.snapshots; then
        umount /.snapshots
    fi
    
    if [[ -d /.snapshots ]]; then
        rm -rf /.snapshots
    fi
    
    # Create snapper configuration
    if ! snapper --no-dbus -c root create-config /; then
        echo "ERROR: Failed to create snapper configuration"
        exit 1
    fi
    
    # Remove snapper's auto-created subvolume
    if [[ -d /.snapshots ]]; then
        btrfs subvolume delete /.snapshots
    fi
    
    # Create snapshots directory and mount existing subvolume
    mkdir -p /.snapshots
    
    # Remount all filesystems to ensure snapshots subvolume is available
    if ! mount -a; then
        echo "ERROR: Failed to remount filesystems"
        exit 1
    fi
    
    # Set proper permissions
    chmod 750 /.snapshots
    
    # Verify snapper configuration
    if ! snapper -c root list &>/dev/null; then
        echo "ERROR: Snapper configuration verification failed"
        exit 1
    fi
    
    echo "  ✓ Snapper configured for BTRFS snapshots"
    return 0
}

# =====================================
# SECURITY FRAMEWORK INTEGRATION
# =====================================

finalize_security_setup() {
    echo "Finalizing security framework integration..."
    
    # Set proper permissions on security-sensitive files
    chmod 600 /etc/ssh/ssh_host_*_key 2>/dev/null || true
    chmod 644 /etc/ssh/ssh_host_*_key.pub 2>/dev/null || true
    
    # Ensure AppArmor directories have proper permissions
    if [[ -d /etc/apparmor.d ]]; then
        find /etc/apparmor.d -type d -exec chmod 755 {} \;
        find /etc/apparmor.d -name "*.conf" -exec chmod 644 {} \;
    fi
    
    # Set secure permissions on audit configuration
    if [[ -d /etc/audit ]]; then
        chmod 750 /etc/audit
        chmod 640 /etc/audit/rules.d/* 2>/dev/null || true
    fi
    
    # Verify security configurations
    local security_configs=(
        "/etc/sysctl.d/99-developer-workstation.conf"
        "/etc/ssh/sshd_config.d/10-security.conf"
        "/etc/apparmor.d/local"
    )
    
    for config in "${security_configs[@]}"; do
        if [[ ! -e "$config" ]]; then
            echo "WARNING: Security configuration missing: $config"
        fi
    done
    
    echo "  ✓ Security framework permissions configured"
    return 0
}

# =====================================
# COMPREHENSIVE SYSTEM VALIDATION
# =====================================

validate_critical_files() {
    echo "Validating critical system files..."
    
    local critical_files=(
        "/etc/locale.gen"
        "/etc/locale.conf"
        "/etc/hostname"
        "/etc/hosts"
        "/etc/fstab"
        "/boot/limine.cfg"
        "/etc/mkinitcpio.conf"
        "/etc/passwd"
        "/etc/group"
        "/etc/sudoers"
    )
    
    local missing_files=()
    
    for file in "${critical_files[@]}"; do
        if [[ ! -f "$file" ]]; then
            missing_files+=("$file")
        elif [[ ! -s "$file" ]]; then
            echo "WARNING: Critical file is empty: $file"
        fi
    done
    
    if [[ ${#missing_files[@]} -gt 0 ]]; then
        echo "ERROR: Critical files missing: ${missing_files[*]}"
        exit 1
    fi
    
    echo "  ✓ All critical system files present"
    return 0
}

validate_user_configuration() {
    echo "Validating user configuration..."
    
    # Check user exists and has proper groups
    if ! id "$username" &>/dev/null; then
        echo "ERROR: User ${username} does not exist"
        exit 1
    fi
    
    # Check user is in wheel group
    if ! groups "${username}" | grep -q "wheel"; then
        echo "ERROR: User ${username} not in wheel group"
        exit 1
    fi
    
    # Check home directory exists
    if [[ ! -d "/home/${username}" ]]; then
        echo "ERROR: User home directory missing"
        exit 1
    fi
    
    # Check user can sudo
    if ! sudo -u "${username}" sudo -n true 2>/dev/null; then
        # This is expected to fail, but user should exist in sudoers
        if ! sudo -l -U "${username}" &>/dev/null; then
            echo "ERROR: User ${username} not configured for sudo"
            exit 1
        fi
    fi
    
    echo "  ✓ User configuration validated"
    return 0
}

validate_bootloader_configuration() {
    echo "Validating bootloader configuration..."
    
    # Check Limine configuration exists
    if [[ ! -f /boot/limine.cfg ]]; then
        echo "ERROR: Limine configuration missing"
        exit 1
    fi
    
    # Check Limine configuration has required entries
    local required_entries=("Arch Linux" "Arch Linux LTS")
    for entry in "${required_entries[@]}"; do
        if ! grep -q ":$entry" /boot/limine.cfg; then
            echo "ERROR: Limine configuration missing entry: $entry"
            exit 1
        fi
    done
    
    # Check kernel files exist
    local kernel_files=("/boot/vmlinuz-linux" "/boot/vmlinuz-linux-lts" "/boot/initramfs-linux.img" "/boot/initramfs-linux-lts.img")
    for file in "${kernel_files[@]}"; do
        if [[ ! -f "$file" ]]; then
            echo "ERROR: Kernel file missing: $file"
            exit 1
        fi
    done
    
    echo "  ✓ Bootloader configuration validated"
    return 0
}

validate_network_configuration() {
    echo "Validating network configuration..."
    
    # Check NetworkManager configuration
    if [[ ! -f /etc/NetworkManager/conf.d/security.conf ]]; then
        echo "ERROR: NetworkManager security configuration missing"
        exit 1
    fi
    
    # Check unbound configuration
    if [[ ! -f /etc/unbound/unbound.conf ]]; then
        echo "ERROR: Unbound configuration missing"
        exit 1
    fi
    
    # Check systemd-resolved configuration
    if [[ ! -f /etc/systemd/resolved.conf.d/unbound-integration.conf ]]; then
        echo "ERROR: systemd-resolved integration missing"
        exit 1
    fi
    
    echo "  ✓ Network configuration validated"
    return 0
}

final_system_validation() {
    echo ""
    echo "=== Final System Validation ==="
    
    validate_critical_files || exit 1
    validate_user_configuration || exit 1
    validate_bootloader_configuration || exit 1
    validate_network_configuration || exit 1
    
    echo "=== Validation Complete ==="
    echo ""
    return 0
}

