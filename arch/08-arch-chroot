configure_desktop_integration() {
    if [[ "$install_mode" == "desktop" ]]; then
        echo "Configuring desktop integration..."
        
        # Update dconf database
        if command -v dconf &>/dev/null; then
            dconf update
            echo "  ✓ dconf database updated"
        fi
        
        # Create user directories
