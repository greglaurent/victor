#!/usr/bin/env bash

# setup/dev/docker
# Docker configuration for development environment

set -euo pipefail

source "${HERE}/utils"

utils::is_root

output() {
    printf '\e[1;34m%-6s\e[m\n' "${@}"
}

main() {
    output "=== Docker Development Configuration ==="
    
    # Check if Docker is installed
    if ! utils::is_cmd docker; then
        output "Installing Docker..."
        pacman -S --needed --noconfirm docker docker-compose docker-buildx
    else
        output "✓ Docker already installed"
    fi
    
    # Create docker group if it doesn't exist
    if ! getent group docker >/dev/null; then
        output "Creating docker group..."
        groupadd docker
    fi
    
    # Add user to docker group (get username from SUDO_USER if running as root)
    local username="${SUDO_USER:-$(logname 2>/dev/null || echo "${USER}")}"
    if [[ -n "$username" && "$username" != "root" ]]; then
        if ! groups "$username" | grep -q docker; then
            output "Adding $username to docker group..."
            usermod -aG docker "$username"
            output "✓ User $username added to docker group (logout/login required)"
        else
            output "✓ User $username already in docker group"
        fi
    fi
    
    # Configure Docker daemon for development
    local docker_config_dir="/etc/docker"
    local daemon_config="$docker_config_dir/daemon.json"
    
    output "Configuring Docker daemon for development..."
    mkdir -p "$docker_config_dir"
    
    # Create development-optimized daemon configuration
    cat > "$daemon_config" << 'EOF'
{
    "log-driver": "json-file",
    "log-opts": {
        "max-size": "10m",
        "max-file": "3"
    },
    "storage-driver": "overlay2",
    "storage-opts": [
        "overlay2.override_kernel_check=true"
    ],
    "default-address-pools": [
        {
            "base": "172.17.0.0/16",
            "size": 24
        },
        {
            "base": "172.18.0.0/16", 
            "size": 24
        }
    ],
    "dns": ["1.1.1.1", "8.8.8.8"],
    "features": {
        "buildkit": true
    },
    "experimental": false,
    "live-restore": true,
    "userland-proxy": false,
    "icc": true,
    "ip-forward": true,
    "ip-masq": true,
    "iptables": true,
    "ipv6": false,
    "bridge": "docker0",
    "fixed-cidr": "172.17.0.0/16"
}
EOF
    
    output "✓ Docker daemon configuration created: $daemon_config"
    
    # Create Docker development systemd override
    local docker_override_dir="/etc/systemd/system/docker.service.d"
    local docker_override="$docker_override_dir/99-development.conf"
    
    output "Creating Docker systemd development override..."
    mkdir -p "$docker_override_dir"
    
    cat > "$docker_override" << 'EOF'
# Docker development override
# Relaxes security hardening that breaks container functionality

[Service]
# Allow memory execution (required for containers with JIT compilers)
MemoryDenyWriteExecute=no

# Allow filesystem access (required for bind mounts, volumes)
ProtectSystem=false
ProtectHome=no
PrivateTmp=no

# Allow kernel access (required for container networking, cgroups)
ProtectKernelTunables=no
ProtectKernelModules=no
ProtectControlGroups=no

# Allow full network access (required for container networking)
RestrictAddressFamilies=

# Allow broader syscalls (required for container runtime)
SystemCallFilter=

# Allow namespaces (essential for containers)
RestrictNamespaces=no

# Allow privilege operations (required for container management)
NoNewPrivileges=no
LockPersonality=no

# Grant container management capabilities
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_NET_ADMIN CAP_SYS_PTRACE CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE

# Increase resource limits for development
LimitNOFILE=1048576
LimitNPROC=1048576
LimitCORE=infinity
TasksMax=infinity
EOF
    
    output "✓ Docker systemd override created: $docker_override"
    
    # Create development Docker Compose template
    local compose_template_dir="/usr/local/share/docker-templates"
    local compose_template="$compose_template_dir/development.yml"
    
    output "Creating Docker Compose development template..."
    mkdir -p "$compose_template_dir"
    
    cat > "$compose_template" << 'EOF'
# Development Docker Compose Template
# Copy this file to your project as docker-compose.yml and customize

version: '3.8'

services:
  # Main application service
  app:
    build: 
      context: .
      dockerfile: Dockerfile.dev
    volumes:
      # Source code hot-reload
      - .:/app
      # Preserve node_modules/target between builds
      - node_modules:/app/node_modules
      - cargo_cache:/usr/local/cargo/registry
    ports:
      - "3000:3000"   # Main app port
      - "8080:8080"   # Alternative port
    environment:
      - NODE_ENV=development
      - RUST_LOG=debug
      - DATABASE_URL=postgres://dev:dev@postgres:5432/devdb
      - REDIS_URL=redis://redis:6379
    depends_on:
      - postgres
      - redis
    networks:
      - dev-network
    
  # PostgreSQL database
  postgres:
    image: postgres:15-alpine
    environment:
      POSTGRES_DB: devdb
      POSTGRES_USER: dev
      POSTGRES_PASSWORD: dev
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./db/init:/docker-entrypoint-initdb.d
    ports:
      - "5432:5432"
    networks:
      - dev-network
      
  # Redis cache
  redis:
    image: redis:7-alpine
    command: redis-server --appendonly yes
    volumes:
      - redis_data:/data
    ports:
      - "6379:6379"
    networks:
      - dev-network

volumes:
  postgres_data:
  redis_data:
  node_modules:
  cargo_cache:

networks:
  dev-network:
    driver: bridge
EOF
    
    output "✓ Docker Compose template created: $compose_template"
    
    # Create Docker utility scripts
    local docker_scripts_dir="/usr/local/bin"
    
    # Development container cleanup script
    cat > "$docker_scripts_dir/docker-dev-clean" << 'EOF'
#!/usr/bin/env bash

# docker-dev-clean - Clean up development Docker resources

set -euo pipefail

output() {
    printf '\e[1;34m%-6s\e[m\n' "${@}"
}

show_usage() {
    output "Usage: docker-dev-clean [OPTIONS]"
    output ""
    output "Options:"
    output "  --containers    Remove stopped containers"
    output "  --images        Remove dangling images"
    output "  --volumes       Remove unused volumes"
    output "  --networks      Remove unused networks"
    output "  --all           Remove all unused resources"
    output "  --force         Don't prompt for confirmation"
    output ""
    output "Examples:"
    output "  docker-dev-clean --containers"
    output "  docker-dev-clean --all --force"
}

clean_containers() {
    local stopped=$(docker ps -aq --filter "status=exited")
    if [[ -n "$stopped" ]]; then
        output "Removing stopped containers..."
        docker rm $stopped
        output "✓ Stopped containers removed"
    else
        output "No stopped containers to remove"
    fi
}

clean_images() {
    local dangling=$(docker images -q --filter "dangling=true")
    if [[ -n "$dangling" ]]; then
        output "Removing dangling images..."
        docker rmi $dangling
        output "✓ Dangling images removed"
    else
        output "No dangling images to remove"
    fi
}

clean_volumes() {
    output "Removing unused volumes..."
    docker volume prune -f
    output "✓ Unused volumes removed"
}

clean_networks() {
    output "Removing unused networks..."
    docker network prune -f
    output "✓ Unused networks removed"
}

confirm_action() {
    if [[ "${FORCE:-0}" -eq 1 ]]; then
        return 0
    fi
    
    read -r -p "Are you sure? [y/N] " response
    case "$response" in
        [yY][eS]|[yY]) return 0 ;;
        *) return 1 ;;
    esac
}

FORCE=0
CONTAINERS=0
IMAGES=0
VOLUMES=0
NETWORKS=0
ALL=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        --containers) CONTAINERS=1 ;;
        --images) IMAGES=1 ;;
        --volumes) VOLUMES=1 ;;
        --networks) NETWORKS=1 ;;
        --all) ALL=1 ;;
        --force) FORCE=1 ;;
        --help|-h) show_usage; exit 0 ;;
        *) output "Unknown option: $1"; show_usage; exit 1 ;;
    esac
    shift
done

if [[ $ALL -eq 1 ]]; then
    CONTAINERS=1
    IMAGES=1
    VOLUMES=1
    NETWORKS=1
fi

if [[ $CONTAINERS -eq 0 && $IMAGES -eq 0 && $VOLUMES -eq 0 && $NETWORKS -eq 0 ]]; then
    show_usage
    exit 1
fi

output "=== Docker Development Cleanup ==="

if confirm_action; then
    [[ $CONTAINERS -eq 1 ]] && clean_containers
    [[ $IMAGES -eq 1 ]] && clean_images
    [[ $VOLUMES -eq 1 ]] && clean_volumes
    [[ $NETWORKS -eq 1 ]] && clean_networks
    output "✓ Cleanup complete"
else
    output "Cleanup cancelled"
fi
EOF

    chmod +x "$docker_scripts_dir/docker-dev-clean"
    output "✓ Docker cleanup utility created: $docker_scripts_dir/docker-dev-clean"
    
    # Enable and start Docker service
    output "Enabling Docker service..."
    systemctl daemon-reload
    systemctl enable docker
    
    if systemctl is-active docker >/dev/null; then
        output "Restarting Docker service with new configuration..."
        systemctl restart docker
    else
        output "Starting Docker service..."
        systemctl start docker
    fi
    
    # Wait for Docker to be ready
    output "Waiting for Docker to be ready..."
    local attempts=0
    while ! docker info >/dev/null 2>&1 && [[ $attempts -lt 30 ]]; do
        sleep 1
        ((attempts++))
    done
    
    if docker info >/dev/null 2>&1; then
        output "✓ Docker is running and ready"
    else
        output "⚠ Docker may not be ready yet, check with: systemctl status docker"
    fi
    
    output ""
    output "✓ Docker development environment configured!"
    output ""
    output "Usage:"
    output "  vic run system docker-status       # Check Docker service status"
    output "  docker-dev-clean --all --force     # Clean up development resources"
    output "  docker run hello-world             # Test Docker installation"
    output ""
    output "Files created:"
    output "  Docker config: $daemon_config"
    output "  Systemd override: $docker_override"
    output "  Compose template: $compose_template"
    output "  Cleanup utility: $docker_scripts_dir/docker-dev-clean"
    output ""
    output "Note: User $username must logout/login to use Docker without sudo"
}

main "$@"
